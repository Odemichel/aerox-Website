---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import PostTags from '~/components/blog/Tags.astro';
import PostConversion from '~/components/blog/PostConversion.astro';
import PostSidebarBook from '~/components/blog/PostSidebarBook.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import type { Post } from '~/types';
import { blogImages } from '../../data/blogImages';

import { Image } from 'astro:assets';
import { getDict, SUPPORTED_LOCALES, t, type Locale } from '~/lib/i18n';
import AuthorPhoto from '~/assets/images/Olivier_tete2.png';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
const ensureTrailingSlash = (p: string) => (!p ? p : p.endsWith('/') || p.includes('.') ? p : p + '/');
const withLang = (lang: Locale, href: string) => {
  if (!href) return href;

  // 🔗 Cas des ancres: on veut /{lang}/#id (ancre sur la home)
  if (href.startsWith('#')) {
    return `/${lang}/` + href; // ex: "/fr/#pricing"
  }

  // Autres liens
  const path = href.startsWith('/') ? href : `/${href}`;
  const prefixed = `/${lang}${path}`.replace(/\/{2,}/g, '/');
  return ensureTrailingSlash(prefixed);
};
const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const image = post.imageKey ? blogImages[post.imageKey] : undefined;

// Une seule colonne pour l'en-tête, le corps et la fin d'article : le titre et
// le chapô s'alignent sur le texte, y compris sur mobile.
const col = 'mx-auto w-full max-w-[42rem] px-5 sm:px-6';
// Corps et fin d'article : même colonne en dessous de 1 200 px ; au-delà, la
// grille fixe la largeur (42rem) et la marge intérieure reste la même.
const colInner = 'mx-auto w-full max-w-[42rem] px-5 sm:px-6 min-[1200px]:px-0';
const headings = post.headings ?? [];
const dateFormat = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
const formatDate = (d: Date) => dateFormat.format(d);
// « Mis à jour le » seulement si la mise à jour est postérieure à la publication.
const updated = post.updateDate && post.updateDate.getTime() > post.publishDate.getTime() ? post.updateDate : undefined;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    {/* Pas d'animation d'apparition : le titre et l'image s'affichent tout de suite. */}
    <header>
      <!-- ✅ Meta infos -->
      <p class={`${col} mb-3 text-sm text-muted dark:text-slate-400`}>
        <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5" />
        <time datetime={post.publishDate.toISOString()} class="inline-block">{formatDate(post.publishDate)}</time>
        {
          post.author && (
            <>
              {' '}
              · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5" />
              <span class="inline-block">{post.author}</span>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              {' '}
              · <span>{post.readingTime}</span> {t(dict, 'blog.minRead')}
            </>
          )
        }
        {
          updated && (
            <>
              <br />
              {t(dict, 'blog.updated')} <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }
      </p>

      <!-- ✅ Titre + chapô, alignés sur le corps de texte -->
      <h1 class={`${col} text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading`}>
        {post.title}
      </h1>
      {
        post.excerpt && (
          <p class={`${col} mt-4 mb-8 text-xl md:text-2xl text-muted dark:text-slate-400`}>{post.excerpt}</p>
        )
      }

      <!-- ✅ Image via dictionnaire -->
      {
        image ? (
          <Image
            src={image}
            alt={post.title}
            width={400}
            class="max-w-[300px] lg:max-w-[400px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class={col}>
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>

    <!-- ✅ ≥ 1 200 px : sommaire collant à gauche, livre compact collant à droite.
         En dessous : une seule colonne, livre en fin d'article uniquement. -->
    <div
      class="mt-8 min-[1200px]:grid min-[1200px]:grid-cols-[15rem_minmax(0,42rem)_15rem] min-[1200px]:justify-center min-[1200px]:gap-8"
    >
      {/* Ligne fine de séparation entre le sommaire et le texte. */}
      <aside class="hidden min-[1200px]:block border-r border-gray-200 dark:border-slate-700 pr-6">
        {
          headings.length > 0 && (
            <nav
              class="sticky top-[140px] text-sm"
              aria-label={t(dict, 'blog.toc')}
              data-toc
              data-toc-active="bg-yellow-100 text-yellow-900 !border-yellow-400 dark:bg-yellow-400/15 dark:text-yellow-200"
            >
              <p class="font-semibold uppercase tracking-wide text-xs text-muted mb-3">{t(dict, 'blog.toc')}</p>
              <ol class="space-y-2 border-l border-gray-200 dark:border-slate-700">
                {headings.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class="block -ml-px pl-3 py-1 rounded-r border-l-2 border-transparent hover:border-primary hover:text-primary text-muted transition-colors"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>

      <div class="min-w-0">
        <div
          class={`${colInner} post-body prose prose-lg dark:prose-invert max-w-none mt-8 prose-headings:font-heading prose-headings:font-bold prose-headings:text-primary prose-headings:leading-tighter prose-headings:scroll-mt-[120px] prose-a:text-primary dark:prose-a:text-primary prose-img:rounded-md prose-img:shadow-lg`}
          style={`--def-label: '${t(dict, 'blog.definition').replace(/'/g, "\\'")}'`}
        >
          <slot />
        </div>

        <!-- Fin d'article : un seul bloc de conversion, puis tags, partage et auteur. -->
        <div class={`${colInner} mt-12`}>
          <PostConversion lang={lang} />
        </div>
      </div>

      <aside class="hidden min-[1200px]:block">
        <div class="sticky top-[140px]">
          <PostSidebarBook lang={lang} />
        </div>
      </aside>
    </div>

    <!-- ✅ Tags + Social -->
    <div class={`${col} mt-8 flex justify-between flex-col sm:flex-row`}>
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare
        url={url}
        text={post.title}
        image={image?.src}
        label={t(dict, 'blog.share')}
        class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600"
      />
    </div>

    <!-- ✅ Author block -->
    <div class={`${col} mt-10 border-t dark:border-slate-700 pt-8`}>
      <div class="flex items-start gap-4">
        <a href={withLang(lang, '/team/')} class="shrink-0">
          <Image
            src={AuthorPhoto}
            alt={t(dict, 'ourStory.team.olivier.alt')}
            width={64}
            height={64}
            class="rounded-full w-16 h-16 object-cover"
            loading="lazy"
          />
        </a>
        <div>
          <a href={withLang(lang, '/team/')} class="font-bold text-lg hover:underline">
            {post.author || 'Olivier Demichel'}
          </a>
          <p class="text-sm text-muted dark:text-slate-400">{t(dict, 'ourStory.team.olivier.role')}</p>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">{t(dict, 'ourStory.team.olivier.desc')}</p>
        </div>
      </div>
    </div>
  </article>
</section>

<script>
  import { initTocSpy } from '~/lib/tocSpy';

  initTocSpy();
  document.addEventListener('astro:page-load', initTocSpy);
</script>
