---
// Bloc livre compact de la colonne droite (articles, calculateur ; ≥ 1 200 px) :
// couverture ~160 px, une ligne de promesse, champ email, bouton. Il apparaît
// après `revealAt` (part du défilement de la page, 0,25 par défaut ; 0 =
// visible tout de suite).
import { Image } from 'astro:assets';
import livreCover from '~/assets/images/livre/image_livre_entrainer-aero.png';
import { type Locale, getDict, t } from '~/lib/i18n';

const { lang, revealAt = 0.25 } = Astro.props as { lang: Locale; revealAt?: number };
const dict = getDict(lang);
---

<div
  data-sidebar-book
  data-reveal-at={revealAt}
  class="opacity-0 translate-y-2 pointer-events-none transition duration-500 rounded-2xl border border-[hsl(35_95%_58%/0.35)] bg-[hsl(35_95%_58%/0.06)] shadow-sm p-5 text-center"
>
  <Image
    src={livreCover}
    alt={t(dict, 'book.hero.alt')}
    widths={[160, 320]}
    sizes="160px"
    class="w-[160px] h-auto mx-auto"
    loading="lazy"
  />
  <p class="mt-3 text-base font-bold leading-snug">{t(dict, 'home.guide.title')}</p>
  <form
    data-guide-capture
    data-source="sidebar"
    class="mt-3 flex flex-col gap-2"
    data-success={t(dict, 'book.form.success')}
    data-error={t(dict, 'book.form.error')}
  >
    <input
      type="email"
      name="email"
      aria-label={t(dict, 'book.form.email.placeholder')}
      placeholder={t(dict, 'book.form.email.placeholder')}
      required
      class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm text-gray-900 dark:text-white bg-white dark:bg-slate-800 placeholder:text-gray-500 dark:placeholder:text-slate-400"
    />
    {/* Honeypot : invisible pour l'humain, rempli par les bots. Jamais de label. */}
    <input
      type="text"
      name="hp"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute left-[-9999px] w-px h-px opacity-0"
    />
    <button type="submit" class="btn-primary px-4 py-2 text-sm font-semibold rounded-lg">
      {t(dict, 'book.form.submit')}
    </button>
  </form>
  <p data-guide-msg class="text-sm mt-2 hidden"></p>
</div>

<script>
  import { initGuideCaptureForms } from '~/lib/guideCaptureForm';

  // Apparition après ~25 % de défilement de la page.
  function initSidebarBook() {
    const box = document.querySelector<HTMLElement>('[data-sidebar-book]');
    if (!box || box.dataset.bound === '1') return;
    box.dataset.bound = '1';
    const revealAt = Number(box.dataset.revealAt ?? 0.25);
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (revealAt <= 0 || (max > 0 && window.scrollY / max >= revealAt)) {
        box.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        window.removeEventListener('scroll', update);
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initGuideCaptureForms();
  initSidebarBook();
  document.addEventListener('astro:page-load', () => {
    initGuideCaptureForms();
    initSidebarBook();
  });
</script>
