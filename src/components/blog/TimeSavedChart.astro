---
// Temps gagné par kilomètre selon la vitesse en position relevée, à puissance
// égale : courbe 2D en SVG, libellés traduits, couleurs du site. Remplace
// l'ancienne image 3D (time_saved_per_km.png).
// Données : S'entraîner à l'aérodynamisme (O. Demichel, 2026), tableau 2.3,
// position 3 (buste horizontal, bas du cintre) et position 5 (prolongateurs).
import { type Locale, getDict, t } from '~/lib/i18n';

const { lang } = Astro.props as { lang: Locale };
const dict = getDict(lang);

const speeds = [20, 25, 30, 32.5, 35, 37.5, 40, 45, 50, 60];
const road = [9.3, 7.6, 6.4, 5.8, 5.5, 5.0, 4.6, 4.2, 3.8, 3.2];
const tt = [20.7, 16.3, 13.8, 12.6, 11.7, 10.8, 10.3, 9.1, 8.2, 6.9];

// Repère : x de 20 à 60 km/h, y de 0 à 22 s/km.
const W = 640;
const H = 380;
const m = { top: 20, right: 24, bottom: 56, left: 56 };
const x = (v: number) => m.left + ((v - 20) / 40) * (W - m.left - m.right);
const y = (v: number) => H - m.bottom - (v / 22) * (H - m.top - m.bottom);
const path = (values: number[]) => values.map((v, i) => `${i ? 'L' : 'M'}${x(speeds[i])},${y(v)}`).join(' ');
const xTicks = [20, 30, 40, 50, 60];
const yTicks = [0, 5, 10, 15, 20];
const num = new Intl.NumberFormat(lang);
---

<figure class="not-prose my-10">
  <figcaption class="text-lg font-bold mb-3">{t(dict, 'chart.timeSaved.title')}</figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={t(dict, 'chart.timeSaved.title')}
    class="w-full h-auto text-default"
  >
    {
      yTicks.map((v) => (
        <g>
          <line x1={m.left} x2={W - m.right} y1={y(v)} y2={y(v)} stroke="currentColor" stroke-opacity="0.12" />
          <text x={m.left - 10} y={y(v) + 4} text-anchor="end" font-size="13" fill="currentColor" fill-opacity="0.7">
            {num.format(v)}
          </text>
        </g>
      ))
    }
    {
      xTicks.map((v) => (
        <text x={x(v)} y={H - m.bottom + 22} text-anchor="middle" font-size="13" fill="currentColor" fill-opacity="0.7">
          {num.format(v)}
        </text>
      ))
    }
    <text x={(m.left + W - m.right) / 2} y={H - 10} text-anchor="middle" font-size="14" fill="currentColor">
      {t(dict, 'chart.timeSaved.x')}
    </text>
    <text
      transform={`translate(16 ${(m.top + H - m.bottom) / 2}) rotate(-90)`}
      text-anchor="middle"
      font-size="14"
      fill="currentColor"
    >
      {t(dict, 'chart.timeSaved.y')}
    </text>

    <path d={path(tt)} fill="none" stroke="var(--aw-color-primary)" stroke-width="3.5" stroke-linejoin="round"></path>
    <path
      d={path(road)}
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-dasharray="7 5"
      stroke-linejoin="round"></path>
    {tt.map((v, i) => <circle cx={x(speeds[i])} cy={y(v)} r="3.5" fill="var(--aw-color-primary)" />)}
    {road.map((v, i) => <circle cx={x(speeds[i])} cy={y(v)} r="3" fill="currentColor" />)}
  </svg>
  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <span class="inline-flex items-center gap-2">
      <span class="inline-block w-6 h-1 rounded bg-primary"></span>
      {t(dict, 'chart.timeSaved.tt')}
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block w-6 border-t-2 border-dashed border-current"></span>
      {t(dict, 'chart.timeSaved.road')}
    </span>
  </div>
  <p class="mt-2 text-xs text-muted">{t(dict, 'chart.timeSaved.source')}</p>
</figure>
