---
// Bloc unique de fin d'article : le Diagnostic en offre principale, le livre
// offert en offre secondaire (couverture ≥ 200 px, formulaire email).
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import livreCover from '~/assets/images/livre/image_livre_entrainer-aero.png';
import Button from '~/components/ui/Button.astro';
import { type Locale, getDict, t } from '~/lib/i18n';
import { phased } from '~/lib/offerPhase';

const { lang } = Astro.props as { lang: Locale };
const dict = getDict(lang);
---

<aside class="not-prose rounded-2xl border border-gray-200 dark:border-slate-700 overflow-hidden">
  <div class="px-6 py-8 text-center bg-primary/5 dark:bg-primary/10">
    <p class="text-xl md:text-2xl font-bold mb-2">{t(dict, 'home.offer.title')}</p>
    <p
      class="text-primary font-semibold mb-6"
      set:html={phased(t(dict, 'home.offer.price'), t(dict, 'home.offer.price'), t(dict, 'offer.fullPrice'))}
    />
    <Button variant="primary" class="px-6 items-center" href={`/${lang}/#pricing`}>
      {t(dict, 'cda.diag.cta')}
      <Icon name="tabler:chevron-right" class="w-5 h-5 ml-1.5" />
    </Button>
    <p class="mt-3 text-sm text-muted">{t(dict, 'pricing.diagnostic.guarantee')}</p>
  </div>

  {/* Livre : ici en dessous de 1 200 px ; au-delà, il est dans la colonne droite. */}
  <div
    class="px-6 py-8 flex flex-col sm:flex-row items-center gap-6 border-t border-gray-200 dark:border-slate-700 min-[1200px]:hidden"
  >
    <Image
      src={livreCover}
      alt={t(dict, 'book.hero.alt')}
      widths={[200, 400]}
      sizes="200px"
      class="w-[200px] h-auto shrink-0"
      loading="lazy"
    />
    <div class="w-full text-center sm:text-left">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-1">{t(dict, 'home.guide.eyebrow')}</p>
      <p class="text-lg font-bold mb-2">{t(dict, 'home.guide.title')}</p>
      <form
        data-guide-capture
        data-source="article_end"
        class="flex flex-col gap-3"
        data-success={t(dict, 'book.form.success')}
        data-error={t(dict, 'book.form.error')}
      >
        <input
          type="email"
          name="email"
          aria-label={t(dict, 'book.form.email.placeholder')}
          placeholder={t(dict, 'book.form.email.placeholder')}
          required
          class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-4 py-2.5 text-sm text-gray-900 dark:text-white bg-white dark:bg-slate-800 placeholder:text-gray-500 dark:placeholder:text-slate-400"
        />
        {/* Honeypot : invisible pour l'humain, rempli par les bots. Jamais de label. */}
        <input
          type="text"
          name="hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute left-[-9999px] w-px h-px opacity-0"
        />
        <button type="submit" class="btn-secondary px-6 py-2.5 text-sm font-semibold rounded-lg">
          {t(dict, 'book.form.submit')}
        </button>
      </form>
      <p data-guide-msg class="text-sm mt-3 hidden"></p>
      <p class="text-xs text-muted mt-3">{t(dict, 'book.form.privacy')}</p>
    </div>
  </div>
</aside>

<script>
  import { initGuideCaptureForms } from '~/lib/guideCaptureForm';

  initGuideCaptureForms();
  document.addEventListener('astro:page-load', initGuideCaptureForms);
</script>
