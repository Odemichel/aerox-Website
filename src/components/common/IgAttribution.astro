---
// Attribution Instagram (voir /api/ig-event/ et src/lib/igDmEvents.ts).
// Un lien de DM d'AeroX Studio arrive avec ?utm_source=instagram&utm_medium=dm
// &utm_campaign=<ressource>&utm_content=<reel> ; le lien de la bio avec
// ?utm_source=instagram&utm_medium=bio (utm_campaign et utm_content facultatifs,
// « bio » par défaut). On garde l'origine 30 jours dans
// ce navigateur (localStorage, rien de personnel), on compte l'arrivée, puis
// window.aeroxIgConvert('calc' | 'book' | 'signup') compte une conversion, une
// seule fois par type. Si le stockage est bloqué, rien ne se passe.
---

<script is:inline>
  (() => {
    const KEY = 'aerox_ig_dm';
    const DAYS = 30;
    const CAMPAIGNS = ['calculator', 'guide', 'signup', 'bio'];
    const MEDIUMS = ['dm', 'bio'];
    const send = (kind, a) => {
      try {
        fetch('/api/ig-event/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind, medium: a.medium || 'dm', campaign: a.campaign, content: a.content }),
          keepalive: true,
        }).catch(() => undefined);
      } catch {
        // stockage ou réseau indisponible : on ne compte rien
      }
    };
    const read = () => {
      try {
        const a = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (a && Date.now() - a.t < DAYS * 864e5) return a;
      } catch {
        // localStorage bloqué
      }
      return null;
    };
    const save = (a) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(a));
      } catch {
        // localStorage bloqué
      }
    };
    try {
      const q = new URLSearchParams(location.search);
      const medium = q.get('utm_medium') || '';
      const dflt = medium === 'bio' ? 'bio' : '';
      const content = (q.get('utm_content') || dflt).toLowerCase();
      const campaign = q.get('utm_campaign') || dflt;
      if (
        q.get('utm_source') === 'instagram' &&
        MEDIUMS.includes(medium) &&
        /^[a-z0-9][a-z0-9-]{0,62}$/.test(content) &&
        CAMPAIGNS.includes(campaign)
      ) {
        const prev = read();
        if (!prev || prev.content !== content || (prev.medium || 'dm') !== medium) {
          const a = { medium, content, campaign, t: Date.now(), done: [] };
          save(a);
          send('visit', a);
        }
      }
    } catch {
      // URL illisible
    }
    window.aeroxIgConvert = (kind) => {
      const a = read();
      if (!a || (a.done || []).includes(kind)) return;
      a.done = [...(a.done || []), kind];
      save(a);
      send(kind, a);
    };
  })();
</script>
