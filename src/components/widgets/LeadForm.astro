---
import { type Locale, getDict, t } from '~/lib/i18n';
import { LINKS } from '~/config/links';

interface Props {
  topic: 'test-period' | 'bike-fitter';
  class?: string;
}

const { topic, class: className = '' } = Astro.props;

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);

const isTestPeriod = topic === 'test-period';

// Agenda de réservation (plage de rendez-vous Google), encadré dans la page
// et révélé au succès du formulaire — uniquement pour le topic `test-period`,
// et seulement si les deux URL sont configurées (voir src/config/links.ts).
// Sinon le bloc n'est pas rendu du tout : pas d'agenda mort en prod.
const bookingUrl = LINKS.booking;
// `hl` traduit l'agenda Google dans la langue de la page (vérifié : sans lui il
// rend en anglais même sur /fr/). L'URL de base porte déjà `?gv=true`, d'où le
// `&`. `lang` vient de la route, donc d'une locale connue, mais l'encodage
// reste posé : il coûte rien et ferme la question.
const bookingEmbedUrl = LINKS.bookingEmbed ? `${LINKS.bookingEmbed}&hl=${encodeURIComponent(lang)}` : '';
const showBooking = isTestPeriod && bookingUrl.length > 0 && bookingEmbedUrl.length > 0;

/**
 * Libellés dépendants du topic : `bike-fitter` a son propre jeu de clés
 * (`bf.form.*`, traduit dans les 9 langues, ton B2B professionnel) resté
 * distinct des clés `lead.form.*` (traduites en fr/en seulement, ton B2C
 * pensé pour le topic `test-period`). `lead.form.sending` est la seule clé
 * partagée par les deux — elle n'a pas d'équivalent `bf.*` et vaut le même
 * texte pour les deux topics.
 */
const LABELS: Record<Props['topic'], Record<'name' | 'email' | 'message' | 'submit' | 'success' | 'error', string>> = {
  'bike-fitter': {
    name: 'bf.form.name.placeholder',
    email: 'bf.form.email.placeholder',
    message: 'bf.form.message.placeholder',
    submit: 'bf.form.submit',
    success: 'bf.form.success',
    error: 'bf.form.error',
  },
  'test-period': {
    name: 'lead.form.name.placeholder',
    email: 'lead.form.email.placeholder',
    message: 'lead.form.message.placeholder',
    submit: 'lead.form.submit',
    success: 'lead.form.success',
    error: 'lead.form.error',
  },
};
const labels = LABELS[topic];

const inputClass = 'w-full border rounded p-3 text-secondary';
---

<form
  id={`lead-form-${topic}`}
  class={`lead-form flex flex-col gap-4 max-w-md mx-auto text-left ${className}`}
  data-topic={topic}
  data-success={t(dict, labels.success)}
  data-error={t(dict, labels.error)}
  data-sending={t(dict, 'lead.form.sending')}
>
  {
    isTestPeriod && (
      <fieldset class="border-0 p-0 m-0">
        <legend class="mb-2 font-semibold">{t(dict, 'lead.form.profile.label')}</legend>
        <div class="grid grid-cols-2 gap-3">
          <label
            class="profile-card flex flex-col items-center gap-1 p-4 border-2 rounded-lg cursor-pointer transition-all border-primary bg-primary/10"
            data-profile="rider"
          >
            <input type="radio" name="profile_type" value="rider" checked class="sr-only" />
            <span class="text-sm font-semibold">{t(dict, 'lead.form.profile.rider')}</span>
            <span class="text-xs text-gray-600 dark:text-gray-400 text-center">
              {t(dict, 'lead.form.profile.rider.desc')}
            </span>
          </label>
          <label
            class="profile-card flex flex-col items-center gap-1 p-4 border-2 rounded-lg cursor-pointer transition-all border-gray-300 dark:border-gray-600"
            data-profile="bike-fitter"
          >
            <input type="radio" name="profile_type" value="bike-fitter" class="sr-only" />
            <span class="text-sm font-semibold">{t(dict, 'lead.form.profile.bikefitter')}</span>
            <span class="text-xs text-gray-600 dark:text-gray-400 text-center">
              {t(dict, 'lead.form.profile.bikefitter.desc')}
            </span>
          </label>
        </div>
      </fieldset>
    )
  }

  <input type="text" name="name" required placeholder={t(dict, labels.name)} class={inputClass} />
  <input type="email" name="email" required placeholder={t(dict, labels.email)} class={inputClass} />

  {
    isTestPeriod && (
      <>
        <label class="flex flex-col gap-1">
          <span class="font-semibold">{t(dict, 'lead.form.trainer.label')}</span>
          <input type="text" name="trainer" placeholder={t(dict, 'lead.form.trainer.placeholder')} class={inputClass} />
        </label>

        <fieldset class="border-0 p-0 m-0">
          <legend class="mb-2 font-semibold">{t(dict, 'lead.form.webcam.label')}</legend>
          <div class="flex gap-4">
            <label class="inline-flex items-center gap-2 text-sm">
              <input type="radio" name="webcam" value="oui" /> {t(dict, 'lead.form.webcam.yes')}
            </label>
            <label class="inline-flex items-center gap-2 text-sm">
              <input type="radio" name="webcam" value="non" /> {t(dict, 'lead.form.webcam.no')}
            </label>
          </div>
        </fieldset>
      </>
    )
  }

  <textarea name="message" rows="3" placeholder={t(dict, labels.message)} class={inputClass}></textarea>

  {/* Honeypot : invisible pour l'humain, rempli par les bots. Jamais de label. */}
  <input
    type="text"
    name="hp"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute left-[-9999px] w-px h-px opacity-0"
  />

  <button type="submit" class="btn-primary px-8 py-3 text-lg w-full font-semibold">
    {t(dict, labels.submit)}
  </button>
  <p class="lead-form-msg text-sm mt-2 hidden"></p>
</form>

{
  showBooking && (
    <div id={`lead-booking-${topic}`} class="lead-form-booking hidden w-full mt-8 scroll-mt-[88px]">
      {/*
        Mention du fuseau : l'agenda affiche les créneaux à l'heure de Paris
        quel que soit le fuseau du visiteur — vérifié depuis Europe/Paris,
        Asia/Tokyo et America/New_York, la page lit bien le fuseau simulé et
        affiche Paris dans les trois cas, et les paramètres `ctz`/`tz` sont
        ignorés. Google l'étiquette « Central European Time - Paris », mais
        en anglais uniquement : sur les 8 autres langues du site, la mention
        ci-dessous est la seule indication lisible.
      */}
      <p class="text-sm mb-3 text-center text-muted dark:text-slate-400">{t(dict, 'lead.form.booking.timezone')}</p>
      {/*
        `src` reste vide au rendu et n'est posé qu'au succès (voir le script) :
        sans cela, chaque visite de la page ouvrirait une connexion vers Google
        pour un agenda que la plupart ne verront jamais.
      */}
      <iframe
        class="lead-booking-frame w-full h-[1000px] sm:h-[720px] rounded-lg border-0"
        data-src={bookingEmbedUrl}
        title={t(dict, 'lead.form.booking.title')}
      />
      {/*
        Repli permanent, pas un message d'erreur : l'iframe peut rester vide
        sans qu'aucun événement JS ne le signale (blocage des contenus tiers,
        extension de vie privée). Le lien est donc toujours visible.
      */}
      <p class="text-sm mt-3 text-center text-muted dark:text-slate-400">
        {t(dict, 'lead.form.booking.intro')}{' '}
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="underline font-semibold">
          {t(dict, 'lead.form.booking.cta')}
        </a>
      </p>
    </div>
  )
}

<script>
  // Attache en deux temps, et idempotente :
  //  - appel à la racine du script -> couvre le premier rendu. `astro:page-load`
  //    ne suffit pas : il est câblé sur le `load` de window (voir
  //    astro/dist/transitions/router.js), donc il attend toutes les
  //    sous-ressources de la page (scripts tiers différés, images, vidéos) —
  //    plusieurs secondes pendant lesquelles aucun `preventDefault` ne serait
  //    posé et où ClientRouter récupérerait la soumission ;
  //  - écouteur `astro:page-load` -> couvre les navigations ClientRouter, un
  //    script module ne se ré-exécutant jamais après sa première exécution
  //    dans la session (cache `scriptsAlreadyRan` d'Astro).
  // Le marqueur `dataset.leadFormBound` posé plus bas rend le double appel sans
  // effet : un formulaire déjà lié n'est jamais ré-attaché.
  function initLeadForms() {
    document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
      if (form.dataset.leadFormBound === '1') return;
      form.dataset.leadFormBound = '1';

      const msg = form.querySelector<HTMLParagraphElement>('.lead-form-msg');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const initialLabel = button?.textContent ?? '';

      // Sélecteur cycliste / bike-fitter (topic `test-period` uniquement) :
      // toggle purement visuel, l'état réellement retenu à la soumission est
      // celui du radio `profile_type:checked` natif.
      const profileCards = form.querySelectorAll<HTMLLabelElement>('.profile-card');
      const selectProfile = (card: HTMLLabelElement) => {
        profileCards.forEach((c) => {
          c.classList.remove('border-primary', 'bg-primary/10');
          c.classList.add('border-gray-300', 'dark:border-gray-600');
        });
        card.classList.remove('border-gray-300', 'dark:border-gray-600');
        card.classList.add('border-primary', 'bg-primary/10');
      };
      profileCards.forEach((card) => card.addEventListener('click', () => selectProfile(card)));

      // Présélection depuis l'URL : /periode-test/?profil=bike-fitter, le lien
      // posé sur la page bike-fitting. Le radio est coché en plus du style,
      // car c'est lui — et non la classe — qui est lu à la soumission.
      const wanted = new URLSearchParams(window.location.search).get('profil');
      if (wanted) {
        const card = form.querySelector<HTMLLabelElement>(`.profile-card[data-profile="${CSS.escape(wanted)}"]`);
        const radio = card?.querySelector<HTMLInputElement>('input[name="profile_type"]');
        if (card && radio) {
          radio.checked = true;
          selectProfile(card);
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!button) {
          // Soumission annulée par le preventDefault ci-dessus : sans trace, le
          // visiteur verrait un formulaire inerte et le lead serait perdu en silence.
          console.error('[LeadForm] bouton submit introuvable, soumission abandonnée', {
            topic: form.dataset.topic,
          });
          return;
        }

        button.disabled = true;
        button.textContent = form.dataset.sending ?? '…';

        const data = new FormData(form);
        // Seul le `topic` envoyé bascule selon le profil choisi — les libellés
        // affichés restent ceux du topic passé en prop (fixés au rendu par
        // `LABELS`), jamais réévalués ici.
        const selectedProfile = form.querySelector<HTMLInputElement>('input[name="profile_type"]:checked')?.value;
        const effectiveTopic = selectedProfile === 'bike-fitter' ? 'bike-fitter' : form.dataset.topic;
        const payload = {
          topic: effectiveTopic,
          name: String(data.get('name') ?? '').trim(),
          email: String(data.get('email') ?? '').trim(),
          message: String(data.get('message') ?? '').trim(),
          trainer: String(data.get('trainer') ?? '').trim(),
          webcam: String(data.get('webcam') ?? ''),
          hp: String(data.get('hp') ?? ''),
        };

        const lang = window.location.pathname.split('/')[1] || 'fr';

        let ok = false;
        try {
          const res = await fetch(`/${lang}/api/lead/`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          ok = res.ok && (await res.json())?.success === true;
        } catch {
          ok = false;
        }

        if (msg) {
          msg.textContent = (ok ? form.dataset.success : form.dataset.error) ?? '';
          msg.classList.remove('hidden', 'text-red-600', 'text-green-600');
          msg.classList.add(ok ? 'text-green-600' : 'text-red-600');
        }

        // Agenda de réservation (topic `test-period`, URL configurées) : révélé
        // uniquement au succès. Il vit hors du <form> — donc recherché dans le
        // document, pas dans le formulaire — et est absent du DOM tant que les
        // URL ne sont pas configurées (cf. showBooking).
        const booking = document.getElementById(`lead-booking-${form.dataset.topic}`);
        if (ok) {
          form.reset();
          if (booking) {
            const frame = booking.querySelector<HTMLIFrameElement>('.lead-booking-frame');
            // Une seule fois : une seconde affectation de `src` rechargerait
            // l'agenda et effacerait la sélection en cours du visiteur.
            if (frame && frame.dataset.loaded !== '1' && frame.dataset.src) {
              frame.dataset.loaded = '1';
              frame.src = frame.dataset.src;
            }
            booking.classList.remove('hidden');
            booking.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else {
          booking?.classList.add('hidden');
        }
        button.textContent = initialLabel;
        button.disabled = false;
      });
    });
  }

  initLeadForms();
  document.addEventListener('astro:page-load', initLeadForms);
</script>
