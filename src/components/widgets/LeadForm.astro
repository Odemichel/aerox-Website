---
import { type Locale, getDict, t } from '~/lib/i18n';
import { LINKS } from '~/config/links';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);

// Un seul public depuis l'unification du tunnel : la page /periode-test/ est
// la réservation de démo des bike-fitters. Le cycliste, lui, pré-réserve le
// Diagnostic depuis la section Tarifs — il n'a aucun créneau à prendre.
// C'est la valeur envoyée à /api/lead, qui la route vers le bon groupe MailerLite.
const TOPIC = 'bike-fitter';

// Agenda de réservation (plage de rendez-vous Google), encadré dans la page.
// Rendu seulement si les deux URL sont configurées (voir src/config/links.ts) :
// pas d'agenda mort en prod.
const bookingUrl = LINKS.booking;
// `hl` traduit l'agenda Google dans la langue de la page (vérifié : sans lui il
// rend en anglais même sur /fr/). L'URL de base porte déjà `?gv=true`, d'où le
// `&`. `lang` vient de la route, donc d'une locale connue, mais l'encodage
// reste posé : il coûte rien et ferme la question.
const bookingEmbedUrl = LINKS.bookingEmbed ? `${LINKS.bookingEmbed}&hl=${encodeURIComponent(lang)}` : '';
const showBooking = bookingUrl.length > 0 && bookingEmbedUrl.length > 0;

// Libellés B2B (`bf.form.*`, vouvoiement). `lead.form.*` porte ce qui est
// commun au formulaire et à l'agenda : envoi, succès, mentions de réservation.
const LABELS = {
  name: 'bf.form.name.placeholder',
  email: 'bf.form.email.placeholder',
  message: 'bf.form.message.placeholder',
  submit: 'lead.form.submit',
  success: 'lead.form.success',
  error: 'bf.form.error',
} as const;

const inputClass = 'w-full border rounded p-3 text-secondary';
---

<div class={showBooking ? 'grid items-start gap-8 xl:grid-cols-12' : ''}>
  {
    showBooking && (
      <div id="lead-booking" class="lead-form-booking xl:col-span-7">
        {/*
          `color-scheme: light` force l'agenda en clair. Sans elle, Google suit
          le thème du visiteur : en sombre son fond devient transparent, le
          fond bleu du site traverse et le texte gris devient illisible.
          La propriété s'applique bien au document encadré (vérifié sur WebKit
          et Chromium) ; `bg-white` couvre l'instant précédant le chargement.
        */}
        {/*
          Fenêtre de hauteur fixe : l'agenda ne s'étire jamais, quel que soit le
          nombre de créneaux du jour. La page de Google n'a aucun conteneur
          défilant interne (vérifié) et l'iframe est d'une autre origine, donc
          on ne peut pas faire défiler la seule colonne des créneaux. On
          recadre : l'iframe est plus haute que la fenêtre et remontée de la
          hauteur de l'en-tête Google (avatar, nom de la plage, mention Meet),
          qui redit ce que la page affiche déjà.

          Hauteur de l'iframe = décalage + hauteur de la fenêtre. C'est la
          condition pour que le défilement interne atteigne le dernier créneau :
          en dessous, les derniers seraient hors d'atteinte.

          Le décalage vaut 231 px dès 640 px de large (mesuré à 658, 770 et
          900 px). En dessous, l'en-tête se replie et grandit jusqu'à 308 px :
          trop instable pour être recadré, on le laisse visible en mobile.
        */}
        <div class="h-[900px] md:h-[700px] overflow-hidden rounded-xl bg-white [color-scheme:light]">
          <iframe
            class="lead-booking-frame w-full h-[900px] md:h-[931px] md:-mt-[231px] border-0"
            src={bookingEmbedUrl}
            loading="lazy"
            title={t(dict, 'lead.form.booking.title')}
          />
        </div>
        {/*
          Fuseau : l'agenda affiche les créneaux à l'heure de Paris quel que
          soit celui du visiteur — vérifié depuis Europe/Paris, Asia/Tokyo et
          America/New_York. Google l'étiquette lui-même, mais en anglais
          seulement : sur les 8 autres langues, cette ligne est la seule
          indication lisible. Le lien de repli reste visible en permanence :
          l'iframe peut rester vide sans qu'aucun événement JS ne le signale
          (blocage des contenus tiers).
        */}
        <p class="mt-3 text-xs text-muted dark:text-slate-400">
          {t(dict, 'lead.form.booking.timezone')} {t(dict, 'lead.form.booking.intro')}{' '}
          <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="underline">
            {t(dict, 'lead.form.booking.cta')}
          </a>
        </p>
      </div>
    )
  }

  <div class={showBooking ? 'xl:col-span-5' : ''}>
    <form
      id="lead-form"
      class={`lead-form flex w-full flex-col gap-4 text-left ${showBooking ? '' : 'mx-auto max-w-md'} ${className}`}
      data-topic="bike-fitter"
      data-success={t(dict, LABELS.success)}
      data-success-devis={t(dict, 'lead.form.success.devis')}
      data-error={t(dict, LABELS.error)}
      data-sending={t(dict, 'lead.form.sending')}
    >
      {/*
        Ce que demande le bike-fitter : une démo, ou seulement un tarif. Remonté
        tel quel dans MailerLite (`bf_intent`), c'est ce qui sépare un curieux
        d'un prospect chaud. `demo` est coché par défaut — c'est l'action que
        la page met en avant.
      */}
      <fieldset class="border-0 p-0 m-0">
        <legend class="mb-2 font-semibold">{t(dict, 'lead.form.intent.label')}</legend>
        <div class="grid grid-cols-2 gap-3">
          {[
            { v: 'demo', checked: true },
            { v: 'devis', checked: false },
          ].map(({ v, checked }) => (
            <label
              class={`intent-card flex cursor-pointer flex-col items-center gap-1 rounded-lg border-2 p-3 text-center transition-all ${checked ? 'border-primary bg-primary/10' : 'border-gray-300 dark:border-gray-600'}`}
              data-intent={v}
            >
              <input type="radio" name="intent" value={v} checked={checked} class="sr-only" />
              <span class="text-sm font-semibold">{t(dict, `lead.form.intent.${v}`)}</span>
              <span class="text-xs text-gray-600 dark:text-gray-400">{t(dict, `lead.form.intent.${v}.desc`)}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <input type="text" name="name" required placeholder={t(dict, LABELS.name)} class={inputClass} />
      <input type="email" name="email" required placeholder={t(dict, LABELS.email)} class={inputClass} />

      <label class="flex flex-col gap-1">
        <span class="font-semibold">{t(dict, 'lead.form.trainer.label')}</span>
        <input type="text" name="trainer" placeholder={t(dict, 'lead.form.trainer.placeholder')} class={inputClass} />
      </label>

      <fieldset class="border-0 p-0 m-0">
        <legend class="mb-2 font-semibold">{t(dict, 'lead.form.webcam.label')}</legend>
        <div class="flex gap-4">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="webcam" value="oui" /> {t(dict, 'lead.form.webcam.yes')}
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="radio" name="webcam" value="non" /> {t(dict, 'lead.form.webcam.no')}
          </label>
        </div>
      </fieldset>

      <textarea name="message" rows="3" placeholder={t(dict, LABELS.message)} class={inputClass}></textarea>

      {/* Honeypot : invisible pour l'humain, rempli par les bots. Jamais de label. */}
      <input
        type="text"
        name="hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="absolute left-[-9999px] w-px h-px opacity-0"
      />

      <button type="submit" class="btn-primary px-8 py-3 text-lg w-full font-semibold">
        {t(dict, LABELS.submit)}
      </button>
      <p class="lead-form-msg text-sm mt-2 hidden"></p>
    </form>
  </div>
</div>

<script>
  // Attache en deux temps, et idempotente :
  //  - appel à la racine du script -> couvre le premier rendu. `astro:page-load`
  //    ne suffit pas : il est câblé sur le `load` de window (voir
  //    astro/dist/transitions/router.js), donc il attend toutes les
  //    sous-ressources de la page (scripts tiers différés, images, vidéos) —
  //    plusieurs secondes pendant lesquelles aucun `preventDefault` ne serait
  //    posé et où ClientRouter récupérerait la soumission ;
  //  - écouteur `astro:page-load` -> couvre les navigations ClientRouter, un
  //    script module ne se ré-exécutant jamais après sa première exécution
  //    dans la session (cache `scriptsAlreadyRan` d'Astro).
  // Le marqueur `dataset.leadFormBound` posé plus bas rend le double appel sans
  // effet : un formulaire déjà lié n'est jamais ré-attaché.
  function initLeadForms() {
    document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
      if (form.dataset.leadFormBound === '1') return;
      form.dataset.leadFormBound = '1';

      const msg = form.querySelector<HTMLParagraphElement>('.lead-form-msg');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const initialLabel = button?.textContent ?? '';

      // Bascule purement visuelle : la valeur retenue à la soumission est celle
      // du radio natif, jamais la classe CSS.
      const intentCards = form.querySelectorAll<HTMLLabelElement>('.intent-card');
      intentCards.forEach((card) => {
        card.addEventListener('click', () => {
          intentCards.forEach((c) => {
            c.classList.remove('border-primary', 'bg-primary/10');
            c.classList.add('border-gray-300', 'dark:border-gray-600');
          });
          card.classList.remove('border-gray-300', 'dark:border-gray-600');
          card.classList.add('border-primary', 'bg-primary/10');
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!button) {
          // Soumission annulée par le preventDefault ci-dessus : sans trace, le
          // visiteur verrait un formulaire inerte et le lead serait perdu en silence.
          console.error('[LeadForm] bouton submit introuvable, soumission abandonnée', {
            topic: form.dataset.topic,
          });
          return;
        }

        button.disabled = true;
        button.textContent = form.dataset.sending ?? '…';

        const data = new FormData(form);
        const payload = {
          topic: form.dataset.topic,
          name: String(data.get('name') ?? '').trim(),
          email: String(data.get('email') ?? '').trim(),
          message: String(data.get('message') ?? '').trim(),
          trainer: String(data.get('trainer') ?? '').trim(),
          webcam: String(data.get('webcam') ?? ''),
          intent: String(data.get('intent') ?? 'demo'),
          hp: String(data.get('hp') ?? ''),
        };

        const lang = window.location.pathname.split('/')[1] || 'fr';

        let ok = false;
        try {
          const res = await fetch(`/${lang}/api/lead/`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          ok = res.ok && (await res.json())?.success === true;
        } catch {
          ok = false;
        }

        // Un devis n'appelle pas à réserver un créneau : le message de succès
        // change avec la demande, sinon on renvoie vers un agenda sans objet.
        const wantsQuote = form.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value === 'devis';
        const successText = wantsQuote ? form.dataset.successDevis : form.dataset.success;
        if (msg) {
          msg.textContent = (ok ? successText : form.dataset.error) ?? '';
          msg.classList.remove('hidden', 'text-red-600', 'text-green-600');
          msg.classList.add(ok ? 'text-green-600' : 'text-red-600');
        }

        // L'agenda est affiché en permanence au-dessus du formulaire : rien à
        // révéler ici. Le formulaire ne sert plus qu'à transmettre le contexte
        // de la séance, il ne conditionne plus la réservation.
        if (ok) form.reset();
        button.textContent = initialLabel;
        button.disabled = false;
      });
    });
  }

  initLeadForms();
  document.addEventListener('astro:page-load', initLeadForms);
</script>
