---
import Prices from '~/components/widgets/Pricing.astro';
import { type Locale, getDict, t } from '~/lib/i18n';
import { localizedHref } from '~/utils/localize';
import { offerPhase, phased } from '~/lib/offerPhase';

// Section tarifs partagée par l'accueil et le dashboard : les deux rendaient
// jusqu'ici la même grille, dupliquée props par props. Elle porte l'ancre
// `#pricing` visée par l'entrée de menu « Tarifs » (src/navigation.ts).
const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);
// Espace compte d'un cycliste : seules ses offres, sans la carte bike fitter.
const { riderOnly = false } = Astro.props as { riderOnly?: boolean };
// Offre de lancement terminée au moment du rendu : prix plein, sans prix barré
// ni ruban. Sinon, OfferPhases fait la bascule dans le navigateur.
const launchOver = offerPhase() === 'full';
---

<Prices
  id="pricing"
  title={t(dict, 'pricing.title')}
  subtitle={t(dict, 'pricing.subtitle')}
  subsubtitle={t(dict, riderOnly ? 'pricing.subsubtitleRider' : 'pricing.subsubtitle')}
  prices={[
    {
      title: t(dict, 'pricing.diagnostic.title'),
      subtitle: t(dict, 'pricing.diagnostic.subtitle'),
      price: launchOver ? '79' : '49',
      priceBefore: launchOver ? '' : '79',
      priceFull: '79',
      period: t(dict, 'pricing.diagnostic.period'),
      note: phased(t(dict, 'pricing.diagnostic.note'), t(dict, 'pricing.diagnostic.note.live')),
      guarantee: t(dict, 'pricing.diagnostic.guarantee'),
      items: [
        // Ce que tu fais, ce que tu reçois, ce qu'il te faut.
        { description: t(dict, 'pricing.diagnostic.items.1'), icon: 'tabler:ruler-measure' },
        { description: t(dict, 'pricing.diagnostic.items.2'), icon: 'tabler:report-analytics' },
        { description: t(dict, 'pricing.diagnostic.items.3'), icon: 'tabler:device-desktop' },
      ],
      callToAction: {
        text: phased(
          t(dict, 'pricing.diagnostic.cta'),
          t(dict, 'pricing.diagnostic.cta.live'),
          t(dict, 'pricing.diagnostic.cta.full')
        ),
        id: 'btn-buy-diagnostic',
        type: 'button',
      },
      hasRibbon: !launchOver,
      ribbonTitle: t(dict, 'pricing.diagnostic.ribbon'),
    },
    ...(riderOnly
      ? []
      : [
          {
            // Pas de `price` : la carte affiche `priceLabel` au lieu d'un € orphelin.
            title: t(dict, 'pricing.b2b.title'),
            subtitle: t(dict, 'pricing.b2b.subtitle'),
            priceLabel: t(dict, 'pricing.b2b.priceLabel'),
            period: t(dict, 'pricing.b2b.period'),
            items: [
              { description: t(dict, 'pricing.b2b.items.1'), icon: 'tabler:receipt-euro' },
              { description: t(dict, 'pricing.b2b.items.2'), icon: 'tabler:users' },
              { description: t(dict, 'pricing.b2b.items.3'), icon: 'tabler:lifebuoy' },
            ],
            callToAction: {
              text: t(dict, 'pricing.b2b.cta'),
              href: localizedHref(lang, '/bike-fitting/#tarifs'),
              target: '',
            },
            hasRibbon: false,
            ribbonTitle: '',
          },
        ]),
  ]}
/>

<div
  id="buy-diagnostic-config"
  data-lang={lang}
  data-error={t(dict, 'pricing.diagnostic.error')}
  data-owned={t(dict, 'pricing.diagnostic.alreadyOwned')}
  data-bf={t(dict, 'pricing.diagnostic.bfAccount')}
  class="hidden"
>
</div>

<script>
  import { supabase } from '~/config/supabaseClient';

  // Attache en deux temps, et idempotente :
  //  - appel à la racine du script -> couvre le premier rendu. `astro:page-load`
  //    ne suffit pas : il est câblé sur le `load` de window (voir
  //    astro/dist/transitions/router.js), donc il attend toutes les
  //    sous-ressources de la page — plusieurs secondes pendant lesquelles le
  //    clic sur « Je commande » resterait sans effet ;
  //  - écouteur `astro:page-load` -> couvre les navigations ClientRouter, un
  //    script module ne se ré-exécutant jamais après sa première exécution
  //    dans la session (cache `scriptsAlreadyRan` d'Astro).
  // Le marqueur `dataset.buyDiagnosticBound` rend le double appel sans effet.
  function initBuyDiagnostic() {
    const btn = document.getElementById('btn-buy-diagnostic') as HTMLButtonElement | null;
    if (!btn || btn.dataset.buyDiagnosticBound === '1') return;
    btn.dataset.buyDiagnosticBound = '1';

    // Lu ici et non à la racine du module : après une navigation ClientRouter
    // le nœud de configuration du nouveau document remplace l'ancien.
    const cfg = document.getElementById('buy-diagnostic-config');
    const lang = cfg?.dataset.lang ?? 'fr';
    const buyError = cfg?.dataset.error ?? '';
    const alreadyOwned = cfg?.dataset.owned ?? '';
    const bfAccount = cfg?.dataset.bf ?? '';

    // Deux situations mènent au même endroit : aucune session dans le
    // navigateur, et une session que le serveur refuse (compte supprimé,
    // secret tourné, horloge décalée). Dans les deux cas l'acheteur doit
    // pouvoir se reconnecter et revenir ici — d'où le point de retour.
    // `encodeURIComponent` est indispensable : le `#` non encodé deviendrait
    // un fragment au lieu d'une valeur de paramètre, et la page de connexion,
    // qui valide cette valeur via `safeRedirect`, retomberait sur le dashboard.
    // Quelqu'un qui vient de cliquer « Je pré-réserve » n'a, dans l'immense
    // majorité des cas, pas encore de compte : lui demander de se connecter est
    // un mur. On l'envoie créer son compte ; la page d'inscription porte un lien
    // « déjà inscrit ? » pour le cas inverse, et transmet `redirect` à la suite.
    const goToSignup = () => {
      const back = encodeURIComponent(`/${lang}/#pricing`);
      window.location.href = `/${lang}/inscription/inscription/?redirect=${back}`;
    };

    btn.addEventListener('click', async () => {
      const prev = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '…';

      try {
        // `getSession` plutôt que `getUser` : on a besoin du jeton d'accès
        // lui-même, pas seulement du profil. C'est ce jeton que la route
        // vérifie auprès de Supabase pour établir *qui* achète — l'identifiant
        // ne transite plus dans le corps, où n'importe qui pouvait le
        // remplacer par celui d'un autre compte. `getSession` rafraîchit un
        // jeton expiré au passage (autoRefreshToken).
        const { data } = await supabase.auth.getSession();
        const session = data?.session;
        const user = session?.user;

        // Connexion obligatoire avant le checkout.
        if (!user || !session) {
          goToSignup();
          return;
        }

        // Corps réduit à ce que le serveur ne peut pas deviner : le produit
        // voulu et la langue. Le prix vient de la table serveur
        // `product -> lookup_key`, l'identifiant et l'e-mail du jeton vérifié.
        const res = await fetch(`/${lang}/telechargement/api/create-api-checkout/`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({
            product: 'diagnostic',
            lang,
          }),
        });
        // Le serveur a refusé le jeton : c'est un « pas de session », pas une
        // panne. Sans ce cas, la route renvoyait 401, le `catch` affichait une
        // alerte et l'acheteur restait coincé sans issue — alors qu'une
        // reconnexion suffit.
        if (res.status === 401) {
          goToSignup();
          return;
        }

        // Un diagnostic payé et non utilisé (ou en cours) existe déjà : pas de
        // second paiement, on renvoie vers l'espace où il apparaît.
        // Compte bike fitter : le Diagnostic est réservé aux cyclistes.
        if (res.status === 403) {
          alert(bfAccount);
          btn.disabled = false;
          btn.innerHTML = prev;
          return;
        }

        if (res.status === 409) {
          if (confirm(alreadyOwned)) window.location.href = `/${lang}/inscription/dashboard/`;
          btn.disabled = false;
          btn.innerHTML = prev;
          return;
        }

        const payload = await res.json();
        if (!payload?.url) throw new Error(payload?.error || 'no url');
        window.location.href = payload.url;
      } catch (err) {
        console.error('[PricingSection] checkout diagnostic', err);
        alert(buyError);
        btn.disabled = false;
        btn.innerHTML = prev;
      }
    });
  }

  initBuyDiagnostic();
  document.addEventListener('astro:page-load', initBuyDiagnostic);
</script>
