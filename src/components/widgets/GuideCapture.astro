---
// Capture email : le livre complet « S'entraîner à l'aérodynamisme » (60 pages,
// offert), envoyé par la même route que la page Méthode. Placé
// plusieurs fois par page : `id` distingue chaque exemplaire. `texts` remplace
// les clés i18n du titre et de la promesse (ex. page CdA : surface frontale).
import { Image } from 'astro:assets';
import livreCover from '~/assets/images/livre/image_livre_entrainer-aero.png';
import { type Locale, getDict, t } from '~/lib/i18n';

type Texts = { eyebrow: string; title: string; text: string };
// `source` : origine transmise à MailerLite (champ signup_source).
const { lang, id, texts, source } = Astro.props as { lang: Locale; id: string; texts?: Texts; source: string };
const dict = getDict(lang);
const k: Texts = texts ?? { eyebrow: 'home.guide.eyebrow', title: 'home.guide.title', text: 'book.hero.text' };
---

<section class="relative not-prose" id={`guide-${id}`}>
  <div class="mx-auto max-w-4xl px-4 md:px-6 py-8 md:py-10">
    <div
      class="bg-gradient-to-r from-primary/5 via-primary/10 to-primary/5 dark:from-primary/10 dark:via-primary/20 dark:to-primary/10 rounded-2xl px-6 py-8 md:px-10 md:py-10 border border-primary/15 flex flex-col md:flex-row items-center gap-6 md:gap-10"
    >
      <Image
        src={livreCover}
        alt={t(dict, 'book.hero.alt')}
        widths={[160, 320]}
        sizes="160px"
        class="w-32 md:w-40 h-auto shrink-0"
        loading="lazy"
      />
      <div class="w-full text-center md:text-left">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-1">
          {t(dict, k.eyebrow)}
        </p>
        <h2 class="text-xl md:text-2xl font-bold mb-2">{t(dict, k.title)}</h2>
        <p class="text-sm text-muted mb-5" set:html={t(dict, k.text)} />
        <form
          data-guide-capture
          data-source={source}
          class="flex flex-col sm:flex-row items-center gap-3"
          data-success={t(dict, 'book.form.success')}
          data-error={t(dict, 'book.form.error')}
        >
          <input
            type="email"
            name="email"
            aria-label={t(dict, 'book.form.email.placeholder')}
            placeholder={t(dict, 'book.form.email.placeholder')}
            required
            class="w-full sm:flex-1 border border-gray-300 dark:border-slate-600 rounded-lg px-4 py-2.5 text-sm text-gray-900 dark:text-white bg-white dark:bg-slate-800 placeholder:text-gray-500 dark:placeholder:text-slate-400"
          />
          {/* Honeypot : invisible pour l'humain, rempli par les bots. Jamais de label. */}
          <input
            type="text"
            name="hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="absolute left-[-9999px] w-px h-px opacity-0"
          />
          <button type="submit" class="btn-primary px-6 py-2.5 text-sm font-semibold rounded-lg">
            {t(dict, 'book.form.submit')}
          </button>
        </form>
        <p data-guide-msg class="text-sm mt-3 hidden"></p>
        <p class="text-xs text-muted mt-3">{t(dict, 'book.form.privacy')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initGuideCaptureForms } from '~/lib/guideCaptureForm';

  initGuideCaptureForms();
  document.addEventListener('astro:page-load', initGuideCaptureForms);
</script>
