---
// Barre fixe de l'offre Diagnostic, sur ordinateur seulement (le header mobile
// porte déjà le bouton) : visible après le premier écran, masquée quand la
// section tarifs ou le pied de page est à l'écran. `data-rider-promo` : le
// tableau de bord la retire pour un compte bike fitter. `data-launch-offer` :
// retirée par OfferPhases une fois l'offre terminée.
import { type Locale, getDict, t } from '~/lib/i18n';
import { phased } from '~/lib/offerPhase';

const { lang } = Astro.props as { lang: Locale };
const dict = getDict(lang);
---

<div
  id="offer-bar"
  data-rider-promo
  data-launch-offer
  class="fixed inset-x-0 bottom-0 z-30 hidden md:flex translate-y-full transition-transform duration-300 justify-center border-t border-primary/30 bg-white/95 dark:bg-slate-900/95 backdrop-blur px-4 py-3"
>
  <div class="flex items-center gap-4 text-sm font-medium">
    <span>{t(dict, 'offerBar.text')}</span>
    <a
      href={`/${lang}/#pricing`}
      class="btn-primary px-5 py-1.5 text-sm font-semibold rounded-lg"
      set:html={phased(t(dict, 'offerBar.cta'), t(dict, 'cta.preorder.short'))}
    />
  </div>
</div>

<script>
  let cleanup: (() => void) | undefined;

  function initOfferBar() {
    cleanup?.();
    const bar = document.getElementById('offer-bar');
    if (!bar) return;

    let pastHero = false;
    let blocked = 0; // nombre de zones (tarifs, pied de page) à l'écran
    const update = () => {
      const show = pastHero && blocked === 0;
      bar.classList.toggle('translate-y-full', !show);
      // Les boutons flottants (StickyBar) remontent au-dessus de la barre.
      document.documentElement.toggleAttribute('data-offer-bar', show);
    };

    const onScroll = () => {
      const next = window.scrollY > window.innerHeight * 0.8;
      if (next !== pastHero) {
        pastHero = next;
        update();
      }
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const was = (e.target as HTMLElement).dataset.offerBlocking === '1';
        if (e.isIntersecting && !was) blocked++;
        if (!e.isIntersecting && was) blocked--;
        (e.target as HTMLElement).dataset.offerBlocking = e.isIntersecting ? '1' : '0';
      });
      update();
    });
    document.querySelectorAll('#pricing, footer').forEach((el) => io.observe(el));

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    cleanup = () => {
      io.disconnect();
      window.removeEventListener('scroll', onScroll);
      document.documentElement.removeAttribute('data-offer-bar');
    };
  }

  initOfferBar();
  document.addEventListener('astro:page-load', initOfferBar);
</script>
