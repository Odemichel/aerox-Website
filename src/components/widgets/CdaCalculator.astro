---
// Calculateur de CdA, en deux étapes :
//  1. le calculateur : puissance, vitesse, masses, pente (+ altitude et
//     température facultatives) → CdA estimé (src/lib/cda.ts), catégorie du
//     tableau des valeurs typiques et hypothèses du calcul ;
//  2. l'analyseur : taille + vélo de route / contre-la-montre → ce que le
//     cycliste pourrait gagner face à une position optimisée pour sa
//     morphologie (km/h à puissance égale, watts à vitesse égale), puis le
//     pont vers le Diagnostic.
import { CRR, ETA } from '~/lib/cda';
import { type Locale, getDict, t } from '~/lib/i18n';
import { localizedHref } from '~/utils/localize';

const { lang } = Astro.props as { lang: Locale };
const dict = getDict(lang);

const categoryKeys = ['city', 'road_hoods', 'road_drops', 'tt', 'pro_tt', 'track'];
const categories = Object.fromEntries(categoryKeys.map((k) => [k, t(dict, `cda.values.${k}.label`)]));

// Étape 1. Poids du cycliste + masse du vélo = masse totale de la formule.
const fields = [
  { name: 'power', label: t(dict, 'cda.calc.power'), value: 200, min: 1, max: 2000, step: 1 },
  { name: 'speed', label: t(dict, 'cda.calc.speed'), value: 30, min: 1, max: 90, step: 0.1 },
  { name: 'riderWeight', label: t(dict, 'cda.calc.riderWeight'), value: 72, min: 30, max: 180, step: 0.1 },
  { name: 'bikeWeight', label: t(dict, 'cda.calc.bikeWeight'), value: 8, min: 4, max: 25, step: 0.1 },
  { name: 'slope', label: t(dict, 'cda.calc.slope'), value: 0, min: -10, max: 15, step: 0.1 },
];
// Facultatifs : sans saisie, air au niveau de la mer à 15 °C.
const optionalFields = [
  { name: 'altitude', label: t(dict, 'cda.calc.altitude'), placeholder: '0', min: -500, max: 5000, step: 1 },
  { name: 'temperature', label: t(dict, 'cda.calc.temp'), placeholder: '15', min: -30, max: 50, step: 0.1 },
];
const inputClass =
  'border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-base text-gray-900 dark:text-white bg-white dark:bg-slate-800';
---

<div
  data-cda-tool
  data-lang={lang}
  data-result={t(dict, 'cda.calc.result')}
  data-category={t(dict, 'cda.calc.category')}
  data-invalid={t(dict, 'cda.calc.invalid')}
  data-categories={JSON.stringify(categories)}
  data-assumptions={t(dict, 'cda.calc.assumptions')}
  data-optimal-short={t(dict, 'cda.calc.optimalShort')}
  data-at-speed={t(dict, 'cda.calc.atSpeed')}
  data-kmh={lang === 'nl' ? 'km/u' : lang === 'tr' ? 'km/s' : 'km/h'}
  data-bike-road={t(dict, 'cda.calc.bikeIn.road')}
  data-bike-tt={t(dict, 'cda.calc.bikeIn.tt')}
  data-crr={CRR}
  data-eta={ETA}
  class="not-prose my-8 space-y-6"
>
  <!-- 1. Calculateur -->
  <section class="rounded-2xl border border-gray-200 dark:border-slate-700 p-5 md:p-6">
    <p class="text-lg font-bold mb-2">{t(dict, 'cda.calc.step1')}</p>
    <p class="text-sm text-muted mb-4">{t(dict, 'cda.calc.howto')}</p>
    <form data-cda-calc class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        fields.map((f) => (
          <label class="flex flex-col gap-1 text-sm font-medium">
            {f.label}
            <input
              type="number"
              name={f.name}
              value={f.value}
              min={f.min}
              max={f.max}
              step={f.step}
              required
              inputmode="decimal"
              class={inputClass}
            />
          </label>
        ))
      }
      {
        optionalFields.map((f) => (
          <label class="flex flex-col gap-1 text-sm font-medium">
            {f.label}
            <input
              type="number"
              name={f.name}
              placeholder={f.placeholder}
              min={f.min}
              max={f.max}
              step={f.step}
              inputmode="decimal"
              class={inputClass}
            />
          </label>
        ))
      }
      <button type="submit" class="btn-primary sm:col-span-2 px-6 py-2.5 font-semibold rounded-lg">
        {t(dict, 'cda.calc.submit')}
      </button>
    </form>

    <div data-cda-output class="mt-5 hidden" aria-live="polite">
      <p data-cda-value class="text-xl font-bold"></p>
      <p data-cda-category class="text-muted mt-1"></p>
      <p data-cda-assumptions class="text-xs text-muted mt-2"></p>
    </div>
  </section>

  <!-- 2. Analyseur -->
  <section class="rounded-2xl border border-primary/30 bg-primary/5 p-5 md:p-6">
    <p class="text-lg font-bold mb-2">{t(dict, 'cda.analyze.title')}</p>
    <p class="text-sm text-muted mb-4">{t(dict, 'cda.analyze.intro')}</p>
    <form data-cda-analyze class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-end">
      <label class="flex flex-col gap-1 text-sm font-medium">
        {t(dict, 'cda.calc.height')}
        <input
          type="number"
          name="height"
          value="178"
          min="120"
          max="220"
          step="1"
          required
          inputmode="decimal"
          class={inputClass}
        />
        <span class="text-xs font-normal text-muted">{t(dict, 'cda.analyze.weightNote')}</span>
      </label>

      {/* Choix du vélo : même sélecteur que mensuel / annuel des tarifs bike fitter. */}
      <div class="flex flex-col gap-1 text-sm font-medium">
        <span>{t(dict, 'cda.calc.bike')}</span>
        <div class="inline-flex self-start rounded-full border border-gray-300 dark:border-slate-600 p-1" role="group">
          <button type="button" class="cda-bike rounded-full px-3 py-1 text-sm" data-bike="road">
            {t(dict, 'cda.analyze.road')}
          </button>
          <button type="button" class="cda-bike rounded-full px-3 py-1 text-sm" data-bike="tt">
            {t(dict, 'cda.analyze.tt')}
          </button>
        </div>
      </div>

      <button
        type="submit"
        disabled
        class="btn-primary sm:col-span-2 px-6 py-2.5 font-semibold rounded-lg disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {t(dict, 'cda.analyze.submit')}
      </button>
      <p data-analyze-need class="sm:col-span-2 text-xs text-muted -mt-2">{t(dict, 'cda.analyze.needCda')}</p>
    </form>

    <div data-cda-gain class="mt-5 hidden" aria-live="polite">
      <p class="font-bold mb-3">{t(dict, 'cda.calc.gainTitle')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
        <div class="rounded-lg bg-white/70 dark:bg-slate-900/40 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-muted">{t(dict, 'cda.calc.tile.target')}</p>
          <p data-gain-target class="text-2xl font-bold"></p>
          <p data-gain-bike class="text-xs text-muted"></p>
        </div>
        <div class="rounded-lg bg-white/70 dark:bg-slate-900/40 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-muted">{t(dict, 'cda.calc.tile.speed')}</p>
          <p data-gain-kmh class="text-2xl font-bold text-primary"></p>
          <p data-gain-speed class="text-xs text-muted"></p>
        </div>
        <div class="rounded-lg bg-white/70 dark:bg-slate-900/40 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-muted">{t(dict, 'cda.calc.tile.watts')}</p>
          <p data-gain-watts class="text-2xl font-bold text-primary"></p>
          <p data-gain-at class="text-xs text-muted"></p>
        </div>
      </div>
      <p data-gain-optimal class="mt-3 font-medium hidden"></p>
      <p class="mt-3 text-xs text-muted">{t(dict, 'cda.calc.estimates')}</p>
      <p class="mt-4 text-sm">
        {t(dict, 'cda.calc.bridge')}
        <a href={localizedHref(lang, '/#pricing')} class="text-primary font-semibold underline ml-1">
          {t(dict, 'cda.diag.cta')} →
        </a>
      </p>
    </div>
  </section>
</div>

<script>
  import { type Bike, type CdaInput, airDensity, cdaCategory, estimateCdA, optimizedGain } from '~/lib/cda';

  function initCdaTools() {
    document.querySelectorAll<HTMLElement>('[data-cda-tool]').forEach((tool) => {
      if (tool.dataset.bound === '1') return;
      tool.dataset.bound = '1';
      const d = tool.dataset;
      const q = (sel: string) => tool.querySelector<HTMLElement>(sel)!;
      const calc = q('form[data-cda-calc]') as HTMLFormElement;
      const analyze = q('form[data-cda-analyze]') as HTMLFormElement;
      const analyzeBtn = analyze.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const [out, value, category, assumptions, need, gainBox] = [
        '[data-cda-output]',
        '[data-cda-value]',
        '[data-cda-category]',
        '[data-cda-assumptions]',
        '[data-analyze-need]',
        '[data-cda-gain]',
      ].map(q);
      const [gTarget, gBike, gKmh, gSpeed, gWatts, gAt, gOptimal] = [
        '[data-gain-target]',
        '[data-gain-bike]',
        '[data-gain-kmh]',
        '[data-gain-speed]',
        '[data-gain-watts]',
        '[data-gain-at]',
        '[data-gain-optimal]',
      ].map(q);
      const nf = (o: Intl.NumberFormatOptions) => new Intl.NumberFormat(d.lang, o);
      const n0 = nf({ maximumFractionDigits: 0 });
      const n1 = nf({ minimumFractionDigits: 1, maximumFractionDigits: 1 });
      const n2 = nf({ minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const n3 = nf({ maximumFractionDigits: 3 });
      const nMax1 = nf({ maximumFractionDigits: 1 });
      const labels = JSON.parse(d.categories ?? '{}') as Record<string, string>;
      const num = (form: HTMLFormElement, name: string) =>
        Number((form.elements.namedItem(name) as HTMLInputElement).value);
      // Champ facultatif vide : valeur par défaut (0 m, 15 °C).
      const opt = (name: string, fallback: number) => {
        const raw = (calc.elements.namedItem(name) as HTMLInputElement).value.trim();
        return raw === '' ? fallback : Number(raw);
      };

      // Compteur d'usage anonyme (Supabase, voir /api/cda-event/) : n'attend
      // pas la réponse et n'affecte jamais l'affichage.
      const track = (kind: 'calc' | 'analyze', bike?: Bike) => {
        fetch('/api/cda-event/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind, lang: d.lang, ...(bike ? { bike } : {}) }),
          keepalive: true,
        }).catch(() => undefined);
      };

      // Résultat de l'étape 1, repris par l'étape 2.
      let last: { cda: number; input: CdaInput; riderWeight: number } | null = null;
      const setAnalyzable = (ok: boolean) => {
        analyzeBtn.disabled = !ok;
        need.classList.toggle('hidden', ok);
        if (!ok) gainBox.classList.add('hidden');
      };

      // Relance l'analyse affichée (dispatchEvent plutôt que requestSubmit,
      // absent de Safari 15).
      const rerunAnalysis = () => analyze.dispatchEvent(new Event('submit', { cancelable: true }));
      // Choix du vélo : le bouton actif ressort (fond orange, texte bleu nuit en gras).
      let bike: Bike = 'road';
      const bikeButtons = [...tool.querySelectorAll<HTMLButtonElement>('.cda-bike')];
      const syncBike = () => {
        bikeButtons.forEach((b) => {
          const on = b.dataset.bike === bike;
          b.classList.toggle('bg-primary', on);
          b.classList.toggle('text-[#0b2239]', on);
          b.classList.toggle('font-bold', on);
          b.setAttribute('aria-pressed', String(on));
        });
      };
      bikeButtons.forEach((b) =>
        b.addEventListener('click', () => {
          bike = b.dataset.bike === 'tt' ? 'tt' : 'road';
          syncBike();
          // Analyse déjà affichée : elle suit le choix du vélo.
          if (!gainBox.classList.contains('hidden')) rerunAnalysis();
        })
      );
      syncBike();

      calc.addEventListener('submit', (e) => {
        e.preventDefault();
        const altitudeM = opt('altitude', 0);
        const temperatureC = opt('temperature', 15);
        const riderWeight = num(calc, 'riderWeight');
        const input: CdaInput = {
          power: num(calc, 'power'),
          speedKmh: num(calc, 'speed'),
          massKg: riderWeight + num(calc, 'bikeWeight'),
          slopePct: num(calc, 'slope'),
          altitudeM,
          temperatureC,
        };
        const cda = estimateCdA(input);
        out.classList.remove('hidden');
        if (cda === null) {
          value.textContent = d.invalid ?? '';
          category.textContent = '';
          assumptions.textContent = '';
          last = null;
          setAnalyzable(false);
          return;
        }
        value.textContent = (d.result ?? '').replace('{cda}', n2.format(cda));
        category.textContent = (d.category ?? '').replace('{category}', labels[cdaCategory(cda)] ?? '');
        assumptions.textContent = (d.assumptions ?? '')
          .replace('{crr}', n3.format(Number(d.crr)))
          .replace('{eta}', String(Math.round(Number(d.eta) * 100)))
          .replace('{rho}', n3.format(airDensity(altitudeM, temperatureC)))
          .replace('{altitude}', String(altitudeM))
          .replace('{temperature}', String(temperatureC));
        last = { cda, input, riderWeight };
        setAnalyzable(true);
        track('calc');
        // Analyse déjà affichée : elle suit le nouveau calcul.
        if (!gainBox.classList.contains('hidden')) rerunAnalysis();
      });

      analyze.addEventListener('submit', (e) => {
        e.preventDefault();
        const height = num(analyze, 'height');
        if (!last || !(height > 0)) return;
        const gain = optimizedGain(last.cda, last.input, bike, last.riderWeight, height);
        if (!Number.isFinite(gain.targetCda)) return;
        const bikeLabel = (bike === 'tt' ? d.bikeTt : d.bikeRoad) ?? '';
        const kmh = d.kmh ?? 'km/h';
        // Les gains s'affichent toujours ; s'il n'y en a pas, la ligne courte le dit.
        const gainKmh = gain.alreadyOptimal ? 0 : gain.gainKmh;
        const watts = gain.alreadyOptimal ? 0 : gain.wattsSaved;
        gTarget.textContent = `${n2.format(gain.targetCda)} m²`;
        gBike.textContent = bikeLabel;
        gKmh.textContent = `+${n1.format(gainKmh)} ${kmh}`;
        gSpeed.textContent = `${n1.format(gain.alreadyOptimal ? last.input.speedKmh : gain.speedKmh)} ${kmh}`;
        gWatts.textContent = watts > 0 ? `−${n0.format(watts)} W` : '0 W';
        gAt.textContent = (d.atSpeed ?? '').replace('{speed}', nMax1.format(last.input.speedKmh));
        gOptimal.classList.toggle('hidden', !gain.alreadyOptimal);
        gOptimal.textContent = (d.optimalShort ?? '').replace('{bike}', bikeLabel);
        gainBox.classList.remove('hidden');
        track('analyze', bike);
      });
    });
  }

  initCdaTools();
  document.addEventListener('astro:page-load', initCdaTools);
</script>
