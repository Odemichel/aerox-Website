---
// « Facteurs qui influencent le CdA » (/cda) : 4 cartes illustrées (corps,
// équipement, vélo, accessoires). Dessins : illustration générée, recadrée sans
// son texte et recolorée en orange AeroX (src/assets/images/cda/factors/).
import type { ImageMetadata } from 'astro';
import { t } from '~/lib/i18n';

interface Props {
  dict: Record<string, string>;
}
const { dict } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('~/assets/images/cda/factors/*.webp', { eager: true });
const image = (n: number) => {
  const entry = Object.entries(files).find(([path]) => path.endsWith(`/factor-${n}.webp`));
  if (!entry) throw new Error(`Illustration manquante : factor-${n}.webp`);
  return entry[1].default;
};
const has = (key: string) => key in dict;
const factors = [1, 2, 3, 4].map((n) => {
  const text = t(dict, `cda.optimize.f${n}.text`);
  return {
    n,
    img: image(n),
    title: t(dict, `cda.optimize.f${n}.title`),
    stat: has(`cda.optimize.f${n}.stat`) ? t(dict, `cda.optimize.f${n}.stat`) : '',
    // Texte simple, ou liste « libellé::valeur|… » (équipement).
    list: text.includes('::') ? text.split('|').map((item) => item.split('::')) : null,
    text,
  };
});
---

<div class="not-prose my-8">
  <ol class="grid gap-3 sm:grid-cols-2">
    {
      factors.map((f) => (
        <li class="flex flex-col overflow-hidden rounded-xl border border-primary/30 bg-slate-950/50 shadow-[0_0_14px_rgba(251,165,47,0.1)]">
          <div class="relative flex h-32 items-center justify-center bg-[#08111f]">
            <img
              src={f.img.src}
              width={f.img.width}
              height={f.img.height}
              alt=""
              loading="lazy"
              class="h-full w-auto max-w-full object-contain"
            />
            <span class="absolute left-2 top-2 flex h-7 w-7 items-center justify-center rounded-full border border-primary bg-slate-950/80 text-sm font-bold text-primary">
              {f.n}
            </span>
          </div>
          <div class="p-3">
            <p class="flex flex-wrap items-baseline justify-between gap-x-3 font-bold text-white">
              {f.title}
              {f.stat && <span class="text-lg font-black italic text-primary">{f.stat}</span>}
            </p>
            {f.list ? (
              <ul class="mt-1.5 space-y-1">
                {f.list.map(([label, value]) => (
                  <li class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="text-slate-300">{label}</span>
                    <span class="whitespace-nowrap font-bold italic text-primary tabular-nums">{value}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-1 text-sm leading-snug text-slate-300">{f.text}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-xs italic text-slate-400">{t(dict, 'cda.optimize.note')}</p>
</div>
