---
// Watts perdus par rapport à la position 6 (tout optimisé) à 30 et 40 km/h :
// différence de puissance aérodynamique, avec le milieu de chaque fourchette de
// CdA (src/lib/cdaPositions.ts). Un seul chiffre par vitesse.
import { t } from '~/lib/i18n';
import { CDA_POSITIONS, aeroWatts } from '~/lib/cdaPositions';
import { positionImage } from '~/lib/cdaPositionImages';

interface Props {
  dict: Record<string, string>;
}
const { dict } = Astro.props;

const [title, at30] = t(dict, 'cda.values.header4').split(' · ');
const at40 = t(dict, 'cda.values.header5').split(' · ')[1];
const mid = ([lo, hi]: readonly number[]) => (lo + hi) / 2;
const best = mid(CDA_POSITIONS[CDA_POSITIONS.length - 1].cda);
const lost = (cda: readonly number[], kmh: number) =>
  mid(cda) === best ? t(dict, 'cda.values.ref') : `+${aeroWatts(mid(cda) - best, kmh)} W`;
const rows = CDA_POSITIONS.map((r) => ({
  n: r.n,
  label: t(dict, `cda.values.${r.key}.desc`),
  w30: lost(r.cda, 30),
  w40: lost(r.cda, 40),
  isRef: mid(r.cda) === best,
  face: positionImage(r.n),
}));
---

<div class="not-prose my-8">
  <div
    class="grid grid-cols-[1fr_6rem_6rem] sm:grid-cols-[3.5rem_1fr_7.5rem_7.5rem] gap-3 items-end rounded-t-xl border border-primary/40 bg-slate-950/60 px-3 py-2.5 text-sm font-bold uppercase tracking-wide text-primary"
  >
    <span class="sm:col-span-2">{title}</span>
    <span class="text-right">{at30}</span>
    <span class="text-right">{at40}</span>
  </div>
  <ol class="mt-2 space-y-2">
    {
      rows.map((r) => (
        <li class="grid grid-cols-[1fr_6rem_6rem] sm:grid-cols-[3.5rem_1fr_7.5rem_7.5rem] items-center gap-3 rounded-xl border border-primary/30 bg-slate-950/50 p-1.5 pr-3 shadow-[0_0_14px_rgba(251,165,47,0.08)]">
          <img
            src={r.face.src}
            width={r.face.width}
            height={r.face.height}
            alt=""
            loading="lazy"
            class="hidden sm:block h-[4.1rem] w-[3.5rem] rounded-lg object-cover"
          />
          <p class="text-sm font-semibold leading-snug text-white">
            <span class="mr-1 text-primary">{r.n}.</span>
            {r.label}
          </p>
          <p
            class={`whitespace-nowrap text-right tabular-nums ${r.isRef ? 'text-sm text-slate-400' : 'text-base md:text-xl font-black italic text-red-300'}`}
          >
            {r.w30}
          </p>
          <p
            class={`whitespace-nowrap text-right tabular-nums ${r.isRef ? 'text-sm text-slate-400' : 'text-base md:text-xl font-black italic text-red-300'}`}
          >
            {r.w40}
          </p>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-xs italic text-slate-400 leading-relaxed">{t(dict, 'cda.values.wattsNote')}</p>
</div>
