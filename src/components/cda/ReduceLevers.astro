---
// Les 6 leviers pour réduire sa surface frontale (/cda) : dessin, levier,
// pourquoi la surface baisse. Dessins : illustration générée, recadrée sans son
// texte et recolorée en orange AeroX (src/assets/images/cda/reduce/lever-{n}.webp).
import type { ImageMetadata } from 'astro';
import { t } from '~/lib/i18n';

interface Props {
  dict: Record<string, string>;
}
const { dict } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('~/assets/images/cda/reduce/*.webp', { eager: true });
const image = (n: number) => {
  const entry = Object.entries(files).find(([path]) => path.endsWith(`/lever-${n}.webp`));
  if (!entry) throw new Error(`Illustration manquante : lever-${n}.webp`);
  return entry[1].default;
};
const levers = [1, 2, 3, 4, 5, 6].map((n) => ({
  n,
  img: image(n),
  title: t(dict, `cda.reduce.item${n}`).replace(/[.。]$/, ''),
  why: t(dict, `cda.reduce.why${n}`),
}));
---

<ol class="not-prose my-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    levers.map((l) => (
      <li class="flex flex-col overflow-hidden rounded-xl border border-primary/30 bg-slate-950/50 shadow-[0_0_14px_rgba(251,165,47,0.1)]">
        <div class="relative flex h-28 items-center justify-center bg-[#08111f]">
          <img
            src={l.img.src}
            width={l.img.width}
            height={l.img.height}
            alt=""
            loading="lazy"
            class="h-full w-auto max-w-full object-contain"
          />
          <span class="absolute left-2 top-2 flex h-7 w-7 items-center justify-center rounded-full border border-primary bg-slate-950/80 text-sm font-bold text-primary">
            {l.n}
          </span>
        </div>
        <div class="p-3">
          <p class="text-sm font-bold leading-snug text-white">{l.title}</p>
          <p class="mt-1 text-sm leading-snug text-slate-300">{l.why}</p>
        </div>
      </li>
    ))
  }
</ol>
