---
// Tableau « valeurs typiques de CdA par position » de /cda : vue de face,
// définition de la position, CdA (fourchette courante) et surface frontale A
// mesurée. Les watts perdus ont leur propre tableau (LostWattsTable).
import { t } from '~/lib/i18n';
import { CDA_POSITIONS } from '~/lib/cdaPositions';
import { positionImage } from '~/lib/cdaPositionImages';

interface Props {
  dict: Record<string, string>;
  lang: string;
}
const { dict, lang } = Astro.props;

const fmt = (n: number) => new Intl.NumberFormat(lang, { minimumFractionDigits: 2 }).format(n);
const rows = CDA_POSITIONS.map((r) => ({
  n: r.n,
  // Titre de ligne = définition précise de la position (les libellés courts
  // cda.values.*.label servent au calculateur).
  label: t(dict, `cda.values.${r.key}.desc`),
  cda: t(dict, `cda.values.${r.key}.value`),
  area: `${'approx' in r && r.approx ? '≈ ' : ''}${fmt(r.area)}`,
  face: positionImage(r.n),
}));
const cols = 'grid-cols-[4.5rem_1fr] sm:grid-cols-[4.5rem_1fr_6.5rem_4rem]';
---

<div class="not-prose my-8">
  <div
    class={`hidden sm:grid ${cols} gap-3 items-end rounded-t-xl border border-primary/40 bg-slate-950/60 px-1.5 py-2.5 text-sm font-bold uppercase tracking-wide text-primary`}
  >
    <span class="text-center">{t(dict, 'cda.values.headerFront')}</span>
    <span>{t(dict, 'cda.values.header1')}</span>
    <span class="text-right">{t(dict, 'cda.values.header2')}</span>
    <span class="pr-1.5 text-right">{t(dict, 'cda.values.header3')}</span>
  </div>
  <ol class="mt-2 space-y-2">
    {
      rows.map((r) => (
        <li
          class={`grid ${cols} items-center gap-x-3 gap-y-1 rounded-xl border border-primary/30 bg-slate-950/50 p-1.5 pr-3 shadow-[0_0_14px_rgba(251,165,47,0.1)]`}
        >
          <img
            src={r.face.src}
            width={r.face.width}
            height={r.face.height}
            alt=""
            loading="lazy"
            class="row-span-3 sm:row-span-1 h-[5.25rem] w-[4.5rem] rounded-lg object-cover"
          />
          <p class="text-sm font-semibold leading-snug text-white">
            <span class="mr-1 text-primary">{r.n}.</span>
            {r.label}
          </p>
          <p class="flex items-baseline gap-2 sm:block sm:text-right">
            <span class="sm:hidden text-xs font-bold uppercase text-slate-400">{t(dict, 'cda.values.header2')}</span>
            <span class="whitespace-nowrap text-lg font-black italic text-primary tabular-nums">{r.cda}</span>
          </p>
          <p class="flex items-baseline gap-2 sm:block sm:text-right">
            <span class="sm:hidden text-xs font-bold uppercase text-slate-400">{t(dict, 'cda.values.header3')}</span>
            <span class="whitespace-nowrap text-lg font-black italic text-white tabular-nums">{r.area}</span>
          </p>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-xs italic text-slate-400 leading-relaxed">{t(dict, 'cda.values.note')}</p>
</div>
