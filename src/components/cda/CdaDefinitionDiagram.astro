---
// Schéma « CdA = Cd × A » (/cda, définition) : Cd = la forme (deux
// écoulements à surface égale), A = la surface vue de face (ce que mesure
// AeroX). Dessins repris d'une illustration générée, recadrés sans leur texte
// et recolorés en orange ; légendes en HTML pour les 9 langues.
import { t } from '~/lib/i18n';
import cdHigh from '~/assets/images/cda/definition/cd-high.webp';
import cdLow from '~/assets/images/cda/definition/cd-low.webp';
import areaFront from '~/assets/images/cda/definition/area-front.webp';

interface Props {
  dict: Record<string, string>;
}
const { dict } = Astro.props;
const card = 'rounded-xl border border-primary/30 bg-slate-950/50 p-3 shadow-[0_0_14px_rgba(251,165,47,0.1)]';
---

<figure class="not-prose my-8">
  <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
    <div class={card}>
      <p class="font-bold text-white">{t(dict, 'cda.def.cd.title')}</p>
      <div class="mt-2 grid grid-cols-2 gap-2">
        {
          [
            { img: cdHigh, label: t(dict, 'cda.def.cd.high') },
            { img: cdLow, label: t(dict, 'cda.def.cd.low') },
          ].map((c) => (
            <div>
              <img
                src={c.img.src}
                width={c.img.width}
                height={c.img.height}
                alt=""
                loading="lazy"
                class="w-full h-auto rounded-lg"
              />
              <p class="mt-1 text-xs font-semibold text-primary">{c.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-2 text-sm leading-snug text-slate-300">{t(dict, 'cda.def.cd.caption')}</p>
    </div>
    <div class={`${card} sm:w-56`}>
      <p class="font-bold text-white">{t(dict, 'cda.def.a.title')}</p>
      <img
        src={areaFront.src}
        width={areaFront.width}
        height={areaFront.height}
        alt=""
        loading="lazy"
        class="mx-auto mt-2 h-36 w-auto rounded-lg"
      />
      <p class="mt-2 text-sm leading-snug text-slate-300">{t(dict, 'cda.def.a.caption')}</p>
    </div>
  </div>

  <!-- Formule -->
  <figcaption
    class="mt-3 flex flex-wrap items-start justify-center gap-x-4 gap-y-2 rounded-xl border border-primary/40 bg-slate-950/70 px-4 py-3 text-center"
  >
    {
      [
        { sym: 'Cd', label: t(dict, 'cda.def.f.cd') },
        { op: '×' },
        { sym: 'A', label: t(dict, 'cda.def.f.a') },
        { op: '=' },
        { sym: 'CdA', label: t(dict, 'cda.def.f.cda'), strong: true },
      ].map((p) =>
        'op' in p ? (
          <span class="pt-0.5 text-2xl font-black text-slate-400">{p.op}</span>
        ) : (
          <span class="flex flex-col items-center">
            <span class={`text-2xl font-black italic ${p.strong ? 'text-primary' : 'text-white'}`}>{p.sym}</span>
            <span class="text-xs text-slate-400">{p.label}</span>
          </span>
        )
      )
    }
  </figcaption>
</figure>
