---
// Candidatures influenceurs AeroX (décision du 2026-11-03).
//
// Page accessible depuis Instagram seulement : aucun lien depuis le site,
// exclue du sitemap (astro.config.ts) et non indexée. Elle renvoie en
// revanche vers le site (header, footer, lien « Découvrir AeroX »).
//
// Présentation façon hero de l'accueil (texte + Reel vertical), puis le
// formulaire : inscription MailerLite (groupe global de la langue + groupe
// « Influenceurs Insta ») via /api/lead/ (topic `influencer`), avec le compte
// Instagram, les abonnés et de quoi trier les profils.
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import { SUPPORTED_LOCALES, type Locale, getDict, t } from '~/lib/i18n';
import { INFLUENCER_DISCIPLINES } from '~/lib/leadValidation';
import reel from '~/assets/videos/aerox_influencer_reel.mp4';
import posterSrc from '~/assets/images/influencer_poster.jpg';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);
const poster = (await getImage({ src: posterSrc, width: 400, format: 'webp' })).src;

const metadata = {
  title: t(dict, 'influencer.meta.title'),
  description: t(dict, 'influencer.meta.description'),
  robots: { index: false, follow: true },
};

const points = [1, 2, 3].map((i) => t(dict, `influencer.hero.point${i}`));
const steps = [1, 2, 3].map((i) => ({
  i,
  title: t(dict, `influencer.how.s${i}.title`),
  desc: t(dict, `influencer.how.s${i}.desc`),
}));
const inputClass =
  'w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 p-3 text-default focus:border-primary focus:outline-none';
const labelClass = 'flex flex-col gap-1.5 text-sm font-semibold';
const cardClass = 'rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/60 p-5 md:p-6';
const legendClass = 'flex items-center gap-2 px-1 text-base font-bold';
const stepBadge = 'flex h-7 w-7 items-center justify-center rounded-full bg-primary text-sm font-bold text-white';
const optClass = 'ml-1 font-normal text-muted';
const errClass = 'field-err hidden text-xs font-semibold text-red-500';
const chipClass =
  'inline-block rounded-full border border-gray-300 dark:border-slate-600 px-4 py-2 text-sm font-semibold transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-[#0b2239] peer-focus-visible:ring-2 peer-focus-visible:ring-primary';
---

<Layout metadata={metadata}>
  {/* Page d'atterrissage Instagram : ni bandeau ni header, seul le lien « Découvrir AeroX » mène au site. */}
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header"></Fragment>
  <!-- Hero : présentation d'AeroX et le Reel -->
  <section class="not-prose relative overflow-hidden">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:px-6 py-10 md:py-16 md:grid-cols-[minmax(0,1fr)_minmax(0,16rem)]"
    >
      <div>
        <p class="text-lg md:text-xl font-bold uppercase tracking-wide text-primary">
          {t(dict, 'influencer.hero.eyebrow')}
        </p>
        <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tight">{t(dict, 'influencer.hero.title')}</h1>
        <p class="mt-5 text-lg text-muted">{t(dict, 'influencer.hero.subtitle')}</p>
        <ul class="mt-6 space-y-3">
          {
            points.map((p) => (
              <li class="flex items-start gap-3">
                <Icon name="tabler:circle-check" class="mt-0.5 h-6 w-6 shrink-0 text-primary" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#candidature" class="btn-primary px-8 py-3 text-lg font-semibold">
            {t(dict, 'influencer.hero.cta')}
          </a>
          <a href={`/${lang}/`} class="font-semibold text-primary underline hover:no-underline">
            {t(dict, 'influencer.hero.site')}
          </a>
        </div>

        <!-- Option légère : être prévenu de la sortie (groupes MailerLite de la sortie). -->
        <form
          id="influencer-notify"
          class="mt-8 max-w-md"
          novalidate
          data-lang={lang}
          data-success={t(dict, 'influencer.notify.success')}
          data-error={t(dict, 'influencer.notify.error')}
        >
          <label for="influencer-notify-email" class="text-sm font-semibold">
            {t(dict, 'influencer.notify.title')}
          </label>
          <div class="mt-2 flex gap-2">
            <input
              id="influencer-notify-email"
              type="email"
              name="email"
              required
              maxlength="200"
              autocomplete="email"
              placeholder={t(dict, 'influencer.notify.placeholder')}
              class="min-w-0 flex-1 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 text-default focus:border-primary focus:outline-none"
            />
            <button type="submit" class="btn-secondary shrink-0 px-4 py-2 font-semibold">
              {t(dict, 'influencer.notify.cta')}
            </button>
          </div>
          <input
            type="text"
            name="hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="absolute left-[-9999px] w-px h-px opacity-0"
          />
          <p class="notify-msg mt-2 hidden text-sm font-semibold" role="status"></p>
        </form>
      </div>

      <figure class="relative mx-auto w-full max-w-[16rem]">
        <video
          id="influencer-reel"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
          class="aspect-[9/16] w-full rounded-2xl bg-slate-900 object-cover shadow-2xl"
          aria-label={t(dict, 'influencer.video.aria')}
        >
          <source src={reel} type="video/mp4" />
        </video>
        <button
          type="button"
          id="influencer-sound"
          class="absolute bottom-3 right-3 inline-flex items-center gap-2 rounded-full bg-black/60 px-3 py-1.5 text-sm font-semibold text-white backdrop-blur hover:bg-black/75"
          data-on={t(dict, 'influencer.video.soundOn')}
          data-off={t(dict, 'influencer.video.soundOff')}
          aria-pressed="false"
        >
          <Icon name="tabler:volume-off" class="sound-off h-5 w-5" />
          <Icon name="tabler:volume" class="sound-on hidden h-5 w-5" />
          <span class="sound-label">{t(dict, 'influencer.video.soundOn')}</span>
        </button>
      </figure>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="not-prose bg-gray-50 dark:bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-4 md:px-6 py-12 md:py-16">
      <h2 class="text-center text-2xl md:text-3xl font-bold">{t(dict, 'influencer.how.title')}</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="rounded-xl bg-white dark:bg-slate-900 p-6 shadow">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary font-bold text-white">
                {s.i}
              </span>
              <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
              <p class="mt-2 text-muted">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Candidature : 3 blocs courts, champs obligatoires sans astérisque, facultatifs signalés. -->
  <section id="candidature" class="not-prose scroll-mt-[72px]">
    <div class="mx-auto max-w-2xl px-4 md:px-6 py-12 md:py-16">
      <h2 class="text-center text-2xl md:text-3xl font-bold">{t(dict, 'influencer.form.title')}</h2>
      <p class="mt-3 text-center text-muted">{t(dict, 'influencer.form.subtitle')}</p>

      <form
        id="influencer-form"
        class="mt-8 space-y-6"
        novalidate
        data-lang={lang}
        data-sending={t(dict, 'influencer.form.sending')}
        data-error={t(dict, 'influencer.form.error')}
        data-err-name={t(dict, 'influencer.form.errName')}
        data-err-email={t(dict, 'influencer.form.errEmail')}
        data-err-instagram={t(dict, 'influencer.form.errInstagram')}
        data-err-followers={t(dict, 'influencer.form.errFollowers')}
        data-err-discipline={t(dict, 'influencer.form.errDiscipline')}
      >
        <!-- 1. Toi -->
        <fieldset class={cardClass}>
          <legend class={legendClass}>
            <span class={stepBadge}>1</span>
            {t(dict, 'influencer.form.step1')}
          </legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class={labelClass}>
              {t(dict, 'influencer.form.name')}
              <input type="text" name="name" maxlength="120" autocomplete="name" class={inputClass} />
              <span class={errClass} data-err-for="name"></span>
            </label>
            <label class={labelClass}>
              {t(dict, 'influencer.form.email')}
              <input type="email" name="email" maxlength="200" autocomplete="email" class={inputClass} />
              <span class={errClass} data-err-for="email"></span>
            </label>
          </div>
        </fieldset>

        <!-- 2. Compte Instagram -->
        <fieldset class={cardClass}>
          <legend class={legendClass}>
            <span class={stepBadge}>2</span>
            {t(dict, 'influencer.form.step2')}
          </legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class={`${labelClass} sm:col-span-2`}>
              {t(dict, 'influencer.form.instagram')}
              <span class="relative flex items-center">
                <span class="pointer-events-none absolute left-3 text-muted">@</span>
                <input
                  type="text"
                  name="instagram"
                  maxlength="200"
                  autocapitalize="off"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder={t(dict, 'influencer.form.instagramPh')}
                  class={`${inputClass} pl-8 pr-10`}
                />
                <Icon
                  name="tabler:circle-check-filled"
                  class="insta-ok absolute right-3 hidden h-5 w-5 text-green-500"
                />
              </span>
              <a
                class="insta-preview hidden text-xs font-normal text-primary underline"
                target="_blank"
                rel="noopener"
                href="#"></a>
              <span class={errClass} data-err-for="instagram"></span>
            </label>
            <label class={labelClass}>
              {t(dict, 'influencer.form.followers')}
              <input type="number" name="followers" min="0" step="1" inputmode="numeric" class={inputClass} />
              <span class={errClass} data-err-for="followers"></span>
            </label>
            <label class={labelClass}>
              <span>
                {t(dict, 'influencer.form.avgViews')}
                <span class={optClass}>({t(dict, 'influencer.form.optional')})</span>
              </span>
              <input type="number" name="avgViews" min="0" step="1" inputmode="numeric" class={inputClass} />
              <span class="text-xs font-normal text-muted">{t(dict, 'influencer.form.avgViewsHint')}</span>
            </label>
          </div>
        </fieldset>

        <!-- 3. Profil -->
        <fieldset class={cardClass}>
          <legend class={legendClass}>
            <span class={stepBadge}>3</span>
            {t(dict, 'influencer.form.step3')}
          </legend>
          <div class="space-y-5">
            <div>
              <p class="text-sm font-semibold">{t(dict, 'influencer.form.discipline')}</p>
              <div class="mt-2 flex flex-wrap gap-2" role="radiogroup">
                {
                  INFLUENCER_DISCIPLINES.map((d) => (
                    <label class="cursor-pointer">
                      <input type="radio" name="discipline" value={d} class="peer sr-only" />
                      <span class={chipClass}>{t(dict, `influencer.discipline.${d}`)}</span>
                    </label>
                  ))
                }
              </div>
              <span class={errClass} data-err-for="discipline"></span>
            </div>

            <div>
              <p class="text-sm font-semibold">
                {t(dict, 'influencer.form.trainer')}
                <span class={optClass}>({t(dict, 'influencer.form.optional')})</span>
              </p>
              <div class="mt-2 flex gap-2" role="radiogroup">
                <label class="cursor-pointer">
                  <input type="radio" name="trainer" value="oui" class="peer sr-only" />
                  <span class={chipClass}>{t(dict, 'influencer.form.yes')}</span>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="trainer" value="non" class="peer sr-only" />
                  <span class={chipClass}>{t(dict, 'influencer.form.no')}</span>
                </label>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class={labelClass}>
                <span>
                  {t(dict, 'influencer.form.country')}
                  <span class={optClass}>({t(dict, 'influencer.form.optional')})</span>
                </span>
                <input type="text" name="country" maxlength="100" autocomplete="country-name" class={inputClass} />
              </label>
              <label class={labelClass}>
                <span>
                  {t(dict, 'influencer.form.otherLink')}
                  <span class={optClass}>({t(dict, 'influencer.form.optional')})</span>
                </span>
                <input
                  type="text"
                  name="otherLink"
                  maxlength="300"
                  placeholder={t(dict, 'influencer.form.otherLinkPh')}
                  class={inputClass}
                />
              </label>
            </div>

            <label class={labelClass}>
              <span>
                {t(dict, 'influencer.form.message')}
                <span class={optClass}>({t(dict, 'influencer.form.optional')})</span>
              </span>
              <textarea name="message" rows="3" maxlength="2000" class={inputClass}></textarea>
            </label>
          </div>
        </fieldset>

        {/* Honeypot : invisible pour l'humain, rempli par les bots. */}
        <input
          type="text"
          name="hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute left-[-9999px] w-px h-px opacity-0"
        />

        <button type="submit" class="btn-primary w-full px-8 py-3 text-lg font-semibold">
          {t(dict, 'influencer.form.submit')}
        </button>
        <p class="text-center text-xs text-muted">{t(dict, 'influencer.form.consent')}</p>
        <p class="influencer-msg hidden text-center font-semibold text-red-600" role="alert"></p>
      </form>

      <!-- Après l'envoi : remerciement à la place du formulaire. -->
      <div
        id="influencer-done"
        class="mt-8 hidden rounded-2xl border border-green-500/40 bg-green-500/10 p-8 text-center"
        role="status"
        tabindex="-1"
      >
        <Icon name="tabler:circle-check-filled" class="mx-auto h-12 w-12 text-green-500" />
        <h3 class="mt-4 text-2xl font-bold">{t(dict, 'influencer.form.successTitle')}</h3>
        <p class="mt-2 text-muted">{t(dict, 'influencer.form.success')}</p>
        <a href={`/${lang}/`} class="mt-6 inline-block font-semibold text-primary underline hover:no-underline">
          {t(dict, 'influencer.hero.site')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Attache idempotente : premier rendu + navigations ClientRouter.
  function initInfluencerPage() {
    const video = document.getElementById('influencer-reel') as HTMLVideoElement | null;
    const sound = document.getElementById('influencer-sound') as HTMLButtonElement | null;
    if (video && sound && sound.dataset.bound !== '1') {
      sound.dataset.bound = '1';
      sound.addEventListener('click', () => {
        video.muted = !video.muted;
        if (!video.muted) video.play().catch(() => {});
        sound.setAttribute('aria-pressed', String(!video.muted));
        sound.querySelector('.sound-off')?.classList.toggle('hidden', !video.muted);
        sound.querySelector('.sound-on')?.classList.toggle('hidden', video.muted);
        const label = sound.querySelector('.sound-label');
        if (label) label.textContent = (video.muted ? sound.dataset.on : sound.dataset.off) ?? '';
      });
    }

    const notify = document.getElementById('influencer-notify') as HTMLFormElement | null;
    if (notify && notify.dataset.bound !== '1') {
      notify.dataset.bound = '1';
      const nmsg = notify.querySelector<HTMLParagraphElement>('.notify-msg');
      const nbtn = notify.querySelector<HTMLButtonElement>('button[type="submit"]');
      notify.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(notify);
        const email = String(data.get('email') ?? '').trim();
        if (!email) return;
        if (nbtn) nbtn.disabled = true;
        let ok = false;
        try {
          const res = await fetch('/api/release-notify/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, lang: notify.dataset.lang, hp: String(data.get('hp') ?? '') }),
          });
          ok = res.ok && (await res.json().catch(() => ({})))?.success === true;
        } catch {
          ok = false;
        }
        if (nmsg) {
          nmsg.textContent = (ok ? notify.dataset.success : notify.dataset.error) ?? '';
          nmsg.classList.remove('hidden', 'text-red-600', 'text-green-600');
          nmsg.classList.add(ok ? 'text-green-600' : 'text-red-600');
        }
        if (ok) notify.reset();
        if (nbtn) nbtn.disabled = false;
      });
    }

    const form = document.getElementById('influencer-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    const done = document.getElementById('influencer-done');
    const msg = form.querySelector<HTMLParagraphElement>('.influencer-msg');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const initialLabel = button?.textContent ?? '';
    const ds = form.dataset;

    // Même règle que le serveur (parseInstagram) : @pseudo, pseudo ou lien du profil.
    const instaHandle = (raw: string) => {
      const v = raw.trim();
      const m = v.match(/^(?:https?:\/\/)?(?:www\.|m\.)?instagram\.com\/([A-Za-z0-9._]{1,30})\/?(?:[?#].*)?$/i);
      const h = (m ? m[1] : v.replace(/^@/, '')).toLowerCase();
      if (!/^[a-z0-9._]{1,30}$/.test(h) || /^\.|\.$/.test(h)) return null;
      return ['p', 'reel', 'reels', 'stories', 'explore', 'accounts'].includes(h) ? null : h;
    };
    const emailOk = (v: string) => /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(v.trim());

    const setErr = (field: string, text: string) => {
      const el = form.querySelector<HTMLElement>(`[data-err-for="${field}"]`);
      if (!el) return;
      el.textContent = text;
      el.classList.toggle('hidden', !text);
      form
        .querySelectorAll<HTMLInputElement>(`[name="${field}"]`)
        .forEach((i) => i.setAttribute('aria-invalid', text ? 'true' : 'false'));
    };
    // Une erreur s'efface dès que le champ est corrigé.
    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (name) setErr(name, '');
    });
    form.addEventListener('change', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (name) setErr(name, '');
    });

    // Compte Instagram : coche verte et lien du profil pour vérifier.
    const insta = form.querySelector<HTMLInputElement>('input[name="instagram"]');
    const instaOk = form.querySelector<SVGElement>('.insta-ok');
    const instaPreview = form.querySelector<HTMLAnchorElement>('.insta-preview');
    insta?.addEventListener('input', () => {
      const h = insta.value.trim() ? instaHandle(insta.value) : null;
      instaOk?.classList.toggle('hidden', !h);
      if (instaPreview) {
        instaPreview.classList.toggle('hidden', !h);
        if (h) {
          instaPreview.href = `https://www.instagram.com/${h}/`;
          instaPreview.textContent = `instagram.com/${h}`;
        }
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!button) return;
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      msg?.classList.add('hidden');

      // Vérifications avant envoi, message sous chaque champ concerné.
      const errors: [string, string][] = [];
      if (!get('name')) errors.push(['name', ds.errName ?? '']);
      if (!emailOk(get('email'))) errors.push(['email', ds.errEmail ?? '']);
      if (!instaHandle(get('instagram'))) errors.push(['instagram', ds.errInstagram ?? '']);
      if (!/^\d+$/.test(get('followers'))) errors.push(['followers', ds.errFollowers ?? '']);
      if (!get('discipline')) errors.push(['discipline', ds.errDiscipline ?? '']);
      errors.forEach(([f, text]) => setErr(f, text));
      if (errors.length) {
        form.querySelector<HTMLElement>(`[name="${errors[0][0]}"]`)?.focus();
        return;
      }

      button.disabled = true;
      button.textContent = ds.sending ?? '…';
      const trainer = get('trainer');
      const payload = {
        topic: 'influencer',
        name: get('name'),
        email: get('email'),
        instagram: get('instagram'),
        followers: get('followers'),
        avgViews: get('avgViews'),
        discipline: get('discipline'),
        country: get('country'),
        otherLink: get('otherLink'),
        trainer: trainer === 'oui' ? 'Oui' : trainer === 'non' ? 'Non' : '',
        message: get('message'),
        hp: get('hp'),
      };

      let ok = false;
      let error = '';
      try {
        const res = await fetch(`/${ds.lang ?? 'fr'}/api/lead/`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({}));
        ok = res.ok && body?.success === true;
        error = typeof body?.error === 'string' ? body.error : '';
      } catch {
        ok = false;
      }
      button.textContent = initialLabel;
      button.disabled = false;

      if (ok) {
        form.classList.add('hidden');
        done?.classList.remove('hidden');
        done?.focus();
        done?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      if (error === 'invalid_instagram') return setErr('instagram', ds.errInstagram ?? '');
      if (error === 'invalid_followers') return setErr('followers', ds.errFollowers ?? '');
      if (error === 'invalid_email') return setErr('email', ds.errEmail ?? '');
      if (msg) {
        msg.textContent = ds.error ?? '';
        msg.classList.remove('hidden');
      }
    });
  }

  initInfluencerPage();
  document.addEventListener('astro:page-load', initInfluencerPage);
</script>
