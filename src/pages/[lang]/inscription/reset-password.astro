---
// Mot de passe oublié, en deux étapes, comme dans l'application desktop :
//  1. l'e-mail -> `resetPasswordForEmail` : Supabase envoie un code à 6
//     chiffres (gabarit « Reset Your Password », annoncé valable 10 min) ;
//  2. le code + le nouveau mot de passe -> `verifyOtp` (type recovery) ouvre
//     une session, puis `updateUser` enregistre le mot de passe.
// Aucun lien de redirection : le même code sert au site et à l'application.
import Button from '~/components/ui/Button.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getDict, t } from '~/lib/i18n';

const { lang } = Astro.params;
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'reset.meta.title'),
  description: t(dict, 'reset.meta.description'),
  robots: { index: false, follow: false },
};
const input = 'border rounded p-3 text-secondary';
---

<Layout metadata={metadata}>
  <section class="max-w-md mx-auto py-16 px-6 text-center">
    <h1 class="text-3xl font-bold mb-6 text-primary">{t(dict, 'reset.title')}</h1>

    <div
      id="reset"
      data-lang={lang}
      data-sent={t(dict, 'reset.sent')}
      data-missing={t(dict, 'reset.missing')}
      data-mismatch={t(dict, 'reset.mismatch')}
      data-weak={t(dict, 'reset.weak')}
      data-bad-code={t(dict, 'reset.badCode')}
      data-error={t(dict, 'reset.error')}
      data-done={t(dict, 'reset.done')}
    >
      <!-- Étape 1 : l'e-mail -->
      <form id="reset-request" class="flex flex-col gap-4 text-left">
        <p class="text-center text-black dark:text-white">{t(dict, 'reset.step1')}</p>
        <label for="reset-email" class="font-medium">{t(dict, 'login.email.label')}</label>
        <input
          type="email"
          id="reset-email"
          autocomplete="email"
          placeholder={t(dict, 'login.email.placeholder')}
          required
          class={input}
        />
        <Button variant="primary" type="submit" text={t(dict, 'reset.send')} class="mt-4 w-full justify-center" />
      </form>

      <!-- Étape 2 : le code reçu + le nouveau mot de passe -->
      <form id="reset-confirm" class="hidden flex flex-col gap-4 text-left">
        <p class="text-center text-black dark:text-white" id="reset-step2"></p>
        <label for="reset-code" class="font-medium">{t(dict, 'reset.code')}</label>
        <input
          type="text"
          id="reset-code"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          placeholder="123456"
          required
          class={`${input} tracking-[0.4em] text-center text-lg`}
        />
        <label for="reset-password" class="font-medium">{t(dict, 'reset.newPassword')}</label>
        <input type="password" id="reset-password" autocomplete="new-password" minlength="8" required class={input} />
        <p class="-mt-2 text-xs text-gray-600 dark:text-gray-300">{t(dict, 'reset.rules')}</p>
        <label for="reset-password2" class="font-medium">{t(dict, 'reset.confirm')}</label>
        <input type="password" id="reset-password2" autocomplete="new-password" minlength="8" required class={input} />
        <Button variant="primary" type="submit" text={t(dict, 'reset.save')} class="mt-4 w-full justify-center" />
        <button type="button" id="reset-again" class="text-sm underline text-primary hover:text-primary/80">
          {t(dict, 'reset.again')}
        </button>
      </form>
    </div>

    <p id="reset-message" class="mt-6 text-sm" role="status" aria-live="polite"></p>

    <p class="mt-6 text-sm">
      <a href={`/${lang}/inscription/connexion/`} class="underline text-primary hover:text-primary/80">
        {t(dict, 'reset.back')}
      </a>
    </p>
  </section>

  <script>
    import { supabase } from '~/config/supabaseClient';

    // Même schéma d'attache que la page de connexion (premier rendu +
    // navigations ClientRouter, sans double liaison).
    function initReset() {
      const root = document.getElementById('reset');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';
      const d = root.dataset;
      const lang = d.lang || 'fr';

      const request = document.getElementById('reset-request') as HTMLFormElement;
      const confirm = document.getElementById('reset-confirm') as HTMLFormElement;
      const message = document.getElementById('reset-message');
      const step2 = document.getElementById('reset-step2');
      const emailEl = document.getElementById('reset-email') as HTMLInputElement;
      const codeEl = document.getElementById('reset-code') as HTMLInputElement;
      const pwEl = document.getElementById('reset-password') as HTMLInputElement;
      const pw2El = document.getElementById('reset-password2') as HTMLInputElement;
      let email = '';

      const show = (text = '', isError = true) => {
        if (!message) return;
        message.textContent = text;
        message.classList.remove('text-red-600', 'text-green-600');
        if (text) message.classList.add(isError ? 'text-red-600' : 'text-green-600');
      };
      const busy = (form: HTMLFormElement, on: boolean) =>
        form.querySelectorAll('button').forEach((b) => (b.disabled = on));

      // Lien direct avec l'adresse (?email=) : champ prérempli.
      const preset = new URLSearchParams(location.search).get('email');
      if (preset) emailEl.value = preset;

      request.addEventListener('submit', async (e) => {
        e.preventDefault();
        email = emailEl.value.trim();
        if (!email) return show('❌ ' + d.missing);
        busy(request, true);
        const { error } = await supabase.auth.resetPasswordForEmail(email);
        busy(request, false);
        if (error) return show('❌ ' + (d.error ?? error.message));
        show();
        if (step2) step2.textContent = (d.sent ?? '').replace('{email}', email);
        request.classList.add('hidden');
        confirm.classList.remove('hidden');
        codeEl.focus();
      });

      document.getElementById('reset-again')?.addEventListener('click', () => {
        confirm.classList.add('hidden');
        request.classList.remove('hidden');
        show();
      });

      confirm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = codeEl.value.replace(/\D/g, '');
        const password = pwEl.value;
        if (token.length !== 6 || !password) return show('❌ ' + d.missing);
        if (password !== pw2El.value) return show('❌ ' + d.mismatch);
        // Mêmes règles que Supabase : 8 caractères, minuscule, majuscule, chiffre.
        if (password.length < 8 || !/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/\d/.test(password)) {
          return show('❌ ' + d.weak);
        }
        busy(confirm, true);
        const { error: otpError } = await supabase.auth.verifyOtp({ email, token, type: 'recovery' });
        if (otpError) {
          busy(confirm, false);
          return show('❌ ' + d.badCode);
        }
        const { error } = await supabase.auth.updateUser({ password });
        busy(confirm, false);
        if (error) return show('❌ ' + (error.code === 'weak_password' ? d.weak : (d.error ?? error.message)));
        show('✅ ' + d.done, false);
        // Session ouverte par le code : direction l'espace compte.
        setTimeout(() => (location.href = `/${lang}/inscription/dashboard/`), 1500);
      });
    }

    initReset();
    document.addEventListener('astro:page-load', initReset);
  </script>
</Layout>
