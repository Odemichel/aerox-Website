---
// Espace compte (bike fitter ou cycliste), organisé comme une page de
// paramètres de compte pro : en-tête au nom du studio, navigation par
// sections (Abonnement, Activité, Utilisation, Facturation, Studio, Compte), lignes
// « libellé → valeur → action ». Tout le contenu dépend de la session :
// le squelette est rendu ici, le script le remplit.
import PricingSection from '~/components/widgets/PricingSection.astro';
import BfPricing from '~/components/widgets/BfPricing.astro';

import Layout from '../../../layouts/PageLayout.astro';
import { getDict, t, type Locale } from '~/lib/i18n';
import { DOWNLOADS } from '~/config/downloads';
// QR code de l'application mobile (webapp companion), généré une fois en SVG
// statique : même cible que le QR affiché par l'application desktop.
import companionQr from '~/assets/images/companion-qr.svg?raw';

const COMPANION_URL = 'https://mycompanion.aeroxbefaster.com';

const { lang } = Astro.params;
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'dashboard.meta.title'),
  description: t(dict, 'dashboard.meta.description'),
};

// Tous les libellés lus par le script client, par préfixe.
const pick = (prefix: string, keys: string[]) => Object.fromEntries(keys.map((k) => [k, t(dict, `${prefix}${k}`)]));
const labels = {
  ...pick('dash.acct.', ['role.bike-fitter', 'role.pending_bf', 'role.rider', 'role.admin']),
  ...pick('dash.bf.', [
    'plan.payg',
    'plan.unlimited_annual',
    'plan.studio',
    'plan.unlimited',
    'plan.unlimited_launch',
    'plan.unlimited_launch_annual',
    'plan.legacy',
    'status.active',
    'status.pastDue',
    'status.canceling',
    'pastDue',
    'readOnly',
    'meter.included',
    'meter.over',
    'meter.period',
    'analyses',
    'nextInvoiceOn',
    'portal',
    'changeOffer',
    'when.now',
    'when.later',
    'choose',
    'price.analysis',
    'price.month',
    'price.year',
    'changeLater',
    'cancel',
    'cancelConfirm',
    'cancelDone',
    'cancelScheduled',
    'resume',
    'resumeDone',
    'changeScheduled',
    'keep',
    'keepDone',
    'changeConfirmUp',
    'changeConfirmDown',
    'leaveLaunch',
    'changeDone',
    'updating',
    'debt',
    'payDebt',
    'success',
    'error',
    'onboarding',
    'biz.label',
    'biz.placeholder',
    'biz.cta',
    'biz.granted',
    'biz.pending',
    'biz.used',
    'biz.invalid',
    'biz.notFound',
    'biz.inactive',
    'biz.registryDown',
    'biz.unreachable',
  ]),
  // Groupes lus avec leur préfixe (T['trial.name'], T['plan.current']…).
  ...pick('dash.', [
    ...['unlock.title', 'unlock.text', 'name', 'left', 'until', 'ended', 'endedText', 'choose', 'pending'].map(
      (k) => `trial.${k}`
    ),
    ...['current', 'price', 'nextDate', 'noSub'].map((k) => `plan.${k}`),
    ...['estimate', 'manage', 'manageText', 'none', 'debtRow'].map((k) => `billing.${k}`),
    ...['name', 'id', 'legal', 'none', 'verified', 'pending', 'kind.siren', 'kind.eu_vat'].map((k) => `studio.${k}`),
    ...['email', 'role', 'signout', 'licence'].map((k) => `account.${k}`),
    ...['purchased', 'preorder', 'available', 'consumed', 'refunded', 'empty'].map((k) => `diag.${k}`),
    ...[
      'thisMonth',
      'prevMonth',
      'total',
      'since',
      'riders',
      'newRiders',
      'perMonth',
      'perMonthBar',
      'empty',
      'emptyCta',
      'error',
      'loading',
    ].map((k) => `act.${k}`),
  ]),
  notLogged: t(dict, 'dashboard.notLogged'),
  profileNotFound: t(dict, 'dashboard.profileNotFound'),
  vat: t(dict, 'bfp.vat'),
};

// Sections : [ancre, titre, description, type de compte].
const sections: [string, string, string, 'bf' | 'rider' | 'all'][] = [
  ['abonnement', t(dict, 'dash.nav.plan'), t(dict, 'dash.sec.plan'), 'bf'],
  ['activite', t(dict, 'dash.nav.activity'), t(dict, 'dash.sec.activity'), 'bf'],
  ['utilisation', t(dict, 'dash.nav.usage'), t(dict, 'dash.sec.usage'), 'bf'],
  ['facturation', t(dict, 'dash.nav.billing'), t(dict, 'dash.sec.billing'), 'bf'],
  ['studio', t(dict, 'dash.nav.studio'), t(dict, 'dash.sec.studio'), 'bf'],
  ['diagnostics', t(dict, 'dash.nav.diag'), t(dict, 'dash.sec.diag'), 'rider'],
  ['telechargement', t(dict, 'dash.nav.download'), t(dict, 'dash.sec.download'), 'all'],
  ['compte', t(dict, 'dash.nav.account'), t(dict, 'dash.sec.account'), 'all'],
];
---

<Layout metadata={metadata}>
  <section id="account" class="acct" data-lang={lang} data-labels={JSON.stringify(labels)}>
    <!-- En-tête : le studio (ou l'e-mail d'un cycliste) -->
    <header class="acct-head">
      <span class="acct-avatar" id="acct-avatar" aria-hidden="true"></span>
      <div>
        <h1 id="acct-name">{t(dict, 'dash.acct.title')}</h1>
        <p class="acct-muted" id="acct-sub">{t(dict, 'dashboard.loading')}</p>
      </div>
    </header>

    <!-- Alerte globale (facture impayée, paiement en échec) -->
    <div id="acct-alert" class="hidden"></div>

    <div class="acct-layout">
      <nav class="acct-nav hidden" id="acct-nav" aria-label={t(dict, 'dash.acct.title')}>
        <ul>
          {
            sections.map(([id, title, , who]) => (
              <li data-for={who} class="hidden">
                <a href={`#${id}`}>{title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="acct-sections">
        {
          sections.map(([id, title, desc, who]) => (
            <section id={id} class="acct-section hidden" data-for={who} aria-labelledby={`${id}-title`}>
              <div class="acct-section-head">
                <h2 id={`${id}-title`}>{title}</h2>
                <p class="acct-muted">{desc}</p>
              </div>
              {id === 'telechargement' ? (
                <div class="acct-panel">
                  <dl class="acct-rows">
                    <div class="acct-row">
                      <dt class="acct-row-label">{t(dict, 'dash.download.desktop')}</dt>
                      <dd class="acct-row-value acct-muted">{t(dict, 'dash.download.desktopText')}</dd>
                    </div>
                  </dl>
                  <div class="acct-actions acct-actions--tight">
                    <a class="acct-btn acct-btn--primary" href={DOWNLOADS.mac}>
                      {t(dict, 'dash.download.mac')}
                    </a>
                    <a class="acct-btn" href={DOWNLOADS.windows}>
                      {t(dict, 'dash.download.windows')}
                    </a>
                  </div>
                  <div class="acct-mobile">
                    <div
                      class="acct-qr"
                      role="img"
                      aria-label={t(dict, 'dash.download.qrAlt')}
                      set:html={companionQr}
                    />
                    <div>
                      <h3 class="acct-mobile-title">{t(dict, 'dash.download.mobileTitle')}</h3>
                      <p class="acct-lead" data-for-text="bf">
                        {t(dict, 'dash.download.mobileBf')}
                      </p>
                      <p class="acct-lead hidden" data-for-text="rider">
                        {t(dict, 'dash.download.mobileRider')}
                      </p>
                      <p class="acct-muted acct-small acct-mobile-or">
                        {t(dict, 'dash.download.or')}{' '}
                        <a class="acct-link" href={COMPANION_URL}>
                          {COMPANION_URL.replace('https://', '')}
                        </a>
                      </p>
                    </div>
                  </div>
                </div>
              ) : (
                <div class="acct-panel" data-body />
              )}
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!--
    Offres, selon le compte (affichées par le script) : bike fitter sans
    abonnement → offres BF payables d'ici ; cycliste → Diagnostic. Jamais
    l'une chez l'autre (les routes de paiement refusent aussi le mauvais rôle).
  -->
  <div id="bf-offers" class="hidden">
    <BfPricing lang={lang as Locale} inAccount />
  </div>
  <div id="rider-offers" class="hidden">
    <PricingSection />
  </div>

  <script>
    import { supabase } from '../../../config/supabaseClient';
    import { manageSubscription, openPortal, submitBusinessId } from '~/lib/billing/client';
    import { isDowngrade, nextInvoiceCentsForOffer, type Offer, type Plan } from '~/lib/billing/logic';
    import { LAUNCH_OFFER } from '~/lib/billing/catalog';
    import { isDiagnosticAvailable } from '~/config/diagnostic';
    import { countInMonth, monthlyCounts } from '~/lib/account/activity';

    type Business = {
      kind: 'siren' | 'eu_vat' | 'website' | 'other';
      id: string;
      country: string | null;
      legal_name: string | null;
      website: string | null;
      status: 'verified' | 'pending_review';
    };
    type Summary = {
      plan: Plan | null;
      offer: Offer | null;
      trial_state:
        | 'needs_business_id'
        | 'pending_review'
        | 'business_id_used'
        | 'granted'
        | 'needs_card'
        | 'card_already_used'
        | null;
      trial_ends_at: string | null;
      status: string | null;
      access: 'full' | 'read_only' | null;
      grace_until: string | null;
      current_period_start: string | null;
      current_period_end: string | null;
      cancel_at: string | null;
      scheduled_offer: Offer | null;
      scheduled_at: string | null;
      unpaid_amount: number | null;
      unpaid_invoice_url: string | null;
      has_stripe_customer: boolean | null;
      has_subscription: boolean | null;
      business: Business | null;
      analyses_in_period: number;
    };
    type Profile = {
      role: string | null;
      is_active: boolean | null;
      licencetype: string | null;
      studio_name: string | null;
    };

    const SUBSCRIPTION_PLANS: Plan[] = ['payg', 'studio', 'unlimited', 'unlimited_launch'];
    // Offres proposées au changement, avec leur prix HT (centimes) et leur rythme.
    const CHANGE_TARGETS: { offer: Offer; cents: number; unit: 'analysis' | 'month' | 'year' }[] = [
      { offer: 'payg', cents: 2000, unit: 'analysis' },
      { offer: 'studio', cents: 7900, unit: 'month' },
      { offer: 'unlimited', cents: 11900, unit: 'month' },
      { offer: 'unlimited_annual', cents: 119000, unit: 'year' },
    ];
    const STUDIO_INCLUDED = 5;
    const TRIAL_DAYS = 14;
    const DAY_MS = 86_400_000;

    const root = () => document.getElementById('account') as HTMLElement;
    const L = (): Record<string, string> => JSON.parse(root().dataset.labels ?? '{}');
    const lang = () => root().dataset.lang ?? 'fr';

    // Construit par nœuds DOM (textContent), jamais par innerHTML : le nom du
    // studio est saisi par l'utilisateur, les libellés sont des traductions.
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = ''): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text) node.textContent = text;
      return node;
    }
    const dateFmt = (iso: string | null) =>
      iso
        ? new Intl.DateTimeFormat(lang(), { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso))
        : '';
    const eur = (cents: number) =>
      new Intl.NumberFormat(lang(), { style: 'currency', currency: 'EUR' }).format(cents / 100);

    /** Ligne de paramètres : libellé, valeur (texte ou nœud), actions. */
    function row(label: string, value: string | Node, ...actions: Node[]) {
      const r = el('div', 'acct-row');
      r.append(el('dt', 'acct-row-label', label));
      const dd = el('dd', 'acct-row-value');
      dd.append(typeof value === 'string' ? document.createTextNode(value) : value);
      r.append(dd);
      if (actions.length) {
        const a = el('dd', 'acct-row-actions');
        a.append(...actions);
        r.append(a);
      }
      return r;
    }
    function rows(...items: HTMLElement[]) {
      const dl = el('dl', 'acct-rows');
      dl.append(...items);
      return dl;
    }
    function note(tone: 'ok' | 'warn' | 'bad', text: string) {
      const p = el('p', `acct-note acct-note--${tone}`, text);
      p.setAttribute('role', tone === 'bad' ? 'alert' : 'status');
      return p;
    }
    const pill = (tone: 'ok' | 'warn' | 'bad' | 'info', text: string) =>
      el('span', `acct-pill acct-pill--${tone}`, text);
    function btn(label: string, kind: 'primary' | 'plain' | 'danger', onClick: () => unknown) {
      const cls = { primary: 'acct-btn acct-btn--primary', plain: 'acct-btn', danger: 'acct-link acct-link--danger' }[
        kind
      ];
      const b = el('button', cls, label);
      b.type = 'button';
      b.addEventListener('click', async () => {
        b.disabled = true;
        try {
          await onClick();
        } finally {
          b.disabled = false;
        }
      });
      return b;
    }
    function linkBtn(label: string, href: string, kind: 'primary' | 'plain' | 'link') {
      const cls = { primary: 'acct-btn acct-btn--primary', plain: 'acct-btn', link: 'acct-link' }[kind];
      const a = el('a', cls, label);
      a.href = href;
      return a;
    }
    const actions = (...items: Node[]) => {
      const d = el('div', 'acct-actions');
      d.append(...items);
      return d;
    };
    const body = (id: string) => document.querySelector<HTMLElement>(`#${id} [data-body]`)!;
    function showSection(id: string, visible: boolean) {
      document.getElementById(id)?.classList.toggle('hidden', !visible);
      document
        .querySelector<HTMLElement>(`#acct-nav a[href="#${id}"]`)
        ?.parentElement?.classList.toggle('hidden', !visible);
      if (!visible && currentTab === id) openTab(firstTab());
    }

    // --- Onglets : une section affichée à la fois, lien direct par ancre. ---
    let currentTab = '';
    // Offres affichées sous la page, seulement dans l'onglet concerné.
    const offers = { bf: false, rider: false };
    const tabIds = () =>
      [...document.querySelectorAll<HTMLElement>('#account .acct-section')]
        .filter((sec) => !sec.classList.contains('hidden'))
        .map((sec) => sec.id);
    const firstTab = () => tabIds()[0] ?? '';
    function syncOffers() {
      document.getElementById('bf-offers')?.classList.toggle('hidden', !(offers.bf && currentTab === 'abonnement'));
      document
        .getElementById('rider-offers')
        ?.classList.toggle('hidden', !(offers.rider && currentTab === 'diagnostics'));
    }
    function openTab(id: string, updateUrl = false) {
      if (!tabIds().includes(id)) return;
      currentTab = id;
      document.querySelectorAll<HTMLElement>('#account .acct-section').forEach((sec) => {
        sec.toggleAttribute('data-active', sec.id === id);
      });
      document.querySelectorAll<HTMLAnchorElement>('#acct-nav a').forEach((a) => {
        if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      if (updateUrl) history.replaceState(null, '', `#${id}`);
      syncOffers();
    }
    document.getElementById('acct-nav')?.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a) return;
      e.preventDefault();
      openTab(a.getAttribute('href')!.slice(1), true);
      document.getElementById('account')?.scrollIntoView({ block: 'start' });
    });
    window.addEventListener('hashchange', () => openTab(location.hash.slice(1)));
    // Message après une action, en bas du panneau concerné.
    function flashIn(panel: HTMLElement, text: string, ok: boolean) {
      panel.querySelector(':scope > .acct-flash')?.remove();
      const p = el('p', `acct-flash ${ok ? 'is-ok' : 'is-bad'}`, text);
      p.setAttribute('aria-live', 'polite');
      panel.append(p);
    }
    function initials(name: string) {
      const words = name
        .replace(/@.*/, '')
        .split(/[\s._-]+/)
        .filter(Boolean);
      return ((words[0]?.[0] ?? '') + (words[1]?.[0] ?? '')).toUpperCase() || 'A';
    }

    // ---------------------------------------------------------------------
    // Profil : en-tête, section Compte, visibilité des sections et des offres.
    // ---------------------------------------------------------------------

    async function loadProfile() {
      const T = L();
      const sub = document.getElementById('acct-sub')!;
      const { data: userData, error } = await supabase.auth.getUser();
      if (error || !userData?.user) {
        sub.replaceChildren(note('bad', T.notLogged));
        return null;
      }
      const user = userData.user;
      const read = () =>
        supabase.from('users').select('role, is_active, licencetype, studio_name').eq('id', user.id).maybeSingle();
      let { data: profile } = await read();
      if (!profile) {
        // Profil créé par un trigger à la confirmation de l'e-mail.
        await new Promise((r) => setTimeout(r, 1500));
        ({ data: profile } = await read());
      }
      if (!profile) {
        sub.replaceChildren(note('bad', T.profileNotFound));
        return null;
      }
      const p = profile as Profile;
      const isBf = p.role === 'bike-fitter' || p.role === 'pending_bf';
      const email = user.email ?? '';
      const name = (isBf && p.studio_name) || email;
      const roleLabel = T[`role.${p.role}`] ?? p.role ?? '';

      document.getElementById('acct-name')!.textContent = name;
      document.getElementById('acct-avatar')!.textContent = initials(name);
      sub.replaceChildren();
      if (name !== email) sub.append(el('span', '', email));
      sub.append(pill('info', roleLabel));

      // Sections et offres selon le type de compte.
      const who = isBf || p.role === 'admin' ? 'bf' : 'rider';
      document.querySelectorAll<HTMLElement>('#account [data-for]').forEach((n) => {
        const f = n.dataset.for;
        n.classList.toggle('hidden', !(f === 'all' || f === who || (p.role === 'admin' && f === 'rider')));
      });
      document.getElementById('acct-nav')!.classList.remove('hidden');
      offers.rider = !isBf;
      document.querySelectorAll<HTMLElement>('#account [data-for-text]').forEach((n) => {
        n.classList.toggle('hidden', n.dataset.forText !== (isBf ? 'bf' : 'rider'));
      });
      openTab(tabIds().includes(location.hash.slice(1)) ? location.hash.slice(1) : firstTab());
      if (isBf) {
        // Ni bandeau ni bouton « Pré-réserve ton Diagnostic » pour un BF.
        document
          .querySelectorAll<HTMLElement>('[data-rider-promo], [data-header-actions]')
          .forEach((n) => n.classList.add('hidden'));
      }

      // Section Compte.
      const items = [row(T['account.email'], email), row(T['account.role'], roleLabel)];
      if (p.role === 'rider' && p.is_active && p.licencetype) items.push(row(T['account.licence'], p.licencetype));
      body('compte').replaceChildren(
        rows(...items),
        actions(
          btn(T['account.signout'], 'plain', async () => {
            await supabase.auth.signOut();
            window.location.href = `/${lang()}/inscription/connexion/`;
          })
        )
      );
      return { id: user.id, role: p.role, name };
    }

    // ---------------------------------------------------------------------
    // Bike fitter : Abonnement, Utilisation, Facturation, Studio.
    // ---------------------------------------------------------------------

    async function fetchSummary(): Promise<Summary | null> {
      const { data, error } = await supabase.rpc('bf_usage_summary');
      const s = data as Summary | null;
      return error || !s?.plan ? null : s;
    }

    /** Prix de l'offre en cours, en clair. */
    function priceOf(offer: Offer, now: number) {
      const T = L();
      const month = (c: number) => T['price.month'].replace('{price}', eur(c));
      const year = (c: number) => T['price.year'].replace('{price}', eur(c));
      switch (offer) {
        case 'payg':
          return T['price.analysis'].replace('{price}', eur(2000));
        case 'studio':
          return month(7900);
        case 'unlimited':
          return month(11900);
        case 'unlimited_annual':
          return year(119000);
        case 'unlimited_launch':
          return month(now < LAUNCH_OFFER.switchAt ? 6900 : 11900);
        case 'unlimited_launch_annual':
          return year(69000);
      }
    }

    /** « Changer d'offre » : liste dépliable avec prix et moment d'effet. */
    function changeOffer(s: Summary, current: Offer, choose: (o: Offer, down: boolean) => Promise<unknown>) {
      const T = L();
      const offerLabel = (o: string) => T[`plan.${o}`] ?? o;
      const details = el('details', 'acct-change');
      details.append(el('summary', 'acct-btn', T.changeOffer));
      const list = el('ul', 'acct-change-list');
      for (const target of CHANGE_TARGETS.filter((x) => x.offer !== current && x.offer !== s.scheduled_offer)) {
        const down = isDowngrade(current, target.offer);
        const li = el('li', 'acct-change-row');
        const info = el('div');
        info.append(
          el('p', 'acct-change-name', offerLabel(target.offer)),
          el('p', 'acct-muted acct-small', T[`price.${target.unit}`].replace('{price}', eur(target.cents))),
          el(
            'p',
            'acct-muted acct-small',
            down ? T['when.later'].replace('{date}', dateFmt(s.current_period_end)) : T['when.now']
          )
        );
        li.append(
          info,
          btn(T.choose, 'plain', () => {
            let q = (down ? T.changeConfirmDown : T.changeConfirmUp).replace('{offer}', offerLabel(target.offer));
            if (current === 'unlimited_launch' || current === 'unlimited_launch_annual') q += `\n\n${T.leaveLaunch}`;
            return confirm(q) ? choose(target.offer, down) : null;
          })
        );
        list.append(li);
      }
      details.append(list);
      return details;
    }

    /** « Débloquez vos 14 jours d'essai gratuit » : SIRET, SIREN, TVA ou site. */
    function unlockForm(s: Summary) {
      const T = L();
      const form = el('form', 'acct-unlock');
      form.noValidate = true;
      form.append(el('h3', 'acct-plan-name', T['trial.unlock.title']), el('p', 'acct-lead', T['trial.unlock.text']));
      const label = el('label', 'acct-field');
      label.append(el('span', 'acct-field-label', T['biz.label']));
      const input = el('input', 'acct-input');
      input.name = 'business-id';
      input.required = true;
      input.autocomplete = 'off';
      input.spellcheck = false;
      input.placeholder = T['biz.placeholder'];
      label.append(input);
      const cta = el('button', 'acct-btn acct-btn--primary', T['biz.cta']);
      cta.type = 'submit';
      const line = el('div', 'acct-field-row');
      line.append(label, cta);
      form.append(line);
      if (s.trial_state === 'business_id_used' || s.trial_state === 'card_already_used') {
        flashIn(form, T['biz.used'], false);
      }
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!input.value.trim()) return input.focus();
        cta.disabled = true;
        flashIn(form, T.updating, true);
        const r = await submitBusinessId(input.value);
        cta.disabled = false;
        if ('error' in r) return flashIn(form, T.error, false);
        const messages: Record<string, [string, boolean]> = {
          granted: [T['biz.granted'], true],
          already_granted: [T['biz.granted'], true],
          pending_review: [T['biz.pending'], true],
          already_used: [T['biz.used'], false],
          invalid: [T['biz.invalid'], false],
          not_found: [T['biz.notFound'], false],
          inactive: [T['biz.inactive'], false],
          registry_down: [T['biz.registryDown'], false],
          unreachable: [T['biz.unreachable'], false],
        };
        const [text, ok] = messages[r.result] ?? [T.error, false];
        if (ok) {
          const fresh = await fetchSummary();
          if (fresh) return renderBf(fresh, { panel: 'abonnement', text, ok });
        }
        flashIn(form, text, ok);
        input.focus();
      });
      return form;
    }

    function planHead(label: string, name: string, badge?: HTMLElement) {
      const head = el('div', 'acct-plan');
      const t = el('div');
      t.append(el('p', 'acct-muted acct-small', label), el('h3', 'acct-plan-name', name));
      head.append(t);
      if (badge) head.append(badge);
      return head;
    }

    function renderBf(s: Summary, flash?: { panel: string; text: string; ok: boolean }) {
      const T = L();
      const now = Date.now();
      const current: Offer | null = s.offer ?? (SUBSCRIPTION_PLANS.includes(s.plan!) ? (s.plan as Offer) : null);
      const offerLabel = (o: string) => T[`plan.${o}`] ?? o;
      const subscribed = Boolean(SUBSCRIPTION_PLANS.includes(s.plan!) && s.has_subscription && current);
      const trialEnd = s.trial_ends_at ? new Date(s.trial_ends_at).getTime() : null;
      const inTrial = s.plan === 'trial' && trialEnd !== null && trialEnd > now;
      const trialOver = s.plan === 'trial' && trialEnd !== null && trialEnd <= now;
      const pendingId = s.plan === 'trial' && trialEnd === null && s.trial_state === 'pending_review';
      const needsId = s.plan === 'trial' && trialEnd === null && !pendingId;
      // Une seule action orange à la fois : régler une facture passe avant tout.
      const primaryFree = !s.unpaid_amount;

      // Action sur l'abonnement : la route réaligne la base, on redessine.
      const act = async (action: 'change' | 'cancel' | 'resume' | 'keep', done: string, offer?: Offer) => {
        flashIn(body('abonnement'), T.updating, true);
        const r = await manageSubscription(action, offer);
        if (r.error) return flashIn(body('abonnement'), T.error, false);
        const fresh = await fetchSummary();
        if (fresh) renderBf(fresh, { panel: 'abonnement', text: done, ok: true });
      };

      // --- Alerte globale --------------------------------------------------
      const alert = document.getElementById('acct-alert')!;
      alert.replaceChildren();
      if (s.unpaid_amount) {
        const box = el('div', 'acct-banner acct-banner--bad');
        box.append(el('p', '', T.debt.replace('{amount}', eur(s.unpaid_amount))));
        if (s.unpaid_invoice_url) {
          const pay = linkBtn(T.payDebt, s.unpaid_invoice_url, 'primary');
          pay.target = '_blank';
          pay.rel = 'noopener';
          box.append(pay);
        }
        alert.append(box);
      } else if (s.status === 'past_due' && s.access === 'full') {
        const box = el('div', 'acct-banner acct-banner--warn');
        box.append(
          el('p', '', T.pastDue.replace('{date}', dateFmt(s.grace_until))),
          btn(T.portal, 'primary', () => openPortal(lang()))
        );
        alert.append(box);
      } else if (s.access === 'read_only') {
        const box = el('div', 'acct-banner acct-banner--bad');
        box.append(el('p', '', T.readOnly));
        alert.append(box);
      }
      alert.classList.toggle('hidden', !alert.childElementCount);

      // --- Abonnement ------------------------------------------------------
      const plan = body('abonnement');
      plan.replaceChildren();
      if (subscribed && current) {
        const badge =
          s.status === 'past_due'
            ? pill('warn', T['status.pastDue'])
            : s.cancel_at
              ? pill('warn', T['status.canceling'])
              : pill('ok', T['status.active']);
        plan.append(planHead(T['plan.current'], offerLabel(current), badge));
        const items = [row(T['plan.price'], priceOf(current, now))];
        if (s.current_period_end && !s.cancel_at) items.push(row(T['plan.nextDate'], dateFmt(s.current_period_end)));
        plan.append(rows(...items));
        if (s.cancel_at) plan.append(note('warn', T.cancelScheduled.replace('{date}', dateFmt(s.cancel_at))));
        else if (s.scheduled_offer) {
          plan.append(
            note(
              'warn',
              T.changeScheduled
                .replace('{offer}', offerLabel(s.scheduled_offer))
                .replace('{date}', dateFmt(s.scheduled_at))
            )
          );
        }
        if (s.cancel_at) {
          plan.append(actions(btn(T.resume, 'plain', () => act('resume', T.resumeDone))));
        } else {
          const a = actions();
          if (s.scheduled_offer) a.append(btn(T.keep, 'plain', () => act('keep', T.keepDone)));
          a.append(
            changeOffer(s, current, (o, down) =>
              act('change', down ? T.changeLater.replace('{date}', dateFmt(s.current_period_end)) : T.changeDone, o)
            ),
            btn(T.cancel, 'danger', () => (confirm(T.cancelConfirm) ? act('cancel', T.cancelDone) : null))
          );
          plan.append(a);
        }
      } else if (s.plan === 'legacy') {
        plan.append(planHead(T['plan.current'], offerLabel('legacy'), pill('ok', T['status.active'])));
      } else if (inTrial) {
        const days = Math.max(1, Math.ceil((trialEnd! - now) / DAY_MS));
        plan.append(
          planHead(T['plan.current'], T['trial.name'], pill('info', T['trial.left'].replace('{n}', String(days)))),
          el('p', 'acct-lead', T['trial.until'].replace('{date}', dateFmt(s.trial_ends_at)))
        );
        const track = el('div', 'acct-meter-track');
        const fill = el('span', 'acct-meter-fill');
        fill.style.width = `${Math.min(100, Math.max(4, ((TRIAL_DAYS - days) / TRIAL_DAYS) * 100))}%`;
        track.append(fill);
        plan.append(
          track,
          actions(
            linkBtn(T['trial.choose'], '#tarifs', primaryFree ? 'primary' : 'plain'),
            linkBtn(T.onboarding, `/${lang()}/bike-fitting/bienvenue/`, 'link')
          )
        );
      } else if (trialOver) {
        plan.append(
          el('h3', 'acct-plan-name', T['trial.ended'].replace('{date}', dateFmt(s.trial_ends_at))),
          el('p', 'acct-lead', T['trial.endedText']),
          actions(linkBtn(T['trial.choose'], '#tarifs', primaryFree ? 'primary' : 'plain'))
        );
      } else if (pendingId) {
        plan.append(el('h3', 'acct-plan-name', T['trial.unlock.title']), note('ok', T['trial.pending']));
      } else if (needsId) {
        plan.append(unlockForm(s));
      } else {
        // Abonnement terminé (impayé pendant la grâce, résiliation…) : souscrire.
        plan.append(
          el('p', 'acct-lead', T['plan.noSub']),
          actions(linkBtn(T['trial.choose'], '#tarifs', primaryFree ? 'primary' : 'plain'))
        );
      }

      // --- Utilisation -----------------------------------------------------
      const usage = body('utilisation');
      usage.replaceChildren();
      const showUsage = subscribed || inTrial || trialOver || s.plan === 'legacy';
      showSection('utilisation', showUsage);
      if (showUsage) {
        if (current === 'studio' && subscribed) {
          const n = s.analyses_in_period;
          const label =
            n > STUDIO_INCLUDED
              ? T['meter.over']
                  .replace('{max}', String(STUDIO_INCLUDED))
                  .replace('{extra}', String(n - STUDIO_INCLUDED))
              : T['meter.included'].replace('{n}', String(n)).replace('{max}', String(STUDIO_INCLUDED));
          const m = el('div', 'acct-meter');
          const track = el('div', `acct-meter-track${n > STUDIO_INCLUDED ? ' is-over' : ''}`);
          track.setAttribute('role', 'meter');
          track.setAttribute('aria-valuemin', '0');
          track.setAttribute('aria-valuemax', String(STUDIO_INCLUDED));
          track.setAttribute('aria-valuenow', String(n));
          track.setAttribute('aria-label', label);
          const fill = el('span', 'acct-meter-fill');
          fill.style.width = `${Math.min(100, (n / STUDIO_INCLUDED) * 100)}%`;
          track.append(fill);
          m.append(el('p', 'acct-meter-label', label), track);
          usage.append(m);
        }
        const v = el('span', 'acct-inline');
        v.append(el('strong', 'acct-big', String(s.analyses_in_period)));
        if (s.current_period_start) {
          v.append(
            el('span', 'acct-muted acct-small', T['meter.period'].replace('{date}', dateFmt(s.current_period_start)))
          );
        }
        usage.append(rows(row(T.analyses, v)));
      }

      // --- Facturation -----------------------------------------------------
      const billing = body('facturation');
      const billItems: HTMLElement[] = [];
      const billed = s.scheduled_offer ?? current;
      const next =
        subscribed && !s.cancel_at && billed
          ? nextInvoiceCentsForOffer(
              billed,
              s.scheduled_offer ? 0 : s.analyses_in_period,
              now,
              s.current_period_end ? new Date(s.current_period_end).getTime() : null
            )
          : null;
      if (next !== null) {
        const when = s.current_period_end ? T.nextInvoiceOn.replace('{date}', dateFmt(s.current_period_end)) : '';
        billItems.push(row(T['billing.estimate'], `${eur(next)} ${T.vat}${when ? `, ${when}` : ''}`));
      }
      if (s.unpaid_amount) {
        const pay = linkBtn(T.payDebt, s.unpaid_invoice_url ?? '#', 'plain');
        pay.target = '_blank';
        pay.rel = 'noopener';
        billItems.push(row(T['billing.debtRow'], eur(s.unpaid_amount), pay));
      }
      if (s.has_stripe_customer) {
        billItems.push(
          row(
            T['billing.manage'],
            T['billing.manageText'],
            btn(T.portal, 'plain', () => openPortal(lang()))
          )
        );
      }
      billing.replaceChildren(billItems.length ? rows(...billItems) : el('p', 'acct-muted', T['billing.none']));

      // --- Studio ----------------------------------------------------------
      const items = [row(T['studio.name'], document.getElementById('acct-name')?.textContent ?? '')];
      if (s.business) {
        const b = s.business;
        const idText =
          b.kind === 'website'
            ? (b.website ?? b.id).replace(/^https?:\/\//, '')
            : b.kind === 'eu_vat' && b.country !== 'FR'
              ? T['studio.kind.eu_vat'].replace('{id}', `${b.country ?? ''}${b.id}`)
              : T['studio.kind.siren'].replace('{id}', b.id.replace(/(\d{3})(?=\d)/g, '$1 '));
        const v = el('span', 'acct-inline');
        v.append(
          el('span', '', idText),
          b.status === 'verified' ? pill('ok', T['studio.verified']) : pill('warn', T['studio.pending'])
        );
        items.push(row(T['studio.id'], v));
        if (b.legal_name) items.push(row(T['studio.legal'], b.legal_name));
      } else {
        items.push(row(T['studio.id'], T['studio.none']));
      }
      body('studio').replaceChildren(rows(...items));

      // Offres BF payables depuis l'espace (onglet Abonnement), tant qu'aucun
      // abonnement n'est en cours.
      offers.bf = !(subscribed || s.plan === 'legacy');
      syncOffers();
      if (flash) flashIn(body(flash.panel), flash.text, flash.ok);
    }

    async function loadBf() {
      const s = await fetchSummary();
      if (!s) return;
      const T = L();
      // Retour de Checkout : le webhook arrive en général quelques secondes après.
      const billingState = new URLSearchParams(window.location.search).get('billing');
      const flash = billingState === 'success' ? { panel: 'abonnement', text: T.success, ok: true } : undefined;
      renderBf(s, flash);
      if (billingState === 'success' && !s.has_subscription) {
        for (let i = 0; i < 15; i++) {
          await new Promise((r) => setTimeout(r, 2000));
          const fresh = await fetchSummary();
          if (fresh?.has_subscription) return renderBf(fresh, flash);
        }
      }
    }

    // ---------------------------------------------------------------------
    // Bike fitter : Activité, les fittings enregistrés par l'application AeroX.
    // Lecture directe sous RLS : sessions (user_id = soi), bf_clients
    // (bf_user_id = soi). Filtre explicite sur l'utilisateur : un admin peut
    // lire toutes les lignes.
    // ---------------------------------------------------------------------

    const monthName = (year: number, month: number, style: 'long' | 'short' = 'long') =>
      new Intl.DateTimeFormat(lang(), { month: style }).format(new Date(year, month, 1));

    function stat(label: string, value: string, sub: string) {
      const d = el('div', 'acct-stat');
      d.append(el('p', 'acct-stat-label', label), el('p', 'acct-stat-value', value));
      if (sub) d.append(el('p', 'acct-muted acct-small', sub));
      return d;
    }

    function monthChart(dates: string[], now: Date) {
      const T = L();
      const months = monthlyCounts(dates, now);
      const max = Math.max(1, ...months.map((m) => m.count));
      const block = el('div', 'acct-block');
      block.append(el('h3', 'acct-block-title', T['act.perMonth']));
      const chart = el('ol', 'acct-chart');
      for (const m of months) {
        const col = el('li', 'acct-chart-col');
        col.title = T['act.perMonthBar']
          .replace('{month}', `${monthName(m.year, m.month)} ${m.year}`)
          .replace('{n}', String(m.count));
        const track = el('span', 'acct-chart-track');
        const bar = el('span', `acct-chart-bar${m.count ? '' : ' is-zero'}`);
        bar.style.setProperty('--h', String(m.count / max));
        track.append(el('span', 'acct-chart-n', String(m.count)), bar);
        col.append(track, el('span', 'acct-chart-m', monthName(m.year, m.month, 'short')));
        chart.append(col);
      }
      block.append(chart);
      return block;
    }

    async function loadActivity(userId: string) {
      const T = L();
      const panel = body('activite');
      panel.replaceChildren(el('p', 'acct-muted', T['act.loading']));
      const [fits, riders] = await Promise.all([
        supabase
          .from('sessions')
          .select('created_at')
          .eq('user_id', userId)
          .eq('session_type', 'fitting')
          .order('created_at', { ascending: false })
          .limit(10000),
        supabase.from('bf_clients').select('created_at').eq('bf_user_id', userId),
      ]);
      if (fits.error || riders.error) {
        panel.replaceChildren(note('bad', T['act.error']));
        return;
      }
      const dates = ((fits.data ?? []) as { created_at: string }[]).map((f) => f.created_at);
      const clients = (riders.data ?? []) as { created_at: string }[];
      const now = new Date();
      const prev = new Date(now.getFullYear(), now.getMonth() - 1, 1);

      const stats = el('div', 'acct-stats');
      stats.append(
        stat(
          T['act.thisMonth'],
          String(countInMonth(dates, now)),
          T['act.prevMonth']
            .replace('{n}', String(countInMonth(dates, prev)))
            .replace('{month}', monthName(prev.getFullYear(), prev.getMonth()))
        ),
        stat(
          T['act.total'],
          String(dates.length),
          dates.length ? T['act.since'].replace('{date}', dateFmt(dates[dates.length - 1])) : ''
        ),
        stat(
          T['act.riders'],
          String(clients.length),
          T['act.newRiders'].replace(
            '{n}',
            String(
              countInMonth(
                clients.map((c) => c.created_at),
                now
              )
            )
          )
        )
      );
      panel.replaceChildren(stats);

      if (!dates.length) {
        panel.append(
          el('p', 'acct-lead acct-empty', T['act.empty']),
          actions(linkBtn(T['act.emptyCta'], '#telechargement', 'plain'))
        );
        return;
      }
      panel.append(monthChart(dates, now));
    }

    // ---------------------------------------------------------------------
    // Cycliste : diagnostics.
    // ---------------------------------------------------------------------

    async function loadDiagnostics(userId: string) {
      const T = L();
      const { data } = await supabase
        .from('diagnostic_purchases')
        .select('paid_at, consumed_at, refunded_at')
        .eq('user_id', userId)
        .order('paid_at', { ascending: false });
      const list = (data ?? []) as { paid_at: string; consumed_at: string | null; refunded_at: string | null }[];
      const panel = body('diagnostics');
      if (!list.length) {
        panel.replaceChildren(
          el('p', 'acct-muted', T['diag.empty']),
          actions(linkBtn(T['trial.choose'], '#pricing', 'primary'))
        );
        return;
      }
      panel.replaceChildren(
        rows(
          ...list.map((r) => {
            const [tone, status]: ['ok' | 'warn' | 'info', string] = r.refunded_at
              ? ['info', T['diag.refunded'].replace('{date}', dateFmt(r.refunded_at))]
              : r.consumed_at
                ? ['info', T['diag.consumed'].replace('{date}', dateFmt(r.consumed_at))]
                : isDiagnosticAvailable()
                  ? ['ok', T['diag.available']]
                  : ['warn', T['diag.preorder']];
            return row(T['diag.purchased'].replace('{date}', dateFmt(r.paid_at)), pill(tone, status));
          })
        )
      );
    }

    async function init() {
      const me = await loadProfile();
      if (!me) return;
      if (me.role === 'bike-fitter' || me.role === 'admin') await Promise.all([loadBf(), loadActivity(me.id)]);
      // Compte en attente : pas de lecture des cyclistes (RLS), pas d'onglet.
      if (me.role === 'pending_bf') showSection('activite', false);
      if (me.role !== 'bike-fitter' && me.role !== 'pending_bf') await loadDiagnostics(me.id);
    }

    init();
  </script>
</Layout>

<style is:global>
  /*
    Page de compte pro : surfaces calmes tirées du bleu nuit du site, orange
    AeroX réservé à une seule action principale par écran. Les états sont
    des pastilles et des bandeaux teintés, jamais du texte jaune ou rouge.
  */
  #account {
    --acct-surface: #132a40;
    --acct-inset: #0e2134;
    --acct-line: #26435f;
    --acct-text: #e8eef5;
    --acct-muted: #9db0c4;
    --acct-accent: #f5a23c;
    --acct-on-accent: #10202f;
    --acct-ok: #6fd3a8;
    --acct-warn: #e9c16b;
    --acct-bad: #f08a8a;
    --acct-info: #8fb8e6;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.25rem 1rem 3rem;
    color: var(--acct-text);
    font-variant-numeric: tabular-nums;
  }
  html:not(.dark) #account {
    --acct-surface: #ffffff;
    --acct-inset: #f3f6fa;
    --acct-line: #d6e0ea;
    --acct-text: #13253a;
    --acct-muted: #55697e;
    --acct-ok: #1f8a5b;
    --acct-warn: #9a6a06;
    --acct-bad: #b93838;
    --acct-info: #2f6aa8;
  }
  @media (min-width: 768px) {
    #account {
      padding: 3rem 1.5rem 4rem;
    }
  }
  #account .hidden {
    display: none !important;
  }
  #account .acct-muted {
    color: var(--acct-muted);
  }
  #account .acct-small {
    font-size: 0.8125rem;
  }

  /* En-tête */
  #account .acct-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  #account .acct-avatar {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.875rem;
    display: grid;
    place-items: center;
    background: var(--acct-surface);
    border: 1px solid var(--acct-line);
    font-weight: 700;
    font-size: 1.125rem;
  }
  #account .acct-avatar:empty {
    visibility: hidden;
  }
  #account .acct-head h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    #account .acct-head h1 {
      font-size: 2rem;
    }
  }
  #account #acct-sub {
    margin-top: 0.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    overflow-wrap: anywhere;
  }

  /* Bandeau global */
  #account .acct-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--tone) 50%, transparent);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
  }
  #account .acct-banner--bad {
    --tone: var(--acct-bad);
  }
  #account .acct-banner--warn {
    --tone: var(--acct-warn);
  }

  /* Mise en page : navigation + sections */
  #account .acct-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  /* Les onglets défilent horizontalement sans élargir la page. */
  #account .acct-layout > * {
    min-width: 0;
  }
  @media (min-width: 960px) {
    #account .acct-layout {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 2.5rem;
      align-items: stretch;
    }
  }
  #account .acct-nav ul {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--acct-line);
    scrollbar-width: none;
  }
  #account .acct-nav a {
    display: block;
    padding: 0.625rem 0.75rem;
    color: var(--acct-muted);
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    border-radius: 0.5rem;
  }
  #account .acct-nav a:hover {
    color: var(--acct-text);
  }
  @media (min-width: 960px) {
    /* Séparation entre le menu et le contenu, sur toute la hauteur. */
    #account .acct-nav {
      border-right: 1px solid color-mix(in srgb, var(--acct-muted) 35%, transparent);
      padding-right: 1.25rem;
    }
    #account .acct-nav ul {
      position: sticky;
      top: 6rem;
      flex-direction: column;
      border-bottom: 0;
    }
    #account .acct-nav a:hover {
      background: color-mix(in srgb, var(--acct-surface) 80%, transparent);
    }
  }

  #account .acct-sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.75rem;
  }
  #account .acct-section {
    scroll-margin-top: 6rem;
  }
  /* Onglets : seule la section active est affichée. */
  #account .acct-section:not([data-active]) {
    display: none;
  }
  /* Onglet actif : trait orange sous l'onglet (mobile), à gauche (bureau). */
  #account .acct-nav a[aria-current='page'] {
    color: var(--acct-text);
    box-shadow: inset 0 -2px 0 var(--acct-accent);
