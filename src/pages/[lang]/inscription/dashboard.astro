---
import PricingSection from '~/components/widgets/PricingSection.astro';

import Layout from '../../../layouts/PageLayout.astro';
import { getDict, t } from '~/lib/i18n';

const { lang } = Astro.params;
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'dashboard.meta.title'),
  description: t(dict, 'dashboard.meta.description'),
};
const role = t(dict, 'dashboard.role');
const email = t(dict, 'dashboard.email');
const choosePack = t(dict, 'dashboard.choosePack');
const licence = t(dict, 'dashboard.licence');
const noLicence = t(dict, 'dashboard.noLicence');
const studio = t(dict, 'dashboard.studio');
const noStudio = t(dict, 'dashboard.noStudio');
const pendingActivation = t(dict, 'dashboard.pendingActivation');
const activeBf = t(dict, 'dashboard.activeBf');

// Libellés du panneau de facturation bike fitter, lus par le script client.
const bfLabels = Object.fromEntries(
  [
    'title',
    'plan.trial',
    'plan.payg',
    'plan.unlimited_annual',
    'plan.studio',
    'plan.unlimited',
    'plan.unlimited_launch',
    'plan.legacy',
    'pastDue',
    'readOnly',
    'analyses',
    'credits',
    'creditsExpiry',
    'nextInvoice',
    'nextInvoiceOn',
    'portal',
    'seeOffers',
    'changeTo',
    'changeLater',
    'cancel',
    'cancelConfirm',
    'cancelDone',
    'changeConfirm',
    'changeDone',
    'success',
    'error',
    'onboarding',
    'trialCard.title',
    'trialCard.text',
    'trialCard.cta',
    'trialCard.used',
    'trialCard.done',
  ].map((k) => [k, t(dict, `dash.bf.${k}`)])
);
bfLabels['vat'] = t(dict, 'bfp.vat');
---

<Layout metadata={metadata}>
  <section class="max-w-4xl mx-auto px-6">
    <h1 class="text-3xl font-bold mb-6 text-center">
      {t(dict, 'dashboard.title')}
    </h1>
    <div
      id="dashboard-content"
      data-role={role}
      data-email={email}
      data-choosePack={choosePack}
      data-licence={licence}
      data-noLicence={noLicence}
      data-studio={studio}
      data-noStudio={noStudio}
      data-pendingActivation={pendingActivation}
      data-activeBf={activeBf}
      class="text-center"
    >
      <p>{t(dict, 'dashboard.loading')}</p>
    </div>

    <!-- Facturation bike fitter : rempli par le script si le compte est BF -->
    <div
      id="bf-billing-panel"
      class="hidden mt-8 p-6 border rounded-lg bg-gray-50 dark:bg-gray-800 text-left"
      data-lang={lang}
      data-labels={JSON.stringify(bfLabels)}
    >
    </div>

    <!-- ✅ Script côté client -->
    <script>
      import { supabase } from '../../../config/supabaseClient';

      async function loadDashboard() {
        console.log('➡️ Init dashboard');
        const content = document.getElementById('dashboard-content');
        const labelRole = content?.dataset.role || 'Role';
        const labelEmail = content?.dataset.email || 'Email';
        const choosePack = content?.dataset.choosepack || "Choisis ton pack pour profiter d'AeroX";
        const labelLicence = content?.dataset.licence || 'Licence';
        const labelNoLicence = content?.dataset.nolicence || 'Non définie';
        const labelStudio = content?.dataset.studio || 'Studio';
        const labelNoStudio = content?.dataset.nostudio || 'Non renseigné';
        const labelPendingActivation = content?.dataset.pendingactivation || "En attente d'activation";
        const labelActiveBf = content?.dataset.activebf || 'Compte Bike-Fitter actif';
        if (!content) return;

        // Vérifie si l'utilisateur est connecté
        const { data: userData, error } = await supabase.auth.getUser();
        if (error || !userData?.user) {
          content.innerHTML = `<p class="text-red-600">Tu n'es pas connect\u00e9.</p>`;
          return;
        }

        const user = userData.user;
        console.log('Connecté :', user.email);

        // Récupère son profil complet
        const { data: profile, error: profileError } = await supabase
          .from('users')
          .select('role, is_active, licencetype, studio_name')
          .eq('id', user.id)
          .maybeSingle();

        if (profileError) {
          console.error('Erreur chargement profil:', profileError);
        }

        if (profile) {
          let detailsHtml = '';

          if (profile.role === 'bike-fitter' || profile.role === 'pending_bf') {
            // Bike-Fitter / pending BF display
            const studioDisplay = profile.studio_name || labelNoStudio;
            detailsHtml += `<p><strong>${labelStudio} :</strong> ${studioDisplay}</p>`;
            if (profile.role === 'pending_bf') {
              detailsHtml += `<p class="text-yellow-600 font-semibold mt-1">${labelPendingActivation}</p>`;
            } else {
              detailsHtml += `<p class="text-green-600 font-semibold mt-1">${labelActiveBf}</p>`;
            }
          } else if (profile.role === 'admin') {
            // Admin: just show role, no licence
          } else {
            // Rider display (default)
            if (profile.is_active) {
              detailsHtml += `<p><strong>${labelLicence} :</strong> ${profile.licencetype || labelNoLicence}</p>`;
            } else {
              detailsHtml += `<p class="text-primary font-semibold text-center mt-2">${choosePack}</p>`;
            }
          }

          content.innerHTML = `
        <div class="mt-6 p-6 border rounded-lg bg-gray-50 dark:bg-gray-800 text-left inline-block">
          <p><strong>${labelEmail} :</strong> ${user.email}</p>
          <p><strong>${labelRole} :</strong> ${profile.role}</p>
          ${detailsHtml}
        </div>`;
        } else {
          // public.users est créé automatiquement par le trigger
          // handle_email_confirmed côté Supabase à la validation de l'email.
          // Si le profil n'existe pas encore, la confirmation email est peut-être
          // encore en cours de propagation — on retente après un court délai.
          await new Promise((r) => setTimeout(r, 1500));
          const { data: retry } = await supabase
            .from('users')
            .select('role, is_active, licencetype, studio_name')
            .eq('id', user.id)
            .maybeSingle();

          if (retry) {
            loadDashboard();
            return;
          }
          content.innerHTML = `<p class="text-red-600">Profil non trouvé. Vérifie que ton email est bien confirmé.</p>`;
        }
      }

      loadDashboard();
    </script>

    <script>
      import { supabase } from '../../../config/supabaseClient';
      import { manageSubscription, openPortal, startTrialCard } from '~/lib/billing/client';
      import { estimatedNextInvoiceCents, type Offer, type Plan } from '~/lib/billing/logic';

      type Summary = {
        plan: Plan | null;
        trial_state: 'needs_card' | 'granted' | 'card_already_used' | null;
        status: string | null;
        access: 'full' | 'read_only' | null;
        grace_until: string | null;
        current_period_start: string | null;
        current_period_end: string | null;
        has_stripe_customer: boolean | null;
        analyses_in_period: number;
        credits_remaining: number;
        credits_next_expiry: string | null;
      };

      const SUBSCRIPTION_PLANS: Plan[] = ['payg', 'studio', 'unlimited', 'unlimited_launch'];

      // Construit par nœuds DOM (textContent), jamais par innerHTML : les
      // libellés sont des traductions, mais la règle reste la même partout.
      function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = ''): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text) node.textContent = text;
        return node;
      }

      async function loadBfBilling() {
        const panel = document.getElementById('bf-billing-panel');
        if (!panel || panel.dataset.bound === '1') return;
        panel.dataset.bound = '1';
        const lang = panel.dataset.lang ?? 'fr';
        const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');

        const { data: userData } = await supabase.auth.getUser();
        if (!userData?.user) return;
        const { data: profile } = await supabase.from('users').select('role').eq('id', userData.user.id).maybeSingle();
        if (profile?.role !== 'bike-fitter' && profile?.role !== 'admin') return;

        const { data, error } = await supabase.rpc('bf_usage_summary');
        const s = data as Summary | null;
        if (error || !s?.plan) return;

        const date = (iso: string | null) =>
          iso
            ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso))
            : '';
        const eur = (cents: number) =>
          new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR' }).format(cents / 100);

        const msg = el('p', 'mt-4 hidden font-semibold');
        const say = (text: string, ok: boolean) => {
          msg.textContent = text;
          msg.classList.remove('hidden', 'text-red-600', 'text-green-600');
          msg.classList.add(ok ? 'text-green-600' : 'text-red-600');
        };

        panel.replaceChildren();
        panel.append(el('h2', 'text-xl font-bold mb-2', L.title));
        panel.append(el('p', 'text-lg font-semibold text-primary', L[`plan.${s.plan}`] ?? s.plan));

        if (s.status === 'past_due' && s.access === 'full') {
          panel.append(
            el('p', 'mt-2 text-yellow-700 dark:text-yellow-400', L.pastDue.replace('{date}', date(s.grace_until)))
          );
        } else if (s.access === 'read_only') {
          panel.append(el('p', 'mt-2 text-red-600 font-semibold', L.readOnly));
        }

        // Essai : les 2 analyses offertes se débloquent avec une carte (0 €).
        if (s.plan === 'trial' && s.trial_state === 'needs_card') {
          const box = el('div', 'mt-4 rounded-md border-2 border-primary bg-white dark:bg-gray-900 p-4');
          box.append(el('p', 'font-bold', L['trialCard.title']), el('p', 'mt-1 text-sm', L['trialCard.text']));
          const cta = el('button', 'btn-primary mt-3', L['trialCard.cta']);
          cta.type = 'button';
          cta.addEventListener('click', async () => {
            cta.disabled = true;
            const err = await startTrialCard(lang);
            cta.disabled = false;
            if (err) say(L.error, false);
          });
          box.append(cta);
          panel.append(box);
        } else if (s.plan === 'trial' && s.trial_state === 'card_already_used') {
          panel.append(el('p', 'mt-2 text-red-600 font-semibold', L['trialCard.used']));
        }

        const stats = el('dl', 'mt-4 grid gap-4 sm:grid-cols-2');
        const stat = (label: string, value: string, sub = '') => {
          const box = el('div', 'rounded-md bg-white dark:bg-gray-900 p-3');
          box.append(el('dt', 'text-sm text-gray-500', label), el('dd', 'text-2xl font-bold', value));
          if (sub) box.append(el('dd', 'text-sm text-gray-500', sub));
          stats.append(box);
        };
        stat(L.analyses, String(s.analyses_in_period));
        if (s.plan === 'trial' || s.plan === 'pack') {
          stat(L.credits, String(s.credits_remaining), L.creditsExpiry.replace('{date}', date(s.credits_next_expiry)));
        }
        // Illimité annuel : période de plus de 40 jours.
        const periodDays =
          s.current_period_start && s.current_period_end
            ? (new Date(s.current_period_end).getTime() - new Date(s.current_period_start).getTime()) / 86400000
            : 30;
        const annual = s.plan === 'unlimited' && periodDays > 40;
        const next = estimatedNextInvoiceCents(s.plan, s.analyses_in_period, Date.now(), periodDays);
        if (next !== null) {
          stat(
            L.nextInvoice,
            `${eur(next)} ${L.vat}`,
            s.current_period_end ? L.nextInvoiceOn.replace('{date}', date(s.current_period_end)) : ''
          );
        }
        panel.append(stats);

        const actions = el('div', 'mt-6 flex flex-wrap gap-3');
        const button = (label: string, cls: string, onClick: () => Promise<string | null>) => {
          const b = el('button', cls, label);
          b.type = 'button';
          b.addEventListener('click', async () => {
            b.disabled = true;
            const err = await onClick();
            b.disabled = false;
            if (err) say(L.error, false);
          });
          actions.append(b);
        };
        const link = (label: string, href: string, cls: string) => {
          const a = el('a', cls, label);
          a.href = href;
          actions.append(a);
        };

        if (s.has_stripe_customer) button(L.portal, 'btn-primary', () => openPortal(lang));

        if (s.plan === 'trial' || s.plan === 'pack') {
          link(L.seeOffers, `/${lang}/bike-fitting/#tarifs`, 'btn-secondary');
        }

        if (SUBSCRIPTION_PLANS.includes(s.plan)) {
          const current: Offer = annual ? 'unlimited_annual' : (s.plan as Offer);
          const others = (['payg', 'studio', 'unlimited', 'unlimited_annual'] as Offer[]).filter((o) => o !== current);
          for (const offer of others) {
            button(L.changeTo.replace('{offer}', L[`plan.${offer}`]), 'btn-secondary', async () => {
              if (!confirm(L.changeConfirm)) return null;
              const r = await manageSubscription('change', offer);
              if (!r.error) {
                say(
                  r.effectiveAt
                    ? L.changeLater.replace('{date}', date(new Date(r.effectiveAt * 1000).toISOString()))
                    : L.changeDone,
                  true
                );
              }
              return r.error;
            });
          }
          button(L.cancel, 'btn-tertiary text-red-600', async () => {
            if (!confirm(L.cancelConfirm)) return null;
            const r = await manageSubscription('cancel');
            if (!r.error) say(L.cancelDone, true);
            return r.error;
          });
        }

        if (s.plan === 'trial') link(L.onboarding, `/${lang}/bike-fitting/bienvenue/`, 'btn-tertiary underline');

        panel.append(actions, msg);
        panel.classList.remove('hidden');

        // Retour de Checkout : le webhook peut arriver quelques secondes après.
        const billingState = new URLSearchParams(window.location.search).get('billing');
        if (billingState === 'success') say(L.success, true);
        if (billingState === 'card' && s.trial_state === 'needs_card') say(L['trialCard.done'], true);
      }

      loadBfBilling();
      document.addEventListener('astro:page-load', loadBfBilling);
    </script>
  </section>

  <PricingSection />
</Layout>
