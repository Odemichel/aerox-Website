---
import PricingSection from '~/components/widgets/PricingSection.astro';
import BfPricing from '~/components/widgets/BfPricing.astro';

import Layout from '../../../layouts/PageLayout.astro';
import { getDict, t, type Locale } from '~/lib/i18n';

const { lang } = Astro.params;
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'dashboard.meta.title'),
  description: t(dict, 'dashboard.meta.description'),
};
const role = t(dict, 'dashboard.role');
const email = t(dict, 'dashboard.email');
const choosePack = t(dict, 'dashboard.choosePack');
const licence = t(dict, 'dashboard.licence');
const noLicence = t(dict, 'dashboard.noLicence');
const studio = t(dict, 'dashboard.studio');
const noStudio = t(dict, 'dashboard.noStudio');
const pendingActivation = t(dict, 'dashboard.pendingActivation');
const activeBf = t(dict, 'dashboard.activeBf');

// Libellés du panneau de facturation bike fitter, lus par le script client.
const bfLabels = Object.fromEntries(
  [
    'title',
    'plan.trial',
    'plan.payg',
    'plan.unlimited_annual',
    'plan.studio',
    'plan.unlimited',
    'plan.unlimited_launch',
    'plan.unlimited_launch_annual',
    'plan.legacy',
    'pastDue',
    'readOnly',
    'analyses',
    'credits',
    'creditsExpiry',
    'nextInvoice',
    'nextInvoiceOn',
    'portal',
    'seeOffers',
    'changeTo',
    'changeLater',
    'cancel',
    'cancelConfirm',
    'cancelDone',
    'cancelScheduled',
    'resume',
    'resumeDone',
    'changeScheduled',
    'keep',
    'keepDone',
    'changeConfirmUp',
    'changeConfirmDown',
    'leaveLaunch',
    'changeDone',
    'updating',
    'debt',
    'payDebt',
    'success',
    'error',
    'onboarding',
    'trialCard.title',
    'trialCard.text',
    'trialCard.cta',
    'trialCard.used',
    'trialCard.done',
  ].map((k) => [k, t(dict, `dash.bf.${k}`)])
);
bfLabels['vat'] = t(dict, 'bfp.vat');

// Achats du Diagnostic AeroX (cycliste), lus par le script client.
const diagLabels = Object.fromEntries(
  ['title', 'purchased', 'preorder', 'available', 'consumed', 'refunded'].map((k) => [k, t(dict, `dash.diag.${k}`)])
);
---

<Layout metadata={metadata}>
  <section class="max-w-4xl mx-auto px-6">
    <h1 class="text-3xl font-bold mb-6 text-center">
      {t(dict, 'dashboard.title')}
    </h1>
    <div
      id="dashboard-content"
      data-role={role}
      data-email={email}
      data-choosePack={choosePack}
      data-licence={licence}
      data-noLicence={noLicence}
      data-studio={studio}
      data-noStudio={noStudio}
      data-pendingActivation={pendingActivation}
      data-activeBf={activeBf}
      data-notLogged={t(dict, 'dashboard.notLogged')}
      data-profileNotFound={t(dict, 'dashboard.profileNotFound')}
      class="text-center"
    >
      <p>{t(dict, 'dashboard.loading')}</p>
    </div>

    <!-- Facturation bike fitter : rempli par le script si le compte est BF -->
    <div
      id="bf-billing-panel"
      class="hidden mt-8 p-6 border rounded-lg bg-gray-50 dark:bg-gray-800 text-left"
      data-lang={lang}
      data-labels={JSON.stringify(bfLabels)}
    >
    </div>

    <!-- Diagnostic AeroX : rempli par le script si le compte a des achats -->
    <div
      id="diag-panel"
      class="hidden mt-8 p-6 border rounded-lg bg-gray-50 dark:bg-gray-800 text-left"
      data-lang={lang}
      data-labels={JSON.stringify(diagLabels)}
    >
    </div>

    <!-- ✅ Script côté client -->
    <script>
      import { supabase } from '../../../config/supabaseClient';

      async function loadDashboard() {
        console.log('➡️ Init dashboard');
        const content = document.getElementById('dashboard-content');
        const labelRole = content?.dataset.role || 'Role';
        const labelEmail = content?.dataset.email || 'Email';
        const choosePack = content?.dataset.choosepack || "Choisis ton pack pour profiter d'AeroX";
        const labelLicence = content?.dataset.licence || 'Licence';
        const labelNoLicence = content?.dataset.nolicence || 'Non définie';
        const labelStudio = content?.dataset.studio || 'Studio';
        const labelNoStudio = content?.dataset.nostudio || 'Non renseigné';
        const labelPendingActivation = content?.dataset.pendingactivation || "En attente d'activation";
        const labelActiveBf = content?.dataset.activebf || 'Compte Bike-Fitter actif';
        if (!content) return;

        // Vérifie si l'utilisateur est connecté
        const { data: userData, error } = await supabase.auth.getUser();
        if (error || !userData?.user) {
          content.innerHTML = `<p class="text-red-600">${content.dataset.notlogged ?? ''}</p>`;
          return;
        }

        const user = userData.user;
        console.log('Connecté :', user.email);

        // Récupère son profil complet
        const { data: profile, error: profileError } = await supabase
          .from('users')
          .select('role, is_active, licencetype, studio_name')
          .eq('id', user.id)
          .maybeSingle();

        if (profileError) {
          console.error('Erreur chargement profil:', profileError);
        }

        if (profile) {
          let detailsHtml = '';

          if (profile.role === 'bike-fitter' || profile.role === 'pending_bf') {
            // Bike-Fitter / pending BF display
            const studioDisplay = profile.studio_name || labelNoStudio;
            detailsHtml += `<p><strong>${labelStudio} :</strong> ${studioDisplay}</p>`;
            if (profile.role === 'pending_bf') {
              detailsHtml += `<p class="text-yellow-600 font-semibold mt-1">${labelPendingActivation}</p>`;
            } else {
              detailsHtml += `<p class="text-green-600 font-semibold mt-1">${labelActiveBf}</p>`;
            }
          } else if (profile.role === 'admin') {
            // Admin: just show role, no licence
          } else {
            // Rider display (default)
            if (profile.is_active) {
              detailsHtml += `<p><strong>${labelLicence} :</strong> ${profile.licencetype || labelNoLicence}</p>`;
            } else {
              detailsHtml += `<p class="text-primary font-semibold text-center mt-2">${choosePack}</p>`;
            }
          }

          // Packs cyclistes : pour les cyclistes (et l'admin) seulement.
          const isBf = profile.role === 'bike-fitter' || profile.role === 'pending_bf';
          document.getElementById('rider-offers')?.classList.toggle('hidden', isBf);
          // Compte bike fitter : ni bandeau ni bouton « Pré-réserve ton
          // Diagnostic » (promotions cyclistes) dans son espace.
          if (isBf) {
            document
              .querySelectorAll<HTMLElement>('[data-rider-promo], [data-header-actions]')
              .forEach((n) => n.classList.add('hidden'));
          }

          content.innerHTML = `
        <div class="mt-6 p-6 border rounded-lg bg-gray-50 dark:bg-gray-800 text-left inline-block">
          <p><strong>${labelEmail} :</strong> ${user.email}</p>
          <p><strong>${labelRole} :</strong> ${profile.role}</p>
          ${detailsHtml}
        </div>`;
        } else {
          // public.users est créé automatiquement par le trigger
          // handle_email_confirmed côté Supabase à la validation de l'email.
          // Si le profil n'existe pas encore, la confirmation email est peut-être
          // encore en cours de propagation — on retente après un court délai.
          await new Promise((r) => setTimeout(r, 1500));
          const { data: retry } = await supabase
            .from('users')
            .select('role, is_active, licencetype, studio_name')
            .eq('id', user.id)
            .maybeSingle();

          if (retry) {
            loadDashboard();
            return;
          }
          content.innerHTML = `<p class="text-red-600">${content.dataset.profilenotfound ?? ''}</p>`;
        }
      }

      loadDashboard();
    </script>

    <script>
      import { supabase } from '../../../config/supabaseClient';
      import { manageSubscription, openPortal, startTrialCard } from '~/lib/billing/client';
      import { isDowngrade, nextInvoiceCentsForOffer, type Offer, type Plan } from '~/lib/billing/logic';
      import { isDiagnosticAvailable } from '~/config/diagnostic';

      type Summary = {
        plan: Plan | null;
        offer: Offer | null;
        trial_state: 'needs_card' | 'granted' | 'card_already_used' | null;
        status: string | null;
        access: 'full' | 'read_only' | null;
        grace_until: string | null;
        current_period_start: string | null;
        current_period_end: string | null;
        cancel_at: string | null;
        scheduled_offer: Offer | null;
        scheduled_at: string | null;
        unpaid_amount: number | null;
        unpaid_invoice_url: string | null;
        has_stripe_customer: boolean | null;
        has_subscription: boolean | null;
        analyses_in_period: number;
        credits_remaining: number;
        credits_next_expiry: string | null;
      };

      const SUBSCRIPTION_PLANS: Plan[] = ['payg', 'studio', 'unlimited', 'unlimited_launch'];

      // Construit par nœuds DOM (textContent), jamais par innerHTML : les
      // libellés sont des traductions, mais la règle reste la même partout.
      function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = ''): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text) node.textContent = text;
        return node;
      }

      const dateFmt = (lang: string) => (iso: string | null) =>
        iso
          ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso))
          : '';

      async function fetchSummary(): Promise<Summary | null> {
        const { data, error } = await supabase.rpc('bf_usage_summary');
        const s = data as Summary | null;
        return error || !s?.plan ? null : s;
      }

      /** Rend le panneau de facturation. `flash` : message à afficher après le rendu. */
      function render(panel: HTMLElement, s: Summary, flash?: { text: string; ok: boolean }) {
        const lang = panel.dataset.lang ?? 'fr';
        const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');
        const date = dateFmt(lang);
        const eur = (cents: number) =>
          new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR' }).format(cents / 100);

        const msg = el('p', 'mt-4 hidden font-semibold');
        msg.setAttribute('aria-live', 'polite');
        const say = (text: string, ok: boolean) => {
          msg.textContent = text;
          msg.classList.remove('hidden', 'text-red-600', 'text-green-600');
          msg.classList.add(ok ? 'text-green-600' : 'text-red-600');
        };

        // Offre exacte (Illimité mensuel ou annuel) : écrite par le webhook.
        const current: Offer | null = s.offer ?? (SUBSCRIPTION_PLANS.includes(s.plan!) ? (s.plan as Offer) : null);
        const offerLabel = (o: string) => L[`plan.${o}`] ?? o;

        panel.replaceChildren();
        panel.append(el('h2', 'text-xl font-bold mb-2', L.title));
        panel.append(el('p', 'text-lg font-semibold text-primary', offerLabel(current ?? s.plan!)));

        if (s.status === 'past_due' && s.access === 'full') {
          panel.append(
            el('p', 'mt-2 text-yellow-700 dark:text-yellow-400', L.pastDue.replace('{date}', date(s.grace_until)))
          );
        } else if (s.access === 'read_only') {
          panel.append(el('p', 'mt-2 text-red-600 font-semibold', L.readOnly));
        }
        if (s.has_subscription && s.cancel_at) {
          panel.append(
            el(
              'p',
              'mt-2 text-yellow-700 dark:text-yellow-400 font-semibold',
              L.cancelScheduled.replace('{date}', date(s.cancel_at))
            )
          );
        } else if (s.has_subscription && s.scheduled_offer) {
          panel.append(
            el(
              'p',
              'mt-2 text-yellow-700 dark:text-yellow-400',
              L.changeScheduled
                .replace('{offer}', offerLabel(s.scheduled_offer))
                .replace('{date}', date(s.scheduled_at))
            )
          );
        }

        // Créance : facture restée impayée à la fin d'un abonnement.
        if (s.unpaid_amount) {
          const box = el('div', 'mt-4 rounded-md border-2 border-red-600 bg-white dark:bg-gray-900 p-4');
          box.append(el('p', 'font-bold text-red-600', L.debt.replace('{amount}', eur(s.unpaid_amount))));
          if (s.unpaid_invoice_url) {
            const pay = el('a', 'btn-primary mt-3 inline-flex', L.payDebt);
            pay.href = s.unpaid_invoice_url;
            pay.target = '_blank';
            pay.rel = 'noopener';
            box.append(pay);
          }
          panel.append(box);
        }

        // Essai : les 2 analyses offertes se débloquent avec une carte (0 €).
        if (s.plan === 'trial' && s.trial_state === 'needs_card') {
          const box = el('div', 'mt-4 rounded-md border-2 border-primary bg-white dark:bg-gray-900 p-4');
          box.append(el('p', 'font-bold', L['trialCard.title']), el('p', 'mt-1 text-sm', L['trialCard.text']));
          const cta = el('button', 'btn-primary mt-3', L['trialCard.cta']);
          cta.type = 'button';
          cta.addEventListener('click', async () => {
            cta.disabled = true;
            const err = await startTrialCard(lang);
            cta.disabled = false;
            if (err) say(L.error, false);
          });
          box.append(cta);
          panel.append(box);
        } else if (s.plan === 'trial' && s.trial_state === 'card_already_used') {
          panel.append(el('p', 'mt-2 text-red-600 font-semibold', L['trialCard.used']));
        }

        const stats = el('dl', 'mt-4 grid gap-4 sm:grid-cols-2');
        const stat = (label: string, value: string, sub = '') => {
          const box = el('div', 'rounded-md bg-white dark:bg-gray-900 p-3');
          box.append(el('dt', 'text-sm text-gray-500', label), el('dd', 'text-2xl font-bold', value));
          if (sub) box.append(el('dd', 'text-sm text-gray-500', sub));
          stats.append(box);
        };
        stat(L.analyses, String(s.analyses_in_period));
        if (s.plan === 'trial' || s.plan === 'pack') {
          stat(
            L.credits,
            String(s.credits_remaining),
            s.credits_next_expiry ? L.creditsExpiry.replace('{date}', date(s.credits_next_expiry)) : ''
          );
        }
        // Pas de prochaine facture quand l'abonnement s'arrête à l'échéance.
        // Descente programmée à l'échéance : la facture est celle de la
        // nouvelle offre.
        const billed = s.scheduled_offer ?? current;
        const next =
          s.has_subscription && !s.cancel_at && billed
            ? nextInvoiceCentsForOffer(
                billed,
                s.scheduled_offer ? 0 : s.analyses_in_period,
                Date.now(),
                s.current_period_end ? new Date(s.current_period_end).getTime() : null
              )
            : null;
        if (next !== null) {
          stat(
            L.nextInvoice,
            `${eur(next)} ${L.vat}`,
            s.current_period_end ? L.nextInvoiceOn.replace('{date}', date(s.current_period_end)) : ''
          );
        }
        panel.append(stats);

        const actions = el('div', 'mt-6 flex flex-wrap gap-3');
        const button = (label: string, cls: string, onClick: () => Promise<string | null>) => {
          const b = el('button', cls, label);
          b.type = 'button';
          b.addEventListener('click', async () => {
            b.disabled = true;
            const err = await onClick();
            b.disabled = false;
            if (err) say(L.error, false);
          });
          actions.append(b);
        };
        const link = (label: string, href: string, cls: string) => {
          const a = el('a', cls, label);
          a.href = href;
          actions.append(a);
        };
        // Action sur l'abonnement : la route réaligne la base avant de
        // répondre, le panneau est redessiné avec l'état à jour.
        const act = async (action: 'change' | 'cancel' | 'resume' | 'keep', done: string, offer?: Offer) => {
          say(L.updating, true);
          const r = await manageSubscription(action, offer);
          if (r.error) return r.error;
          const fresh = await fetchSummary();
          if (fresh) render(panel, fresh, { text: done, ok: true });
          else say(done, true);
          return null;
        };

        if (s.has_stripe_customer) button(L.portal, 'btn-primary', () => openPortal(lang));

        const ownsOffer = SUBSCRIPTION_PLANS.includes(s.plan!);
        if (s.plan === 'trial' || s.plan === 'pack' || (ownsOffer && !s.has_subscription)) {
          // Sans abonnement (essai, ou résilié par Stripe pour impayé) : on
          // propose de souscrire plutôt que de modifier.
          link(L.seeOffers, '#tarifs', 'btn-secondary');
        }

        if (ownsOffer && s.has_subscription && current) {
          if (s.cancel_at) {
            button(L.resume, 'btn-secondary', () => act('resume', L.resumeDone));
          } else {
            if (s.scheduled_offer) button(L.keep, 'btn-secondary', () => act('keep', L.keepDone));
            const others = (['payg', 'studio', 'unlimited', 'unlimited_annual'] as Offer[]).filter(
              (o) => o !== current && o !== s.scheduled_offer
            );
            for (const offer of others) {
              const down = isDowngrade(current, offer);
              button(L.changeTo.replace('{offer}', offerLabel(offer)), 'btn-secondary', async () => {
                let question = (down ? L.changeConfirmDown : L.changeConfirmUp).replace('{offer}', offerLabel(offer));
                if (current === 'unlimited_launch') question += `\n\n${L.leaveLaunch}`;
                if (!confirm(question)) return null;
                return act(
                  'change',
                  down ? L.changeLater.replace('{date}', date(s.current_period_end)) : L.changeDone,
                  offer
                );
              });
            }
            button(L.cancel, 'btn-tertiary text-red-600', async () => {
              if (!confirm(L.cancelConfirm)) return null;
              return act('cancel', L.cancelDone);
            });
          }
        }

        // Démarrage : seulement tant que l'essai est à ouvrir ou à utiliser
        // (un abonnement terminé repasse en « essai » sans crédit).
        if (s.plan === 'trial' && (s.trial_state === 'needs_card' || s.credits_remaining > 0)) {
          link(L.onboarding, `/${lang}/bike-fitting/bienvenue/`, 'btn-tertiary underline');
        }

        panel.append(actions, msg);
        panel.classList.remove('hidden');
        // Offres BF payables depuis l'espace, tant qu'aucun abonnement n'est en cours.
        document.getElementById('bf-offers')?.classList.toggle('hidden', Boolean(s.has_subscription));
        if (flash) say(flash.text, flash.ok);
      }

      async function loadBfBilling() {
        const panel = document.getElementById('bf-billing-panel');
        if (!panel || panel.dataset.bound === '1') return;
        panel.dataset.bound = '1';
        const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');

        const { data: userData } = await supabase.auth.getUser();
        if (!userData?.user) return;
        const { data: profile } = await supabase.from('users').select('role').eq('id', userData.user.id).maybeSingle();
        if (profile?.role !== 'bike-fitter' && profile?.role !== 'admin') return;

        let s = await fetchSummary();
        if (!s) return;

        // Retour de Checkout : le webhook arrive en général quelques secondes
        // après. Le message s'affiche tout de suite, le panneau se met à jour
        // dès que l'offre (ou l'essai) est enregistrée.
        const billingState = new URLSearchParams(window.location.search).get('billing');
        const waiting =
          (billingState === 'success' && !s.has_subscription) ||
          (billingState === 'card' && s.trial_state === 'needs_card');
        const flash =
          billingState === 'success'
            ? { text: L.success, ok: true }
            : billingState === 'card' && s.trial_state === 'needs_card'
              ? { text: L['trialCard.done'], ok: true }
              : undefined;
        render(panel, s, flash);

        for (let i = 0; waiting && i < 15; i++) {
          await new Promise((r) => setTimeout(r, 2000));
          const fresh = await fetchSummary();
          if (!fresh) break;
          const arrived = billingState === 'success' ? fresh.has_subscription : fresh.trial_state !== 'needs_card';
          if (arrived) {
            s = fresh;
            render(panel, s, flash);
            break;
          }
        }
      }

      /** Achats du Diagnostic AeroX : statut de chaque achat (cycliste). */
      async function loadDiagnostics() {
        const panel = document.getElementById('diag-panel');
        if (!panel || panel.dataset.bound === '1') return;
        panel.dataset.bound = '1';
        const lang = panel.dataset.lang ?? 'fr';
        const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');
        const date = dateFmt(lang);

        const { data: userData } = await supabase.auth.getUser();
        if (!userData?.user) return;
        const { data } = await supabase
          .from('diagnostic_purchases')
          .select('paid_at, consumed_at, refunded_at')
          .eq('user_id', userData.user.id)
          .order('paid_at', { ascending: false });
        const rows = (data ?? []) as { paid_at: string; consumed_at: string | null; refunded_at: string | null }[];
        if (!rows.length) return;

        panel.replaceChildren(el('h2', 'text-xl font-bold mb-2', L.title));
        const list = el('ul', 'space-y-2');
        for (const r of rows) {
          const status = r.refunded_at
            ? L.refunded.replace('{date}', date(r.refunded_at))
            : r.consumed_at
              ? L.consumed.replace('{date}', date(r.consumed_at))
              : isDiagnosticAvailable()
                ? L.available
                : L.preorder;
          const li = el('li', 'rounded-md bg-white dark:bg-gray-900 p-3');
          li.append(
            el('p', 'font-semibold', L.purchased.replace('{date}', date(r.paid_at))),
            el('p', r.refunded_at ? 'text-sm text-gray-500' : 'text-sm text-primary', status)
          );
          list.append(li);
        }
        panel.append(list);
        panel.classList.remove('hidden');
      }

      loadBfBilling();
      loadDiagnostics();
      document.addEventListener('astro:page-load', () => {
        loadBfBilling();
        loadDiagnostics();
      });
    </script>
  </section>

  <!--
    Offres, selon le compte (affichées par le script) : bike fitter sans
    abonnement → offres BF payables d'ici ; cycliste → Diagnostic. Jamais
    l'une chez l'autre (les routes de paiement refusent aussi le mauvais rôle).
  -->
  <div id="bf-offers" class="hidden mt-8">
    <BfPricing lang={lang as Locale} inAccount />
  </div>
  <div id="rider-offers" class="hidden">
    <PricingSection />
  </div>
</Layout>
