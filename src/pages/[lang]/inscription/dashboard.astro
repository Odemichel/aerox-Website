---
import PricingSection from '~/components/widgets/PricingSection.astro';
import BfPricing from '~/components/widgets/BfPricing.astro';

import Layout from '../../../layouts/PageLayout.astro';
import { getDict, t, type Locale } from '~/lib/i18n';

const { lang } = Astro.params;
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'dashboard.meta.title'),
  description: t(dict, 'dashboard.meta.description'),
};

// Libellés du compte (profil), lus par le script client.
const acctLabels = Object.fromEntries(
  ['role.bike-fitter', 'role.pending_bf', 'role.rider', 'role.admin', 'licence'].map((k) => [
    k,
    t(dict, `dash.acct.${k}`),
  ])
);
acctLabels['notLogged'] = t(dict, 'dashboard.notLogged');
acctLabels['profileNotFound'] = t(dict, 'dashboard.profileNotFound');

// Libellés du panneau de facturation bike fitter, lus par le script client.
const bfLabels = Object.fromEntries(
  [
    'title',
    'plan.trial',
    'plan.payg',
    'plan.unlimited_annual',
    'plan.studio',
    'plan.unlimited',
    'plan.unlimited_launch',
    'plan.unlimited_launch_annual',
    'plan.legacy',
    'status.active',
    'status.pastDue',
    'status.readOnly',
    'status.canceling',
    'pastDue',
    'readOnly',
    'analyses',
    'credits',
    'creditsExpiry',
    'meter.included',
    'meter.over',
    'meter.offered',
    'meter.period',
    'nextInvoice',
    'nextInvoiceOn',
    'portal',
    'seeOffers',
    'changeOffer',
    'when.now',
    'when.later',
    'choose',
    'price.analysis',
    'price.month',
    'price.year',
    'changeLater',
    'cancel',
    'cancelConfirm',
    'cancelDone',
    'cancelScheduled',
    'resume',
    'resumeDone',
    'changeScheduled',
    'keep',
    'keepDone',
    'changeConfirmUp',
    'changeConfirmDown',
    'leaveLaunch',
    'changeDone',
    'updating',
    'debt',
    'payDebt',
    'success',
    'error',
    'onboarding',
    'biz.title',
    'biz.text',
    'biz.label',
    'biz.placeholder',
    'biz.cta',
    'biz.granted',
    'biz.pending',
    'biz.used',
    'biz.invalid',
    'biz.notFound',
    'biz.inactive',
    'biz.registryDown',
  ].map((k) => [k, t(dict, `dash.bf.${k}`)])
);
bfLabels['vat'] = t(dict, 'bfp.vat');

// Achats du Diagnostic AeroX (cycliste), lus par le script client.
const diagLabels = Object.fromEntries(
  ['title', 'purchased', 'preorder', 'available', 'consumed', 'refunded', 'empty'].map((k) => [
    k,
    t(dict, `dash.diag.${k}`),
  ])
);
---

<Layout metadata={metadata}>
  <section id="account" class="acct" data-lang={lang}>
    <header class="acct-head">
      <h1>{t(dict, 'dash.acct.title')}</h1>
    </header>

    <div class="acct-grid">
      <div class="acct-main">
        <!-- Facturation bike fitter : rempli par le script si le compte est BF -->
        <div id="bf-billing-panel" class="acct-card acct-card--main hidden" data-labels={JSON.stringify(bfLabels)}>
        </div>

        <!-- Diagnostic AeroX : rempli par le script pour un cycliste -->
        <div id="diag-panel" class="acct-card acct-card--main hidden" data-labels={JSON.stringify(diagLabels)}></div>
      </div>

      <aside class="acct-side">
        <div id="dashboard-content" class="acct-card acct-card--side" data-labels={JSON.stringify(acctLabels)}>
          <p class="acct-muted">{t(dict, 'dashboard.loading')}</p>
        </div>
        <div class="acct-card acct-card--side acct-help">
          <p>{t(dict, 'dash.acct.help')}</p>
          <a class="acct-link" href={`/${lang}/contact/`}>{t(dict, 'dash.acct.contact')}</a>
        </div>
      </aside>
    </div>
  </section>

  <!--
    Offres, selon le compte (affichées par le script) : bike fitter sans
    abonnement → offres BF payables d'ici ; cycliste → Diagnostic. Jamais
    l'une chez l'autre (les routes de paiement refusent aussi le mauvais rôle).
  -->
  <div id="bf-offers" class="hidden">
    <BfPricing lang={lang as Locale} inAccount />
  </div>
  <div id="rider-offers" class="hidden">
    <PricingSection />
  </div>

  <script>
    import { supabase } from '../../../config/supabaseClient';
    import { manageSubscription, openPortal, submitBusinessId } from '~/lib/billing/client';
    import { isDowngrade, nextInvoiceCentsForOffer, type Offer, type Plan } from '~/lib/billing/logic';
    import { isDiagnosticAvailable } from '~/config/diagnostic';

    type Summary = {
      plan: Plan | null;
      offer: Offer | null;
      trial_state:
        | 'needs_business_id'
        | 'pending_review'
        | 'business_id_used'
        | 'granted'
        | 'needs_card'
        | 'card_already_used'
        | null;
      status: string | null;
      access: 'full' | 'read_only' | null;
      grace_until: string | null;
      current_period_start: string | null;
      current_period_end: string | null;
      cancel_at: string | null;
      scheduled_offer: Offer | null;
      scheduled_at: string | null;
      unpaid_amount: number | null;
      unpaid_invoice_url: string | null;
      has_stripe_customer: boolean | null;
      has_subscription: boolean | null;
      analyses_in_period: number;
      credits_remaining: number;
      credits_next_expiry: string | null;
    };

    type Profile = {
      role: string | null;
      is_active: boolean | null;
      licencetype: string | null;
      studio_name: string | null;
    };

    const SUBSCRIPTION_PLANS: Plan[] = ['payg', 'studio', 'unlimited', 'unlimited_launch'];
    // Offres proposées au changement, avec leur prix HT (centimes) et leur rythme.
    const CHANGE_TARGETS: { offer: Offer; cents: number; unit: 'analysis' | 'month' | 'year' }[] = [
      { offer: 'payg', cents: 2000, unit: 'analysis' },
      { offer: 'studio', cents: 7900, unit: 'month' },
      { offer: 'unlimited', cents: 11900, unit: 'month' },
      { offer: 'unlimited_annual', cents: 119000, unit: 'year' },
    ];
    // Analyses incluses (Studio) ou offertes (essai) : bornes de la jauge.
    const STUDIO_INCLUDED = 5;
    const TRIAL_OFFERED = 2;

    // Construit par nœuds DOM (textContent), jamais par innerHTML : le nom du
    // studio est saisi par l'utilisateur, les libellés sont des traductions.
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = ''): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text) node.textContent = text;
      return node;
    }

    const langOf = () => document.getElementById('account')?.dataset.lang ?? 'fr';
    const dateFmt = (iso: string | null) =>
      iso
        ? new Intl.DateTimeFormat(langOf(), { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso))
        : '';
    const eur = (cents: number) =>
      new Intl.NumberFormat(langOf(), { style: 'currency', currency: 'EUR' }).format(cents / 100);

    /** Jauge fine : `value` sur `max`, la part au-delà de `max` en couleur d'alerte. */
    function meter(label: string, value: number, max: number) {
      const wrap = el('div', 'acct-meter');
      wrap.append(el('p', 'acct-meter-label', label));
      const track = el('div', 'acct-meter-track');
      track.setAttribute('role', 'meter');
      track.setAttribute('aria-valuemin', '0');
      track.setAttribute('aria-valuemax', String(max));
      track.setAttribute('aria-valuenow', String(value));
      track.setAttribute('aria-label', label);
      const fill = el('span', 'acct-meter-fill');
      fill.style.width = `${Math.min(100, (Math.min(value, max) / max) * 100)}%`;
      track.append(fill);
      if (value > max) track.classList.add('is-over');
      wrap.append(track);
      return wrap;
    }

    /** Bandeau d'information : `tone` = ok | warn | bad. */
    function note(tone: 'ok' | 'warn' | 'bad', text: string) {
      const p = el('p', `acct-note acct-note--${tone}`, text);
      p.setAttribute('role', tone === 'bad' ? 'alert' : 'status');
      return p;
    }

    // ---------------------------------------------------------------------
    // Profil (colonne de droite) et visibilité des offres selon le rôle.
    // ---------------------------------------------------------------------

    async function loadProfile(): Promise<{ id: string; email: string; profile: Profile } | null> {
      const box = document.getElementById('dashboard-content');
      if (!box) return null;
      const A: Record<string, string> = JSON.parse(box.dataset.labels ?? '{}');

      const { data: userData, error } = await supabase.auth.getUser();
      if (error || !userData?.user) {
        box.replaceChildren(note('bad', A.notLogged));
        return null;
      }
      const user = userData.user;
      const read = () =>
        supabase.from('users').select('role, is_active, licencetype, studio_name').eq('id', user.id).maybeSingle();
      let { data: profile } = await read();
      // Profil créé par un trigger à la confirmation de l'e-mail : on laisse
      // un court délai à la propagation avant de conclure à une absence.
      if (!profile) {
        await new Promise((r) => setTimeout(r, 1500));
        ({ data: profile } = await read());
      }
      if (!profile) {
        box.replaceChildren(note('bad', A.profileNotFound));
        return null;
      }
      const p = profile as Profile;

      const name = p.studio_name || user.email || '';
      const kids: HTMLElement[] = [el('p', 'acct-side-name', name)];
      if (p.studio_name && user.email) kids.push(el('p', 'acct-muted acct-break', user.email));
      kids.push(el('p', 'acct-role', A[`role.${p.role}`] ?? p.role ?? ''));
      if (p.role === 'rider' && p.is_active && p.licencetype) {
        kids.push(el('p', 'acct-muted', A.licence.replace('{licence}', p.licencetype)));
      }
      box.replaceChildren(...kids);

      // Packs cyclistes : pour les cyclistes (et l'admin) seulement.
      const isBf = p.role === 'bike-fitter' || p.role === 'pending_bf';
      document.getElementById('rider-offers')?.classList.toggle('hidden', isBf);
      // Compte bike fitter : ni bandeau ni bouton « Pré-réserve ton
      // Diagnostic » (promotions cyclistes) dans son espace.
      if (isBf) {
        document
          .querySelectorAll<HTMLElement>('[data-rider-promo], [data-header-actions]')
          .forEach((n) => n.classList.add('hidden'));
      }
      return { id: user.id, email: user.email ?? '', profile: p };
    }

    // ---------------------------------------------------------------------
    // Offre bike fitter.
    // ---------------------------------------------------------------------

    async function fetchSummary(): Promise<Summary | null> {
      const { data, error } = await supabase.rpc('bf_usage_summary');
      const s = data as Summary | null;
      return error || !s?.plan ? null : s;
    }

    /** Rend le panneau de l'offre. `flash` : message à afficher après le rendu. */
    function render(panel: HTMLElement, s: Summary, flash?: { text: string; ok: boolean }) {
      const lang = langOf();
      const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');

      const msg = el('p', 'acct-flash hidden');
      msg.setAttribute('aria-live', 'polite');
      const say = (text: string, ok: boolean) => {
        msg.textContent = text;
        msg.classList.remove('hidden', 'is-ok', 'is-bad');
        msg.classList.add(ok ? 'is-ok' : 'is-bad');
      };

      // Offre exacte (Illimité mensuel ou annuel) : écrite par le webhook.
      const current: Offer | null = s.offer ?? (SUBSCRIPTION_PLANS.includes(s.plan!) ? (s.plan as Offer) : null);
      const offerLabel = (o: string) => L[`plan.${o}`] ?? o;
      const ownsOffer = SUBSCRIPTION_PLANS.includes(s.plan!);

      // --- En-tête : nom de l'offre et état ------------------------------
      const head = el('div', 'acct-plan');
      const titles = el('div');
      titles.append(
        el('p', 'acct-muted acct-plan-kicker', L.title),
        el('h2', 'acct-plan-name', offerLabel(current ?? s.plan!))
      );
      head.append(titles);
      let pill: [string, string] | null = null;
      if (s.access === 'read_only') pill = ['bad', L['status.readOnly']];
      else if (s.status === 'past_due') pill = ['warn', L['status.pastDue']];
      else if (s.has_subscription && s.cancel_at) pill = ['warn', L['status.canceling']];
      else if (s.has_subscription) pill = ['ok', L['status.active']];
      if (pill) head.append(el('span', `acct-pill acct-pill--${pill[0]}`, pill[1]));

      panel.replaceChildren(head);

      // --- Messages d'état -------------------------------------------------
      if (s.status === 'past_due' && s.access === 'full') {
        panel.append(note('warn', L.pastDue.replace('{date}', dateFmt(s.grace_until))));
      } else if (s.access === 'read_only') {
        panel.append(note('bad', L.readOnly));
      }
      if (s.has_subscription && s.cancel_at) {
        panel.append(note('warn', L.cancelScheduled.replace('{date}', dateFmt(s.cancel_at))));
      } else if (s.has_subscription && s.scheduled_offer) {
        panel.append(
          note(
            'warn',
            L.changeScheduled
              .replace('{offer}', offerLabel(s.scheduled_offer))
              .replace('{date}', dateFmt(s.scheduled_at))
          )
        );
      }

      // Créance : facture restée impayée à la fin d'un abonnement.
      if (s.unpaid_amount) {
        const box = el('div', 'acct-debt');
        box.append(el('p', '', L.debt.replace('{amount}', eur(s.unpaid_amount))));
        if (s.unpaid_invoice_url) {
          const pay = el('a', 'acct-btn acct-btn--primary', L.payDebt);
          pay.href = s.unpaid_invoice_url;
          pay.target = '_blank';
          pay.rel = 'noopener';
          box.append(pay);
        }
        panel.append(box);
      }

      // --- Tester AeroX maintenant : identifiant d'entreprise -------------
      const needsId =
        s.plan === 'trial' &&
        (s.trial_state === 'needs_business_id' ||
          s.trial_state === 'business_id_used' ||
          s.trial_state === 'needs_card' ||
          s.trial_state === 'card_already_used');
      if (s.plan === 'trial' && s.trial_state === 'pending_review') {
        const box = el('div', 'acct-inset');
        box.append(el('h3', 'acct-inset-title', L['biz.title']), note('ok', L['biz.pending']));
        panel.append(box);
      } else if (needsId) {
        const form = el('form', 'acct-inset');
        form.noValidate = true;
        form.append(el('h3', 'acct-inset-title', L['biz.title']), el('p', 'acct-inset-text', L['biz.text']));
        const label = el('label', 'acct-field');
        label.append(el('span', 'acct-field-label', L['biz.label']));
        const input = el('input', 'acct-input');
        input.name = 'business-id';
        input.required = true;
        input.autocomplete = 'off';
        input.spellcheck = false;
        input.placeholder = L['biz.placeholder'];
        label.append(input);
        const cta = el('button', 'acct-btn acct-btn--primary', L['biz.cta']);
        cta.type = 'submit';
        const result = el('p', 'acct-flash hidden');
        result.setAttribute('aria-live', 'polite');
        const tell = (text: string, ok: boolean) => {
          result.textContent = text;
          result.classList.remove('hidden', 'is-ok', 'is-bad');
          result.classList.add(ok ? 'is-ok' : 'is-bad');
        };
        if (s.trial_state === 'business_id_used' || s.trial_state === 'card_already_used') tell(L['biz.used'], false);
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!input.value.trim()) return input.focus();
          cta.disabled = true;
          tell(L.updating, true);
          const r = await submitBusinessId(input.value);
          cta.disabled = false;
          if ('error' in r) return tell(L.error, false);
          const messages: Record<string, [string, boolean]> = {
            granted: [L['biz.granted'], true],
            already_granted: [L['biz.granted'], true],
            pending_review: [L['biz.pending'], true],
            already_used: [L['biz.used'], false],
            invalid: [L['biz.invalid'], false],
            not_found: [L['biz.notFound'], false],
            inactive: [L['biz.inactive'], false],
            registry_down: [L['biz.registryDown'], false],
          };
          const [text, ok] = messages[r.result] ?? [L.error, false];
          if (ok) {
            // Analyses ouvertes ou vérification en cours : le panneau change.
            const fresh = await fetchSummary();
            if (fresh) return render(panel, fresh, { text, ok });
          }
          tell(text, ok);
          input.focus();
        });
        const row = el('div', 'acct-field-row');
        row.append(label, cta);
        form.append(row, result);
        panel.append(form);
      }

      // --- Usage : une seule jauge, selon l'offre ------------------------
      if ((s.plan === 'trial' || s.plan === 'pack') && s.trial_state === 'granted' && s.credits_remaining > 0) {
        const m = meter(
          L['meter.offered'].replace('{n}', String(s.credits_remaining)).replace('{max}', String(TRIAL_OFFERED)),
          s.credits_remaining,
          TRIAL_OFFERED
        );
        if (s.credits_next_expiry)
          m.append(el('p', 'acct-muted acct-small', L.creditsExpiry.replace('{date}', dateFmt(s.credits_next_expiry))));
        panel.append(m);
      } else if (current === 'studio') {
        const n = s.analyses_in_period;
        const label =
          n > STUDIO_INCLUDED
            ? L['meter.over'].replace('{max}', String(STUDIO_INCLUDED)).replace('{extra}', String(n - STUDIO_INCLUDED))
            : L['meter.included'].replace('{n}', String(n)).replace('{max}', String(STUDIO_INCLUDED));
        panel.append(meter(label, n, STUDIO_INCLUDED));
      }

      // --- Chiffres clés ---------------------------------------------------
      const facts = el('dl', 'acct-facts');
      const fact = (label: string, value: string, sub = '') => {
        const box = el('div', 'acct-fact');
        box.append(el('dt', '', label), el('dd', 'acct-fact-value', value));
        if (sub) box.append(el('dd', 'acct-muted acct-small', sub));
        facts.append(box);
      };
      // Nombre d'analyses : sauf quand la jauge le dit déjà (Studio) ou qu'il
      // n'y a rien à compter (essai sans analyses ouvertes).
      if (current !== 'studio' && (s.plan !== 'trial' || s.credits_remaining > 0)) {
        fact(
          L.analyses,
          String(s.analyses_in_period),
          s.current_period_start && s.has_subscription
            ? L['meter.period'].replace('{date}', dateFmt(s.current_period_start))
            : ''
        );
      }
      // Pas de prochaine facture quand l'abonnement s'arrête à l'échéance.
      // Descente programmée à l'échéance : la facture est celle de la
      // nouvelle offre.
      const billed = s.scheduled_offer ?? current;
      const next =
        s.has_subscription && !s.cancel_at && billed
          ? nextInvoiceCentsForOffer(
              billed,
              s.scheduled_offer ? 0 : s.analyses_in_period,
              Date.now(),
              s.current_period_end ? new Date(s.current_period_end).getTime() : null
            )
          : null;
      if (next !== null) {
        fact(
          L.nextInvoice,
          `${eur(next)} ${L.vat}`,
          s.current_period_end ? L.nextInvoiceOn.replace('{date}', dateFmt(s.current_period_end)) : ''
        );
      }
      if (facts.childElementCount) panel.append(facts);

      // --- Actions ---------------------------------------------------------
      const actions = el('div', 'acct-actions');
      const button = (
        label: string,
        cls: string,
        onClick: () => Promise<string | null>,
        into: HTMLElement = actions
      ) => {
        const b = el('button', cls, label);
        b.type = 'button';
        b.addEventListener('click', async () => {
          b.disabled = true;
          const err = await onClick();
          b.disabled = false;
          if (err) say(L.error, false);
        });
        into.append(b);
        return b;
      };
      const link = (label: string, href: string, cls: string) => {
        const a = el('a', cls, label);
        a.href = href;
        actions.append(a);
      };
      // Action sur l'abonnement : la route réaligne la base avant de
      // répondre, le panneau est redessiné avec l'état à jour.
      const act = async (action: 'change' | 'cancel' | 'resume' | 'keep', done: string, offer?: Offer) => {
        say(L.updating, true);
        const r = await manageSubscription(action, offer);
        if (r.error) return r.error;
        const fresh = await fetchSummary();
        if (fresh) render(panel, fresh, { text: done, ok: true });
        else say(done, true);
        return null;
      };

      const hasOffers = s.plan === 'trial' || s.plan === 'pack' || (ownsOffer && !s.has_subscription);
      // Une seule action principale par panneau, par ordre de priorité :
      // régler une facture, ouvrir les analyses offertes, souscrire, gérer
      // la facturation. Les autres restent en boutons discrets.
      let primaryTaken = Boolean(s.unpaid_amount) || needsId;
      const primary = () => {
        if (primaryTaken) return 'acct-btn';
        primaryTaken = true;
        return 'acct-btn acct-btn--primary';
      };
      if (hasOffers) link(L.seeOffers, '#tarifs', primary());
      if (s.has_stripe_customer) button(L.portal, primary(), () => openPortal(lang));

      if (ownsOffer && s.has_subscription && current) {
        if (s.cancel_at) {
          button(L.resume, 'acct-btn', () => act('resume', L.resumeDone));
        } else {
          if (s.scheduled_offer) button(L.keep, 'acct-btn', () => act('keep', L.keepDone));

          // Changer d'offre : liste dépliable, prix et moment d'effet visibles.
          const details = el('details', 'acct-change');
          details.append(el('summary', 'acct-btn', L.changeOffer));
          const list = el('ul', 'acct-change-list');
          for (const target of CHANGE_TARGETS.filter((t) => t.offer !== current && t.offer !== s.scheduled_offer)) {
            const down = isDowngrade(current, target.offer);
            const li = el('li', 'acct-change-row');
            const info = el('div');
            const price = L[`price.${target.unit}`].replace('{price}', eur(target.cents));
            info.append(el('p', 'acct-change-name', offerLabel(target.offer)), el('p', 'acct-muted acct-small', price));
            const when = el(
              'p',
              'acct-small acct-change-when',
              down ? L['when.later'].replace('{date}', dateFmt(s.current_period_end)) : L['when.now']
            );
            li.append(info, when);
            button(
              L.choose,
              'acct-btn acct-btn--small',
              async () => {
                let question = (down ? L.changeConfirmDown : L.changeConfirmUp).replace(
                  '{offer}',
                  offerLabel(target.offer)
                );
                if (current === 'unlimited_launch' || current === 'unlimited_launch_annual')
                  question += `\n\n${L.leaveLaunch}`;
                if (!confirm(question)) return null;
                return act(
                  'change',
                  down ? L.changeLater.replace('{date}', dateFmt(s.current_period_end)) : L.changeDone,
                  target.offer
                );
              },
              li
            );
            list.append(li);
          }
          details.append(list);
          actions.append(details);

          button(L.cancel, 'acct-link acct-link--danger', async () => {
            if (!confirm(L.cancelConfirm)) return null;
            return act('cancel', L.cancelDone);
          });
        }
      }

      // Démarrage : tant que les analyses offertes sont à ouvrir ou à utiliser.
      if (s.plan === 'trial' && (needsId || s.credits_remaining > 0)) {
        link(L.onboarding, `/${lang}/bike-fitting/bienvenue/`, 'acct-link');
      }

      panel.append(actions, msg);
      panel.classList.remove('hidden');
      // Offres BF payables depuis l'espace, tant qu'aucun abonnement n'est en cours.
      document.getElementById('bf-offers')?.classList.toggle('hidden', Boolean(s.has_subscription));
      if (flash) say(flash.text, flash.ok);
    }

    async function loadBfBilling(role: string | null) {
      const panel = document.getElementById('bf-billing-panel');
      if (!panel || panel.dataset.bound === '1') return;
      if (role !== 'bike-fitter' && role !== 'admin') return;
      panel.dataset.bound = '1';
      const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');

      let s = await fetchSummary();
      if (!s) return;

      // Retour de Checkout : le webhook arrive en général quelques secondes
      // après. Le message s'affiche tout de suite, le panneau se met à jour
      // dès que l'offre est enregistrée.
      const billingState = new URLSearchParams(window.location.search).get('billing');
      const waiting = billingState === 'success' && !s.has_subscription;
      const flash = billingState === 'success' ? { text: L.success, ok: true } : undefined;
      render(panel, s, flash);

      for (let i = 0; waiting && i < 15; i++) {
        await new Promise((r) => setTimeout(r, 2000));
        const fresh = await fetchSummary();
        if (!fresh) break;
        if (fresh.has_subscription) {
          s = fresh;
          render(panel, s, flash);
          break;
        }
      }
    }

    // ---------------------------------------------------------------------
    // Diagnostics (cycliste).
    // ---------------------------------------------------------------------

    async function loadDiagnostics(userId: string, role: string | null) {
      const panel = document.getElementById('diag-panel');
      if (!panel || panel.dataset.bound === '1') return;
      if (role === 'bike-fitter' || role === 'pending_bf') return;
      panel.dataset.bound = '1';
      const L: Record<string, string> = JSON.parse(panel.dataset.labels ?? '{}');

      const { data } = await supabase
        .from('diagnostic_purchases')
        .select('paid_at, consumed_at, refunded_at')
        .eq('user_id', userId)
        .order('paid_at', { ascending: false });
      const rows = (data ?? []) as { paid_at: string; consumed_at: string | null; refunded_at: string | null }[];

      panel.replaceChildren(el('h2', 'acct-plan-name', L.title));
      if (!rows.length) {
        const empty = el('p', 'acct-muted', L.empty);
        panel.append(empty);
      } else {
        const list = el('ul', 'acct-diag-list');
        for (const r of rows) {
          const [tone, status] = r.refunded_at
            ? ['muted', L.refunded.replace('{date}', dateFmt(r.refunded_at))]
            : r.consumed_at
              ? ['muted', L.consumed.replace('{date}', dateFmt(r.consumed_at))]
              : isDiagnosticAvailable()
                ? ['ok', L.available]
                : ['warn', L.preorder];
          const li = el('li', 'acct-diag-row');
          li.append(
            el('p', 'acct-change-name', L.purchased.replace('{date}', dateFmt(r.paid_at))),
            el('p', `acct-small acct-diag-status acct-diag-status--${tone}`, status)
          );
          list.append(li);
        }
        panel.append(list);
      }
      panel.classList.remove('hidden');
    }

    async function init() {
      const me = await loadProfile();
      if (!me) return;
      await Promise.all([loadBfBilling(me.profile.role), loadDiagnostics(me.id, me.profile.role)]);
    }

    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

