---
// Retour de l'autorisation Strava (feat-strava-sync) : l'Edge Function
// `strava-oauth-callback` redirige ici avec ?status=ok|denied|error. Les
// Edge Functions ne servent pas de HTML (réécrit en text/plain).
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { SUPPORTED_LOCALES, type Locale, getDict, t } from '~/lib/i18n';

export const prerender = true;
export const getStaticPaths: GetStaticPaths = async () => SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'strava.meta.title'),
  // Hors index et hors sitemap (astro.config.ts).
  robots: { index: false, follow: false },
  ignoreTitleTemplate: true,
};

const statuses = ['ok', 'denied', 'error'] as const;
---

<Layout metadata={metadata}>
  <section class="relative not-prose">
    <div class="mx-auto max-w-2xl px-4 md:px-6 py-20 md:py-28 text-center">
      {
        statuses.map((s) => (
          <div data-strava-status={s} hidden={s !== 'error'}>
            <h1 class="text-3xl md:text-4xl font-bold tracking-tighter mb-4">{t(dict, `strava.${s}.title`)}</h1>
            <p class="text-lg text-muted dark:text-slate-400">{t(dict, `strava.${s}.text`)}</p>
            {s === 'ok' && (
              <div data-strava-account hidden class="mt-8 text-base text-muted dark:text-slate-400">
                <p>
                  {t(dict, 'strava.ok.account')} <strong data-strava-account-value />
                </p>
                <p class="mt-2 text-sm">{t(dict, 'strava.ok.notYou')}</p>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  const status = new URLSearchParams(window.location.search).get('status');
  const shown = status === 'ok' || status === 'denied' ? status : 'error';
  document.querySelectorAll<HTMLElement>('[data-strava-status]').forEach((el) => {
    el.hidden = el.dataset.stravaStatus !== shown;
  });
  // Compte AeroX rattaché (e-mail masqué par le serveur), affiché en texte.
  const account = new URLSearchParams(window.location.search).get('account');
  const box = document.querySelector<HTMLElement>('[data-strava-account]');
  const value = document.querySelector<HTMLElement>('[data-strava-account-value]');
  if (account && box && value) {
    value.textContent = account;
    box.hidden = false;
  }
</script>
