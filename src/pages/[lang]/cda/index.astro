---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import GuideCapture from '~/components/widgets/GuideCapture.astro';
import PostSidebarBook from '~/components/blog/PostSidebarBook.astro';
import PositionsCdaTable from '~/components/cda/PositionsCdaTable.astro';
import LostWattsTable from '~/components/cda/LostWattsTable.astro';
import ReduceLevers from '~/components/cda/ReduceLevers.astro';
import CdaFactors from '~/components/cda/CdaFactors.astro';
import CdaDefinitionDiagram from '~/components/cda/CdaDefinitionDiagram.astro';
import { SUPPORTED_LOCALES, type Locale, getDict, t } from '~/lib/i18n';
import { localizedHref } from '~/utils/localize';

export const prerender = true;
export const getStaticPaths: GetStaticPaths = async () => SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);

const metadata = {
  title: t(dict, 'cda.meta.title'),
  description: t(dict, 'cda.meta.description'),
  robots: { index: true, follow: true },
};

// Page pilier : définition (Cd × A, ce que mesure AeroX), facteurs, valeurs
// typiques par position, impact, leviers, mesure (la formule détaillée est
// sur la page du calculateur). Le
// calculateur et la comparaison des méthodes de mesure ont leurs pages ; ici,
// le livre au milieu et le pont vers le Diagnostic à la fin.
const Link_diagnostic = localizedHref(lang, '/#pricing');
const Link_calculator = `/${lang}/cda/calculator/`;
const Link_measure = `/${lang}/blog/mesurer-cda-${lang}/`;
const guideTexts = { eyebrow: 'cda.guide.eyebrow', title: 'cda.guide.title', text: 'cda.guide.text' };

// Sections dans l'ordre de la page (sommaire).
const sections = [
  { id: 'definition', key: 'cda.definition.h2' },
  { id: 'factors', key: 'cda.optimize.h2' },
  { id: 'values', key: 'cda.values.h2' },
  { id: 'impact', key: 'cda.impact.h2' },
  { id: 'reduce', key: 'cda.reduce.h2' },
  { id: 'measure', key: 'cda.measure.h2' },
];
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-16">
    {
      /* ≥ 1 200 px : comme les articles, colonne gauche collante avec le sommaire
         (section en cours en orange) puis le livre ; en dessous, les deux restent dans le texte. */
    }
    <div
      class="mx-auto min-[1200px]:grid min-[1200px]:grid-cols-[15rem_minmax(0,48rem)_15rem] min-[1200px]:justify-center min-[1200px]:gap-10"
    >
      <aside class="hidden min-[1200px]:block border-r border-gray-200 dark:border-slate-700 pr-6">
        <div class="sticky top-[140px]">
          <nav
            class="text-sm"
            aria-label={t(dict, 'blog.toc')}
            data-toc
            data-toc-active="bg-primary/15 text-primary !border-primary font-semibold"
          >
            <p class="font-semibold uppercase tracking-wide text-xs text-muted mb-3">{t(dict, 'blog.toc')}</p>
            <ol class="space-y-1 border-l border-gray-200 dark:border-slate-700">
              {
                sections.map((sec) => (
                  <li>
                    <a
                      href={`#${sec.id}`}
                      data-toc-link={sec.id}
                      class="block -ml-px pl-3 py-1 rounded-r border-l-2 border-transparent hover:border-primary hover:text-primary text-muted transition-colors"
                    >
                      {t(dict, sec.key)}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </aside>
      <article
        class="mx-auto max-w-3xl px-4 md:px-6 prose prose-lg dark:prose-invert prose-headings:scroll-mt-[120px] min-[1200px]:mx-0 min-[1200px]:px-0"
      >
        <h1>{t(dict, 'cda.h1')}</h1>
        <p class="text-sm text-muted not-prose -mt-4 mb-6">
          <a href={`/${lang}/team/`} class="hover:underline">{t(dict, 'cda.author')}</a>
        </p>
        <p set:html={t(dict, 'cda.intro')} />

        {/* Sommaire : ancres des sections ci-dessous. */}
        <nav
          class="min-[1200px]:hidden not-prose my-6 rounded-xl border border-gray-200 dark:border-slate-700 px-5 py-4"
          aria-label={t(dict, 'blog.toc')}
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-2">{t(dict, 'blog.toc')}</p>
          <ol class="list-decimal pl-5 space-y-1 text-base">
            {
              sections.map((sec) => (
                <li>
                  <a href={`#${sec.id}`} class="text-primary hover:underline">
                    {t(dict, sec.key)}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <h2 id="definition">{t(dict, 'cda.definition.h2')}</h2>
        <p set:html={t(dict, 'cda.definition.p1')} />
        <ul>
          <li set:html={t(dict, 'cda.definition.cx')} />
          <li set:html={t(dict, 'cda.definition.a')} />
        </ul>
        <CdaDefinitionDiagram dict={dict} />
        <p set:html={t(dict, 'cda.def.aerox')} />

        <h2 id="factors">{t(dict, 'cda.optimize.h2')}</h2>
        <CdaFactors dict={dict} />

        <h2 id="values">{t(dict, 'cda.values.h2')}</h2>
        <PositionsCdaTable dict={dict} lang={lang} />
        <p>
          <strong>{t(dict, 'cda.values.cta.q')}</strong>
          <br />
          <a href={Link_diagnostic}>{t(dict, 'cda.values.cta.a')} →</a>
        </p>

        <div class="min-[1200px]:hidden">
          <GuideCapture lang={lang} id="cda-mid" texts={guideTexts} source="cda" />
        </div>

        <h2 id="impact">{t(dict, 'cda.impact.h2')}</h2>
        <p set:html={t(dict, 'cda.why.p1')} />
        <p set:html={t(dict, 'cda.impact.air')} />
        <p set:html={t(dict, 'cda.why.p2')} />
        <p set:html={t(dict, 'cda.impact.p1')} />
        <LostWattsTable dict={dict} />
        <p>
          <strong>{t(dict, 'cda.values.bridge')}</strong>
          <br />
          <a href={Link_calculator}>{t(dict, 'cda.values.bridge.calc')} →</a>
          <br />
          <a href={Link_diagnostic}>{t(dict, 'cda.values.bridge.diag')} →</a>
        </p>

        <h2 id="reduce">{t(dict, 'cda.reduce.h2')}</h2>
        <ReduceLevers dict={dict} />
        <p>{t(dict, 'cda.reduce.note')}</p>
        <p>
          {t(dict, 'cda.reduce.bridge')}
          <a href={Link_diagnostic} class="ml-1">{t(dict, 'cda.diag.cta')} →</a>
        </p>

        <h2 id="measure">{t(dict, 'cda.measure.h2')}</h2>
        <p>
          {t(dict, 'cda.measure.short')}
          <a href={Link_measure}>{t(dict, 'cda.measure.articleLink')} →</a>
        </p>
        <p><a href={Link_calculator}>{t(dict, 'cda.calcPage.link')} →</a></p>

        {/* Pont vers le Diagnostic : la mesure de surface frontale, guidée. */}
        <div class="not-prose mt-10 rounded-2xl border border-gray-200 dark:border-slate-700 px-6 py-8 text-center">
          <h2 class="text-xl md:text-2xl font-bold mb-2">{t(dict, 'cda.diag.title')}</h2>
          <p class="text-muted mb-6" set:html={t(dict, 'cda.diag.text')} />
          <a href={Link_diagnostic} class="btn-primary inline-block px-8 py-3 text-lg font-semibold rounded-lg">
            {t(dict, 'cda.diag.cta')}
          </a>
        </div>

        <p class="text-xs text-muted/60 mt-8 italic">{t(dict, 'cda.lastUpdated')}</p>
      </article>
      {/* Comme les articles : le livre dans la colonne de droite. */}
      <aside class="hidden min-[1200px]:block">
        <div class="sticky top-[140px]">
          <PostSidebarBook lang={lang} revealAt={0} />
        </div>
      </aside>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: t(dict, 'cda.h1'),
      description: t(dict, 'cda.meta.description'),
      author: {
        '@type': 'Person',
        name: 'Olivier Demichel',
        jobTitle: lang === 'fr' ? 'Fondateur AeroX, ancien chercheur CNRS' : 'AeroX Founder, former CNRS researcher',
        sameAs: [
          'https://www.linkedin.com/in/olivier-demichel-b9b824ba/',
          'https://www.researchgate.net/profile/Olivier-Demichel',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'AeroX',
        url: 'https://aeroxbefaster.com',
      },
      datePublished: '2026-03-24',
      dateModified: '2026-10-02',
      mainEntityOfPage: `https://aeroxbefaster.com/${lang}/cda/`,
      inLanguage: lang,
    })}
  />
</Layout>

<script>
  import { initTocSpy } from '~/lib/tocSpy';

  initTocSpy();
  document.addEventListener('astro:page-load', initTocSpy);
</script>
