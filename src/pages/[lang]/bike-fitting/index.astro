---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import BfPricing from '~/components/widgets/BfPricing.astro';
import BikeFitterTestimonials from '~/components/widgets/BikeFitterTestimonials.astro';
import AirShareChart from '~/components/bike-fitter/AirShareChart.astro';
import PositionsChart from '~/components/bike-fitter/PositionsChart.astro';

import aeroxHero from '~/assets/images/aerox-hero.jpg';
import bikePower from '~/assets/images/bike-fitter/bikefitting-bike-power.jpg';
import silStart from '~/assets/images/bike-fitter/silhouette-position-depart.jpg';
import silTested from '~/assets/images/bike-fitter/silhouette-position-testee.jpg';

import { SUPPORTED_LOCALES, type Locale, getDict, t } from '~/lib/i18n';
import { SITE } from 'astrowind:config';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params.lang as Locale) ?? 'fr';
const dict = getDict(lang);
const list = (key: string) => t(dict, key).split('|');

const metadata = {
  title: t(dict, 'bfx.meta.title'),
  description: t(dict, 'bfx.meta.description'),
  robots: { index: true, follow: true },
  openGraph: {
    images: [{ url: '~/assets/images/bike-fitter/silhouette-position-testee.jpg', alt: t(dict, 'bfx.hero.img.alt') }],
  },
};

// Action principale : l'essai gratuit (inscription bike fitter). La démo
// reste proposée en second.
const trialHref = `/${lang}/inscription/inscription/?profil=bike-fitter`;
const reservationHref = `/${lang}/periode-test/#reservation`;
const contactHref = `/${lang}/contact/`;
const cdaHref = `/${lang}/cda/`;

/* ===== FAQ : deux volets, réponses visibles ===== */
type FaqItem = { q: string; a: string; link?: { href: string; label: string } };
const faqPractical: FaqItem[] = [1, 2, 3, 4].map((i) => ({
  q: t(dict, `bfx.faq.p${i}.q`),
  a: t(dict, `bfx.faq.p${i}.a`),
}));
const faqBackground: FaqItem[] = [1, 2, 3, 4].map((i) => ({
  q: t(dict, `bfx.faq.f${i}.q`),
  a: t(dict, `bfx.faq.f${i}.a`),
  link: i === 2 ? { href: cdaHref, label: t(dict, 'bfx.faq.f2.link') } : undefined,
}));

/* ===== FAQPage JSON-LD ===== */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...faqPractical, ...faqBackground].map((f) => ({
    '@type': 'Question' as const,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer' as const, text: f.a },
  })),
};

/* ===== Service JSON-LD ===== */
const siteOrigin = SITE?.site ? new URL(SITE.site).origin : Astro.url.origin;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AeroX Bike Fitting',
  description: t(dict, 'bfx.meta.description'),
  provider: { '@type': 'Organization', name: 'AeroX', url: siteOrigin },
  url: `${siteOrigin}/${lang}/bike-fitting/`,
  areaServed: 'Worldwide',
  serviceType: 'Aerodynamic Bike Fitting Software',
};

/* ===== SoftwareApplication JSON-LD (B2B) ===== */
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AeroX',
  applicationCategory: 'SportsApplication',
  operatingSystem: 'macOS, Windows',
  description: t(dict, 'bfx.meta.description'),
  url: `${siteOrigin}/${lang}/bike-fitting/`,
  audience: { '@type': 'BusinessAudience', audienceType: 'Bike Fitters' },
  // Grille publique (HT). Source des montants : src/lib/billing/catalog.ts.
  offers: [
    { name: t(dict, 'bfp.essential.name'), price: '20.00', unitCode: 'MON' },
    { name: t(dict, 'bfp.unlimited.name'), price: '99.00', unitCode: 'MON' },
    { name: `${t(dict, 'bfp.unlimited.name')} (${t(dict, 'bfp.billing.yearly')})`, price: '990.00', unitCode: 'ANN' },
  ].map((o) => ({
    '@type': 'Offer',
    name: o.name,
    price: o.price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: `${siteOrigin}/${lang}/bike-fitting/#tarifs`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: o.price,
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: false,
      unitCode: o.unitCode,
      billingDuration: 1,
    },
  })),
};

/* ===== HowTo JSON-LD ===== */
const steps = [1, 2, 3, 4].map((i) => ({
  i,
  title: t(dict, `bfx.steps.s${i}.title`),
  desc: t(dict, `bfx.steps.s${i}.desc`),
}));
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t(dict, 'bfx.steps.title'),
  description: t(dict, 'bfx.meta.description'),
  step: steps.map((s) => ({ '@type': 'HowToStep', name: s.title, text: s.desc })),
};

/* ===== Review JSON-LD ===== */
const reviewSchema = [
  { name: 'Marcelo Rocha', quote: t(dict, 'bf.social.rocha.quote') },
  { name: 'Marcelo Muniz Machado', quote: t(dict, 'bf.social.muniz.quote') },
  { name: 'Mark Gerlando', quote: t(dict, 'bf.social.gerlando.quote') },
].map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'SoftwareApplication', name: 'AeroX' },
  author: { '@type': 'Person', name: r.name },
  reviewBody: r.quote,
}));

const principe = [1, 2, 3].map((i) => ({
  title: t(dict, `bfx.principe.p${i}.title`),
  text: t(dict, `bfx.principe.p${i}.text`),
}));
const mesures = [
  { i: 1, icon: 'tabler:user-scan' },
  { i: 2, icon: 'tabler:bolt' },
  { i: 3, icon: 'tabler:clock-hour-4' },
  { i: 4, icon: 'tabler:chart-line' },
].map(({ i, icon }) => ({ icon, title: t(dict, `bfx.mesures.m${i}.title`), desc: t(dict, `bfx.mesures.m${i}.desc`) }));
const clients = [
  { i: 1, icon: 'tabler:bike' },
  { i: 2, icon: 'tabler:stopwatch' },
  { i: 3, icon: 'tabler:trophy' },
  { i: 4, icon: 'tabler:route' },
  { i: 5, icon: 'tabler:heart-handshake' },
].map(({ i, icon }) => ({ icon, title: t(dict, `bfx.clients.c${i}.title`), desc: t(dict, `bfx.clients.c${i}.desc`) }));

// Gains chiffrés : positions 1 et 5 du livre (la position testée des captures
// est sur prolongateurs), à 30 km/h : tableaux 2.1, 2.2, 2.3 et 2.5 ;
// 13,8 s/km × 40 km = 9 min 12 s.
const gains = [
  { icon: 'tabler:arrows-minimize', value: '−31 %', label: t(dict, 'bfx.gains.area'), detail: '0,52 → 0,36 m²' },
  { icon: 'tabler:bolt', value: '−53 W', label: t(dict, 'bfx.gains.watts') },
  { icon: 'tabler:gauge', value: '+3,9 km/h', label: t(dict, 'bfx.gains.speed'), detail: '30,0 → 33,9 km/h' },
  { icon: 'tabler:stopwatch', value: '−9 min 12 s', label: t(dict, 'bfx.gains.time') },
];
const benefits = [
  { i: 1, icon: 'tabler:eye-check' },
  { i: 2, icon: 'tabler:award' },
  { i: 3, icon: 'tabler:repeat' },
  { i: 4, icon: 'tabler:plug-connected' },
].map(({ i, icon }) => ({
  icon,
  title: t(dict, `bfx.benefits.b${i}.title`),
  desc: t(dict, `bfx.benefits.b${i}.desc`),
}));
// Annuaire et modèle de page web : pas encore disponibles, affichés « Bientôt ».
const growth = [
  { i: 1, icon: 'tabler:users-group', soon: false },
  { i: 2, icon: 'tabler:map-pin', soon: true },
  { i: 3, icon: 'tabler:world-www', soon: true },
].map(({ i, icon, soon }) => ({
  icon,
  soon,
  title: t(dict, `bfx.growth.g${i}.title`),
  desc: t(dict, `bfx.growth.g${i}.desc`),
}));
const precisionItems = (key: string) =>
  list(key).map((item) => {
    const [title, desc] = item.split('::');
    return { title, desc };
  });

// Charte de la page en production : titres centrés, fonds alternés, blocs qui
// apparaissent au défilement (.bf-fade-in).
const section = 'relative not-prose scroll-mt-[72px] py-12 md:py-16';
const alt = 'bg-gray-50 dark:bg-slate-900/50';
const wrap = 'mx-auto max-w-4xl px-4 md:px-6';
const h2 = 'text-2xl md:text-3xl font-bold text-center';
const lead = 'mt-4 text-lg text-muted text-center max-w-3xl mx-auto';
const card = 'rounded-2xl border border-gray-200 dark:border-slate-700 bg-white/5 p-6';
---

<Layout metadata={metadata} audience="bike-fitter">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {reviewSchema.map((r) => <script type="application/ld+json" set:html={JSON.stringify(r)} />)}

  <!-- A1 · HERO -->
  <section id="hero" class="relative not-prose overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={aeroxHero.src}
        width={aeroxHero.width}
        height={aeroxHero.height}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-transparent"></div>
    </div>
    <div
      class="relative max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 grid md:grid-cols-[1fr_auto] gap-10 items-center"
    >
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-4">{t(dict, 'bfx.hero.tagline')}</p>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6 text-white">
          {t(dict, 'bfx.hero.title.l1')}<br />
          <span class="text-primary">{t(dict, 'bfx.hero.title.l2')}</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-200 max-w-xl">{t(dict, 'bfx.hero.text')}</p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {
            [
              { icon: 'tabler:eye', label: t(dict, 'bfx.hero.chip1') },
              { icon: 'tabler:activity', label: t(dict, 'bfx.hero.chip2') },
              { icon: 'tabler:clock', label: t(dict, 'bfx.hero.chip3') },
            ].map((c) => (
              <li class="inline-flex items-center gap-1.5 bg-primary/20 backdrop-blur-sm rounded-full px-4 py-1.5 border border-primary/30">
                <Icon name={c.icon} class="w-4 h-4 text-primary" />
                <span class="text-sm font-bold text-white">{c.label}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={trialHref}
            class="btn-primary inline-flex items-center gap-2 px-6 py-3 text-lg rounded-md font-semibold"
          >
            {t(dict, 'bf.cta.trial')}
          </a>
          <a
            href={reservationHref}
            class="btn-secondary inline-flex items-center gap-2 px-6 py-3 text-lg rounded-md font-semibold"
          >
            {t(dict, 'bfx.hero.demo')}
          </a>
        </div>
        <p class="mt-3 text-sm text-gray-300">{t(dict, 'bfx.hero.note')}</p>
      </div>
      <figure class="hidden md:block w-[260px] lg:w-[290px]">
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-3 border border-white/15 shadow-2xl">
          <img
            src={silTested.src}
            width={silTested.width}
            height={silTested.height}
            alt={t(dict, 'bfx.hero.img.alt')}
            class="block w-full rounded-xl"
            loading="eager"
          />
        </div>
        <figcaption class="mt-3 text-sm text-gray-300 text-center">{t(dict, 'bfx.hero.figcaption')}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Définition citable (GEO) -->
  <section class="relative not-prose">
    <div class="mx-auto max-w-4xl px-4 md:px-6 py-6">
      <p class="text-sm text-muted leading-relaxed">{t(dict, 'bfx.definition')}</p>
    </div>
  </section>

  <!-- BÉNÉFICES STUDIO : les douleurs du fitter d'abord (widget de la production) -->
  <Features
    id="benefices"
    columns={2}
    classes={{ container: '!max-w-5xl' }}
    title={t(dict, 'bfx.benefits.title')}
    items={benefits.map((b) => ({ title: b.title, description: b.desc, icon: b.icon }))}
  />

  <!-- A4 · UNE COMPARAISON, PAS UN CHIFFRE ISOLÉ -->
  <section id="avant-apres" class={`${section} overflow-hidden`}>
    <div class="absolute inset-0">
      <img
        src={bikePower.src}
        width={bikePower.width}
        height={bikePower.height}
        alt=""
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-slate-950/80"></div>
    </div>
    <div class={`relative ${wrap}`}>
      <h2 class={`${h2} text-white`}>{t(dict, 'bfx.compare.title')}</h2>
      <p class={`${lead} !text-gray-200`}>{t(dict, 'bfx.compare.text')}</p>
      <ul class="mt-5 flex flex-wrap justify-center gap-2">
        {
          list('bfx.compare.settings').map((s) => (
            <li class="rounded-full border border-primary/30 bg-primary/20 backdrop-blur-sm px-3 py-1 text-sm font-semibold text-white">
              {s}
            </li>
          ))
        }
      </ul>

      <!-- Carte avant / après : captures réelles, gains au centre (≤ 60 % de la hauteur d'écran) -->
      <figure class="mt-8">
        <div
          class="grid grid-cols-2 rounded-t-2xl bg-slate-950/80 py-2 text-center text-base md:text-lg font-bold uppercase tracking-wide"
        >
          <span class="text-slate-300">{t(dict, 'bfx.compare.before')}</span>
          <span class="text-emerald-400">{t(dict, 'bfx.compare.after')}</span>
        </div>
        <div
          class="grid grid-cols-2 md:grid-cols-[auto_12.5rem_auto] md:justify-center gap-x-3 gap-y-7 md:gap-5 items-center rounded-b-2xl border border-t-0 border-white/15 bg-white/5 backdrop-blur-sm p-3 pb-7 md:p-4 md:pb-8"
        >
          {
            [
              {
                img: silStart,
                badge: t(dict, 'bfx.compare.badge.before'),
                area: '0,52 m²',
                tone: 'bg-red-700 text-white',
                order: '',
              },
              {
                img: silTested,
                badge: t(dict, 'bfx.compare.badge.after'),
                area: '0,36 m²',
                tone: 'bg-emerald-400 text-slate-950',
                order: 'md:order-last',
              },
            ].map(({ img, badge, area, tone, order }) => (
              <div class={`relative justify-self-center ${order}`}>
                <img
                  src={img.src}
                  width={img.width}
                  height={img.height}
                  alt={badge}
                  class="block h-[26vh] md:h-[min(52vh,27.5rem)] w-auto rounded-xl"
                  loading="lazy"
                />
                <span
                  class={`absolute -bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md px-2.5 py-1 text-center text-[11px] md:text-xs font-bold uppercase leading-tight shadow-lg ${tone}`}
                >
                  {badge}
                  <br />
                  <span class="text-sm normal-case tabular-nums">{area}</span>
                </span>
              </div>
            ))
          }

          <!-- Widget « gains chiffrés » -->
          <div
            class="col-span-2 md:col-span-1 rounded-2xl border-2 border-emerald-400/80 bg-slate-950/90 px-3 py-3 md:py-2.5 text-center shadow-[0_0_28px_rgba(52,211,153,0.3)]"
          >
            <p class="font-bold md:text-sm uppercase leading-tight text-white">{t(dict, 'bfx.gains.title')}</p>
            <p class="text-xs md:text-[11px] text-slate-400">{t(dict, 'bfx.gains.subtitle')}</p>
            <dl class="mt-2 grid grid-cols-2 md:grid-cols-1 gap-x-3">
              {
                gains.map((g) => (
                  <div class="border-t border-white/10 py-2.5 md:py-1.5">
                    <Icon name={g.icon} class="mx-auto hidden md:block h-4 w-4 text-emerald-400" />
                    <dd class="mt-1 whitespace-nowrap text-xl md:text-[1.35rem] font-black leading-none text-emerald-400 tabular-nums">
                      {g.value}
                    </dd>
                    <dt class="mt-1 text-[11px] md:text-[10px] font-bold uppercase tracking-wide text-slate-100">
                      {g.label}
                    </dt>
                    {g.detail && <p class="hidden md:block text-[10px] text-slate-400 tabular-nums">{g.detail}</p>}
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
        <figcaption class="mt-3 space-y-1 text-xs text-gray-300 leading-relaxed">
          <p>{t(dict, 'bfx.compare.fig.caption')}</p>
          <p class="italic">{t(dict, 'bfx.gains.note')}</p>
        </figcaption>
      </figure>

      <div class="mt-8 grid sm:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-red-500/50 bg-red-500/15 backdrop-blur-sm p-6">
          <h3 class="font-semibold text-red-300">{t(dict, 'bfx.compare.without.title')}</h3>
          <ul class="mt-3 space-y-2">
            {
              list('bfx.compare.without.text').map((item) => (
                <li class="flex gap-2 text-gray-200">
                  <Icon name="tabler:x" class="mt-0.5 h-5 w-5 shrink-0 text-red-400" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl border-2 border-primary bg-primary/15 backdrop-blur-sm p-6">
          <h3 class="font-semibold text-primary">{t(dict, 'bfx.compare.with.title')}</h3>
          <ul class="mt-3 space-y-2">
            {
              list('bfx.compare.with.text').map((item) => (
                <li class="flex gap-2 text-white">
                  <Icon name="tabler:check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- A3 · CE QUE MESURE AEROX -->
  <section id="mesures" class={section}>
    <div class={wrap}>
      <h2 class={h2}>{t(dict, 'bfx.mesures.title')}</h2>
      <div class="mt-8 grid sm:grid-cols-2 gap-x-8 gap-y-6">
        {
          mesures.map((m) => (
            <div class="flex gap-4 bf-fade-in">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name={m.icon} class="w-5 h-5 text-primary" />
              </div>
              <div>
                <h3 class="font-semibold text-default">{m.title}</h3>
                <p class="mt-1 text-sm text-muted">{m.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-8 rounded-xl border-l-4 border-primary bg-primary/10 px-5 py-4 text-default">
        {t(dict, 'bfx.mesures.note')}
      </p>
    </div>
  </section>

  <!-- A9 · PRÉCISION ET LIMITES -->
  <section id="precision" class={`${section} ${alt}`}>
    <div class={wrap}>
      <h2 class={h2}>{t(dict, 'bfx.precision.title')}</h2>
      <p class={lead}>{t(dict, 'bfx.precision.intro')}</p>

      <div class="mt-8 grid md:grid-cols-2 gap-4">
        {
          [
            {
              value: '3 %',
              title: t(dict, 'bfx.precision.repeat'),
              desc: t(dict, 'bfx.precision.repeat.desc'),
              strong: true,
            },
            {
              value: '10 %',
              title: t(dict, 'bfx.precision.absolute'),
              desc: t(dict, 'bfx.precision.absolute.desc'),
              strong: false,
            },
          ].map((s) => (
            <div class={`${card} flex items-center gap-5`}>
              <p class={`shrink-0 text-5xl font-black tabular-nums ${s.strong ? 'text-primary' : 'text-default'}`}>
                {s.value}
              </p>
              <div>
                <p class="font-semibold text-default">{s.title}</p>
                <p class="mt-1 text-sm text-muted">{s.desc}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 grid md:grid-cols-2 gap-4">
        {
          [
            {
              title: t(dict, 'bfx.precision.does.title'),
              items: precisionItems('bfx.precision.does.items'),
              icon: 'tabler:circle-check-filled',
              mark: 'tabler:check',
              head: 'bg-emerald-400/15 text-emerald-300',
              tone: 'text-emerald-400',
            },
            {
              title: t(dict, 'bfx.precision.doesnt.title'),
              items: precisionItems('bfx.precision.doesnt.items'),
              icon: 'tabler:circle-x-filled',
              mark: 'tabler:x',
              head: 'bg-red-500/15 text-red-300',
              tone: 'text-red-400',
            },
          ].map((col) => (
            <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 bg-white/5">
              <h3 class={`flex items-center gap-2 px-5 py-3 text-lg font-bold ${col.head}`}>
                <Icon name={col.icon} class="h-6 w-6" />
                {col.title}
              </h3>
              <ul class="divide-y divide-gray-200 dark:divide-slate-700/70">
                {col.items.map((it) => (
                  <li class="flex gap-3 px-5 py-3">
                    <Icon name={col.mark} class={`mt-0.5 h-5 w-5 shrink-0 ${col.tone}`} />
                    <div>
                      <p class="font-semibold text-default">{it.title}</p>
                      <p class="text-sm text-muted">{it.desc}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class={`${card} mt-4`}>
        <h3 class="font-semibold text-default">{t(dict, 'bfx.precision.vary.title')}</h3>
        <ul class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3">
          {
            list('bfx.precision.vary.items').map((v, idx) => (
